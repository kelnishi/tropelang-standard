// === PREAMBLE ===
// @title    Rhetoric — the author, the audience, and the cultivation of attention
// @category Narrative Systems
// @version  0.2
// @note     Every other system here simulates the STORY; this one simulates the TRANSACTION the
//           story exists for — an AUTHOR cultivating an AUDIENCE's attention. It supplies one half
//           of what the "thin rungs" wanted: the cognitive need (CURIOSITY) and the aesthetic need
//           (BEAUTY / SPECTACLE) are AUDIENCE needs the author serves HERE — but they are equally
//           CHARACTER drives (a Borden, an Angier), and live on the character ladder in needs.trl
//           (tier_mind, tier_beauty). Same two rungs, two sides; depicting a curious character is
//           one way to make the audience curious. Three capabilities here, none tautological:
//           (1) AUDIENCE APPRAISAL — the same event reads differently to the audience by the
//               author's FRAMING (a fall framed comic is funny; framed earnest, it stings);
//           (2) the CURIOSITY GAP — a posed question pulls attention forward, a cliffhanger holds
//               it open, a payoff closes it;
//           (3) AUDIENCE INVESTMENT — curiosity buys ATTENTION (do I want to KNOW?); investment
//               buys STAKES (do I CARE which way it goes?). By endearing a person to the audience —
//               their backstory, their struggle, their likability — the author converts neutral
//               onlookers into PARTISANS who root for an outcome. This is the engine of the live
//               broadcast's athlete profile: it airs BEFORE the race, over an outcome no one yet
//               knows, precisely so the unknown result will land. Investment + an unknown outcome is
//               peak engagement (you care AND you don't know) — the opposite of a foregone
//               conclusion, not a cousin of it;
//           (4) AUTHORIAL OVERRIDE — character motivation is NOT an ironclad determinant; the
//               author can play god and impose an outcome the characters would never reach,
//               justified only by its effect. Motivation predicts; the author disposes.
//
// Import: import "trl/modules/rhetoric.trl"

import "trl/concepts/index.trl"               // revelation
import "trl/modules/emotion_dynamics.trl"     // audience appraisal is its mirror, one plane up

concept rhetoric [+System] [%Narrative]
imply Rhetoric -> [audience, Effect, Narrative]

// the two agents of the transaction — `author` / `audience` are founded in trl/concepts/narrative.trl
// (the canonical "telling" concepts), reached here via the concepts/index import above.


// === THE RHETORICAL VOCABULARY ===
verb Frames(target)    [+Narrative]   // set the register an event reads in
verb Poses(question)   [+Narrative]   // open a question the audience cannot yet answer
verb Answers(question) [+Narrative]   // ... and, eventually, close it
verb Endears(subject)  [+Narrative]   // bond the audience to a person, building rooting interest
verb Addresses(target) [+Narrative]   // speak TO the audience or another directly — apostrophe, the aside
verb Resolves(subject) [+Narrative]   // the contest's real outcome arrives (reality, not the author)
verb Imposes(outcome)  [+Narrative]   // override in-world logic for effect

// reality as agent — the non-fiction author-surrogate that resolves an outcome the author cannot
concept reality [%Narrative]


// === (1) AUDIENCE APPRAISAL — the SAME event, framed two ways, lands two ways ===

// A character's misfortune FRAMED comic lands as funny — the pain is not the point (slapstick).
rule Appraise_Comic {
  when:
    char $c [+Hurt]
    evt  $f [&Frames(agent=author, target=$c, as=comic)]
  then:
    audience [#Amused]
    audience -- amusement
}

// The very same misfortune framed earnest lands as poignant — the pain IS the point.
rule Appraise_Earnest {
  when:
    char $c [+Hurt]
    evt  $f [&Frames(agent=author, target=$c, as=earnest)]
  then:
    audience [#Moved]
    audience -- pathos
}

// A sight framed as spectacle lands as awe — the aesthetic rung, served to the audience.
rule Appraise_Spectacle {
  when:
    evt $f [&Frames(agent=author, target=$sight, as=spectacle)]
  then:
    audience [#Awed]
    audience -- spectacle
}


// === (2) THE CURIOSITY GAP — the cognitive rung, as the audience-drive the author stimulates ===

// A posed question the audience cannot yet answer opens a gap that pulls attention forward.
rule Open_Gap {
  when:
    evt $q [&Poses(agent=author, question=$g)]
  then:
    audience [#Curious(about=$g)]
    audience [+Attentive]
    audience -- curiosity
}

// Closing the gap is the PAYOFF; held open (a cliffhanger) it is what keeps them watching.
rule Payoff {
  when:
    audience [#Curious(about=$g)]
    evt $a [&Answers(agent=author, question=$g)]
  then:
    audience [-Curious]
    audience [+Satisfied]
    audience -- payoff
}


// === (3) AUDIENCE INVESTMENT — curiosity wants to KNOW; investment wants a SIDE ===

// Endearing a person to the audience — their backstory, their struggle, their likability — converts
// neutral onlookers into PARTISANS. Now there is an outcome they WANT, so the contest has stakes
// for them even though (especially when) no one knows how it ends. This is what the live-broadcast
// athlete profile manufactures, and why it airs before the gun, not after.
rule Build_Investment {
  when:
    evt $profile [&Endears(agent=author, subject=$p)]
  then:
    audience [~RootsFor(target=$p)]
    audience [+Invested(in=$p)]
    audience -- investment
}

// The payoff of investment is not relief (that is curiosity's) but EMOTION proportional to the
// stakes built: the rooted-for result lands as elation or heartbreak. A neutral audience feels a
// scoreline; an invested one feels a verdict. Reality may write the outcome (non_fiction) — the
// investment is what makes that outcome MATTER to the room.
rule Stakes_Land {
  when:
    audience [+Invested(in=$p)]
    evt $r [&Resolves(agent=reality, subject=$p)]
  then:
    audience [#Moved]
    audience -- stakes
}


// === (4) AUTHORIAL OVERRIDE — the author plays god ===

// The author imposes an outcome the characters' motivation would never produce, justified only by
// its effect. The author's word is narration ground-truth: it overrides the motivation and needs
// engines wholesale — which is precisely why character motivation is not deterministic.
rule Authorial_Fiat {
  when:
    evt $i [&Imposes(agent=author, outcome=$o, for=$effect)]
  then:
    !$i [+Canon]!
    audience -- engagement
}


// === ASSOCIATIONS ===
assoc rhetoric -> [
  emotion_dynamics : "the audience's mirror, one plane up, of",
  revelation       : "a curiosity gap pays off in a"
]


// === CONCRETE VIGNETTE: the same pratfall, framed two ways ===
// One event — a dignified man slips on the ice — and the author's framing alone decides whether
// the house laughs or aches.

char the_man [+Hurt]

scene the_fall {
  beat 1 {
    evt played_for_laughs [&Frames(agent=author, target=the_man, as=comic)]
    // Appraise_Comic -> audience [#Amused]
  }
  beat 2 {
    evt played_for_keeps [&Frames(agent=author, target=the_man, as=earnest)]
    // Appraise_Earnest -> audience [#Moved] — the identical mishap, now it stings
  }
}
