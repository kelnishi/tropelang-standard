// @title   TropeLang Module Library — Index
// @version 0.1
// @note    Higher-level modules built on top of the concept library. Each module
//          adds structured, graph-shaped tropes (concepts wired by edges, `imply`
//          expansions, and recognition rules) for more sophisticated storytelling.
//          Importing this file brings the base concepts AND all modules into scope.
//
// Usage: import "trl/modules/index.trl"
//        (to import selectively, import individual module files instead)

import "trl/concepts/index.trl"

import "trl/modules/philosophy.trl"
import "trl/modules/theory_of_mind.trl"
import "trl/modules/cognitive_biases.trl"
import "trl/modules/heros_journey.trl"     // storytelling system (Campbell's monomyth)
import "trl/modules/freytags_pyramid.trl"  // storytelling system (the five-act dramatic arc)
import "trl/modules/story_circle.trl"      // storytelling system (Harmon's eight-step embryo)
import "trl/modules/save_the_cat.trl"      // storytelling system (Snyder's fifteen-beat sheet)
import "trl/modules/booker_seven_plots.trl" // storytelling system (Booker's plot-type taxonomy)
import "trl/modules/propp.trl"             // storytelling system (Propp's 31 functions + 7 dramatis personae)
import "trl/modules/kishotenketsu.trl"     // storytelling system (the four-act, conflict-FREE structure: ki-shō-ten-ketsu)
import "trl/modules/prophecy.trl"          // epistemic system (foreknowledge: foretell -> self-fulfil / twist)
import "trl/modules/common_knowledge.trl"  // epistemic system (mutual vs common knowledge; the public utterance)
import "trl/modules/power_dynamics.trl"    // political system (the collective scale: coalition, legitimacy, revolution)
import "trl/modules/reputation.trl"        // social system (status as a social-epistemic quantity: honor, slander, vindication)
import "trl/modules/emotion_dynamics.trl"     // psychological system (appraisal -> emotion -> motivation -> threads)
import "trl/modules/five_stages_of_grief.trl" // psychological system (the staged Kübler-Ross grief thread)
import "trl/modules/motivation_dynamics.trl"  // psychological system (desire -> pursuit -> attainment/obsession/abandonment)
import "trl/modules/needs.trl"                // psychological system (Maslow's hierarchy: ranked needs + prepotency)
import "trl/modules/rhetoric.trl"             // narrative system (author -> audience: framing, the curiosity gap, authorial override)
import "trl/modules/persuasion.trl"           // oratory system (speaker -> audience: ethos/logos/pathos -> belief-change -> call to action)
import "trl/modules/non_fiction.trl"          // narrative system (storytelling bound to the real: reality writes the verdict)
import "trl/modules/action_dynamics.trl"      // tactical system (the verbs of conflict & cooperation)
import "trl/modules/siege.trl"                 // military system (protracted investment: encircle/bombard/breach → sortie/relief)
import "trl/modules/heist.trl"                 // crime system (the caper: crew roles, the swap, security disabled → prize lifted)
