// @title   TropeLang Prelude — Standard Library
// @version 1.7
//
// Automatically in scope for every .trl file.
// Do not import manually. Override with // @no-prelude for a clean slate.
//
// ─────────────────────────────────────────────────────────────────────────────
// DECLARATION FORMS
//   attr  Name [+Parent]          meta-hierarchy node — the type system itself
//   prop  Name [+Group]           stable entity attribute (adjective / noun)
//   state Name [+Group]           mutable condition — can be added and removed
//   verb  Name(params) [+Group]   action descriptor — what an event does
//   rel   Name(params) [+Group]   relationship type — how entities connect
//
// TAG SIGILS — the leading char selects the facet a tag applies to
//   [+Name]   prop    — generic stable property or category
//   [=Name]   body    — physical form, embodiment, material condition
//   [#Name]   mind    — cognition, emotion, psychological state
//   [%Name]   essence — fundamental nature; ontological / timeless quality
//   [@Name]   rel     — relationship, bond, or structural connection
//   [&Name]   verb    — action; primarily on evt nodes
//   [~Name]   intent  — directed psychological orientation toward a target
//
// MUTATION OPERATORS (type inferred from declaration)
//   [-Name]   remove any tag
//   [?Name]   query / test presence
//   [!Name]   assert absent
// ─────────────────────────────────────────────────────────────────────────────


// =============================================================================
// TIER 0 — META-HIERARCHY
// The type system for the type system.
// All other prelude entries inherit from one of these.
// =============================================================================

attr Kind                        // root — all type-system nodes are [+Kind]

// POS categories — what role a declared attribute plays
attr Prop          [+Kind]       // stable entity attribute
attr State         [+Kind]       // mutable condition
attr Verb          [+Kind]       // action/event descriptor
attr Rel           [+Kind]       // relationship/bond type
attr Intentional   [+Kind]       // directed psychological orientation toward a target

// Semantic groupings — organise attrs into domains
attr Ontological   [+Kind]       // fundamental nature
attr Vital         [+Kind]       // life and embodiment
attr Psychological [+Kind]       // inner life, emotion, cognition
attr Social        [+Kind]       // community, hierarchy, role
attr Kinship       [+Kind]       // family and lineage
attr Interpersonal [+Kind]       // acts between individuals
attr Narrative     [+Kind]       // story structure and function
attr Spatial       [+Kind]       // place and environment
attr Temporal      [+Kind]       // time and duration
attr Political     [+Kind]       // power, institution, governance
attr Mythological  [+Kind]       // divine, cosmic, transcendent
attr Epistemic     [+Kind]       // knowledge, belief, perception

// Trope — a named narrative pattern. Promoted to core: every converted trope title
// is a [+Trope], so references to it rehydrate against one shared category (see trl/tropes/).
attr Trope         [+Narrative]
attr System        [+Narrative]    // a dynamics module — a simulated arena (action, power, reputation, …)
attr Structure     [+Narrative]    // a structural / framework pattern — the shape a story takes
attr Tactic        [+Narrative]    // a single tactical move within a system (a strike, a feint, a gambit)


// — Abstract trope categories ————————————————————————————————————————————————
// Founded homes for the recurring super-types that tropes name in `imply Trope -> [...]`.
// These are RATIFIED abstractions: a category earns a declaration here once it is reused
// across several tropes (the std-lib promotion model — a one-trope category stays an inline
// detail; reuse promotes it to a founded node). Each hangs under its domain so the type
// system is whole — no stranded super-types (STYLE §5, "declare it, don't strand it").

// knowledge, belief, perception
attr Irony                [+Epistemic]      // a gap between what is believed and what is true
attr Disclosure           [+Epistemic]      // the surfacing of a withheld fact
attr Asymmetric_Knowledge [+Epistemic]      // uneven knowing across parties (one knows, one does not)
attr Knowledge            [+Epistemic]      // what is held as known in the world
attr Truth_Claim          [+Epistemic]      // an assertion staked on factual standing
attr Reality_Bound        [+Epistemic]      // anchored to the actual — the non-fiction register

// acts between individuals
attr Manipulation         [+Interpersonal]  // covertly steering another toward one's own end
attr Retribution          [+Interpersonal]  // a wrong returned upon its author — justice or payback
attr Strategy             [+Interpersonal]  // a calculated, multi-move plan against an opponent

// inner life, emotion, cognition
attr Resolve              [+Psychological]  // hardened will to press on against cost
attr Pathos               [+Psychological]  // an appeal pitched at feeling
attr Investment           [+Psychological]  // a stake — what an audience or character has riding on it

// story structure and function
attr Override             [+Narrative]      // an external force overruling the story's own causality
attr Transformation       [+Narrative]      // a character's arc of change across the story
attr Nested               [+Narrative]      // a tale embedded within a tale
attr Contrast             [+Narrative]      // meaning struck by juxtaposition
attr Heroic               [+Narrative]      // the protagonal register of valor and call
attr Final                [+Narrative]      // terminal — the last of its kind in the telling
attr Dramatization        [+Narrative]      // staging the real as story
attr Metafictional        [+Narrative]      // the work made aware of its own fiction
attr Oneiric              [+Narrative]      // the dream register
attr Combat               [+Narrative]      // a fight taken as a narrative unit
attr Attrition            [+Narrative]      // a contest decided by grinding the other side down
attr Costly               [+Narrative]      // bearing a real, paid cost — the stakes are met

// fundamental nature; fate
attr Object               [+Ontological]    // a thing that carries plot weight
attr Destined             [+Mythological]   // marked by fate — the arc is foretold

// power, institution, governance
attr Royalty              [+Political]      // sovereign rank and lineage

// — further ratified categories (reused across two tropes — the promotion floor) —
// epistemic / reveal
attr Twist                [+Epistemic]      // a turn that recontextualizes what came before
attr Withholding          [+Epistemic]      // a fact deliberately denied to the audience
attr Audience_Aware       [+Epistemic]      // the audience knows what the characters do not
attr Pretense             [+Epistemic]      // a maintained false front
attr Recontextualization  [+Epistemic]      // old facts reread under new light
attr Reveal_Pending       [+Epistemic]      // a concealment planted to be broken later
attr Misdirection         [+Epistemic]      // attention steered away from the truth
attr Foreknowledge        [+Epistemic]      // the outcome known in advance
attr Falsehood            [+Epistemic]      // an asserted untruth
// inner life
attr Integrity            [+Psychological]  // holding to one's principles under pressure
attr Relentless           [+Psychological]  // unceasing, undeterrable pursuit
attr Reluctance           [+Psychological]  // drawn in against one's own will
attr Hamartia             [+Psychological]  // the tragic flaw that undoes its bearer
attr Trauma               [+Psychological]  // a wounding that persists past its cause
attr Compassion           [+Psychological]  // feeling-with another in their suffering
attr Sympathy             [+Psychological]  // alignment of feeling toward another
attr Sympathetic_Focus    [+Psychological]  // the telling's pull toward a character's interiority
attr Conviction           [+Psychological]  // a held belief firm enough to drive action
attr Awe                  [+Psychological]  // overwhelmed wonder
attr Redemption           [+Psychological]  // a moral turn back toward the good
// acts between individuals; rank
attr Protection           [+Interpersonal]  // shielding another from harm
attr Opposition           [+Interpersonal]  // set in contest against another
attr Coerced              [+Interpersonal]  // acting under duress, not free choice
attr Subordinate          [+Social]         // ranked below — the second to a greater power
attr Usurpation           [+Political]      // the seizing of rank or position
// story structure and function
attr Planted              [+Narrative]      // an element set early to pay off later
attr Repeated             [+Narrative]      // recurrence used for narrative effect
attr Recurring            [+Narrative]      // a motif that returns across the telling
attr Utterance            [+Narrative]      // a charged line that lands as an event
attr Inversion            [+Narrative]      // a reversal of what was set up
attr Narration            [+Narrative]      // the telling voice itself
attr Central              [+Narrative]      // occupying the story's focus
attr Anachronic           [+Narrative]      // told out of chronological order
attr Suspense             [+Narrative]      // an outcome withheld to hold tension
attr Threat               [+Narrative]      // a looming, not-yet-realized danger
attr Timing               [+Narrative]      // arrival at the decisive moment
attr Relief               [+Narrative]      // rescue or reprieve arriving
attr Rout                 [+Narrative]      // a one-sided collapse of the other side


// =============================================================================
// TIER 1 — ONTOLOGICAL
// What something fundamentally is. Props: do not change without a major rule.
// =============================================================================

prop Mortal        [+Ontological]
prop Immortal      [+Ontological]
prop Sentient      [+Ontological]
prop Animate       [+Ontological]
prop Inanimate     [+Ontological]
prop Singular      [+Ontological]    // unique — only one can exist
prop Collective    [+Ontological]    // a group, institution, or people
prop Primordial    [+Ontological]    // existed before the current order
prop Liminal       [+Ontological]    // threshold — between states, worlds, identities

// Props for describing concept nodes
prop Abstract      [+Ontological]    // is not a physical, social, or embodied entity
prop Universal     [+Ontological]    // applies across cultures, histories, and species
prop Inevitable    [+Ontological]    // cannot ultimately be avoided or escaped
prop Aspirational  [+Ontological]    // something to strive toward; often unreachable
prop Paradoxical   [+Ontological]    // contains internal contradiction or tension
prop Binding       [+Ontological]    // constrains the holder; creates obligation
prop Irreversible  [+Ontological]    // once it occurs or applies, cannot be undone
prop Generative    [+Ontological]    // produces growth or change when engaged
prop Annihilating  [+Ontological]    // destroys or dissolves what it touches unchecked


// =============================================================================
// TIER 2 — VITAL CONDITIONS
// Life, embodiment, presence. States: change by event.
// =============================================================================

state Alive        [+Vital]
state Dead         [+Vital]
state Wounded      [+Vital]
state Ill          [+Vital]
state Dying        [+Vital]
state Unconscious  [+Vital]
state Recovering   [+Vital]

state Present      [+Vital]
state Absent       [+Vital]
state Hidden       [+Vital]
state Revealed     [+Vital]
state Exposed      [+Vital]      // uncovered, open to harm — lost cover or concealment
state Hurt         [+Vital]      // bodily harmed, short of a true wound — struck, bruised, winded
state Vulnerable   [+Vital]      // open to harm — defences down, a soft point exposed
state Saved        [+Vital]      // pulled from danger or death — rescued in time
state Imperiled    [+Vital]      // in present danger — the stakes against the body or life
state Crowded      [+Spatial]    // thick with people — a press of bodies, no room, many eyes
state Concealed    [+Vital]      // kept out of sight — hidden by intent (cf. Hidden, the plain state)


// =============================================================================
// TIER 3 — PSYCHOLOGICAL
// Inner life, emotion, cognition. All states — they change through experience.
// Genre-neutral: applies to tragedy, comedy, romance, and myth equally.
// =============================================================================

// Core emotions
state Joyful       [+Psychological]
state Grieving     [+Psychological]
state Longing      [+Psychological]
state Content      [+Psychological]
state Restless     [+Psychological]
state Afraid       [+Psychological]
state Hopeful      [+Psychological]
state Despairing   [+Psychological]
state Ashamed      [+Psychological]
state Proud        [+Psychological]
state Guilty       [+Psychological]
state Conflicted   [+Psychological]
state Certain      [+Psychological]

// Relational feelings
state Devoted      [+Psychological]
state Estranged    [+Psychological]
state Infatuated   [+Psychological]
state Heartbroken  [+Psychological]
state Jealous      [+Psychological]
state Trusting     [+Psychological]
state Suspicious   [+Psychological]
state Paranoid     [+Psychological]    // suspicion turned chronic — trusts no one, reads plots everywhere
state Forgiven     [+Psychological]
state Grateful     [+Psychological]
state Resentful    [+Psychological]
state Betrayed     [+Psychological]    // the felt state of having been betrayed — the act is the verb [&Betrays]

// Cognitive states
state Aware        [+Psychological]
state Ignorant     [+Psychological]    // does not know a relevant fact
state Deceived     [+Psychological]
state Disbelieving [+Psychological]    // refuses a true thing told — the Cassandra's hearers
state Enlightened  [+Psychological]
state Transformed  [+Psychological]   // emerged from an experience changed
state Disillusioned [+Psychological]
state Determined   [+Psychological]
state Curious      [+Psychological]    // drawn to know — the mind's pull toward a gap
state Awed         [+Psychological]    // struck by something vast — wonder, the sublime
state Driven       [+Psychological]    // compelled toward an end; will outrunning comfort
state Satisfied    [+Psychological]    // a want met; settled, for now
state Withdrawn    [+Psychological]    // pulled inward; affect closed off from others
state Painful      [+Psychological]    // marks an experience that wounds — a hard loss, a cutting memory
state Defiant      [+Psychological]    // refuses to yield — stands against pressure or threat
state Moved        [+Psychological]    // stirred — feeling reached and shifted by something
state Guarded      [+Psychological]    // wary; affect and trust held back behind a defence
state Illuminated(by) [+Psychological] // brought to understanding — a light shed, often by another
state AtPeace      [+Psychological]    // settled, reconciled — the storm passed; acceptance
state Overwhelmed  [+Psychological]    // swamped — feeling or demand past what can be borne
state Affronted    [+Psychological]    // insulted; dignity stung — the slight registered
state Empty        [+Psychological]    // hollowed out — feeling drained away, nothing left to give
state Vengeful     [+Psychological]    // set on payback — the wrong nursed into a will to repay
state Thrilled     [+Psychological]    // lit up with excitement — the rush of a wanted thing arriving
state Hopeless     [+Psychological]    // sees no way out — hope extinguished (cf. Despairing)
state Hardened     [+Psychological]    // toughened by hardship — feeling walled off, no longer tender
state Cynical      [+Psychological]    // expects the worst of motives — trust soured into suspicion
state Resolute     [+Psychological]    // firmly set on a course — will fixed, not to be turned


// =============================================================================
// TIER 4 — STABLE TRAITS
// Props: do not change except under extraordinary narrative pressure.
// =============================================================================

prop Trustworthy   [+Ontological]
prop Deceptive     [+Ontological]
prop Loyal         [+Ontological]
prop Courageous    [+Ontological]
prop Cowardly      [+Ontological]
prop Cunning       [+Ontological]
prop Wise          [+Ontological]
prop Naive         [+Ontological]
prop Resilient     [+Ontological]
prop Strong        [+Ontological]    // forceful, hard to overcome — of a person, a host, or a position
prop Skilled       [+Ontological]    // practised, capable at a craft or art
prop Virtuous      [+Ontological]    // of good character; acts rightly by disposition
prop Credible      [+Ontological]    // believable, worthy of being trusted on a claim
prop Innocent      [+Ontological]    // without guilt or wrongdoing; morally clear
prop Decisive      [+Ontological]    // acts firmly and to effect; settles the matter
prop Trait(axis: concept, value: concept) [+Ontological]  // a placed characterization — a value (concept) along a named axis (concept)
prop Volatile      [+Ontological]

// Object traits
prop Lethal        [+Ontological]
prop Corrupting    [+Ontological]
prop Healing       [+Ontological]
prop Symbolic      [+Ontological]
prop Fragile       [+Ontological]
prop Durable       [+Ontological]
prop Sentient      [+Ontological]    // intentionally duplicated — object or entity


// =============================================================================
// TIER 5 — SOCIAL STANDING
// Roles and positions in community. Mix of props (stable role) and states
// (current position, which can change).
// =============================================================================

// Stable social props — what someone IS in a community
prop Elder         [+Social]
prop Heir          [+Social]
prop Outcast       [+Social]
prop Stranger      [+Social]
prop Native        [+Social]
prop Chosen        [+Social]         // selected by external force
prop Peer          [+Social]
prop Wrongdoer     [+Social]         // one who has done the wrong — the guilty party in a moral reckoning
prop Speaker       [+Social]         // the one addressing an audience — the rhetor at the rostrum

// Institutional props
prop Authority     [+Social]
prop Subject       [+Social]
prop Faction       [+Social]         // a group with shared interests
prop Institution   [+Social]         // persistent structure: law, guild, church
prop Bond          [+Social]         // a tie between entities — the relationship itself, as a thing
prop Romance       [+Social]         // a romantic bond — the love-tie, as element and as register

// Mutable position states
state In_Power     [+Social]
state Deposed      [+Social]
state Exiled       [+Social]
state Liberated    [+Social]
state Indebted     [+Social]
state Obligated    [+Social]
state Compromised  [+Social]
state Aligned      [+Social]
state Trusted      [+Social]        // held in another's confidence — a standing that can be lost
state Defeated     [+Social]        // beaten in a contest of force or will — lost the field
state Conspicuous  [+Social]        // drawing notice — marked out, watched, hard to miss
state Opposed      [+Social]
state Negotiating  [+Social]
state Active       [+Social]
state Dormant      [+Social]
state Resolved     [+Social]
state Pending      [+Social]


// =============================================================================
// TIER 6 — KINSHIP
// Family structure and lineage. Relationships: structural, long-lived bonds.
// =============================================================================

rel Parent_Of(child: char)       [+Kinship]
rel Child_Of(parent: char)       [+Kinship]
rel Sibling_Of(other: char)      [+Kinship]
rel Spouse_Of(other: char)       [+Kinship]
rel Ancestor_Of(desc: char)      [+Kinship]
rel Descendant_Of(anc: char)     [+Kinship]
rel Guardian_Of(ward: char)      [+Kinship]
rel Ward_Of(guardian: char)      [+Kinship]
rel Kin_Of(other: char)          [+Kinship]    // family — lineage unspecified


// =============================================================================
// TIER 7 — SOCIAL BONDS
// Non-familial relationships between individuals or groups.
// =============================================================================

rel Ally_Of(other: char)         [+Social]
rel Rival_Of(other: char)        [+Social]
rel Adversary_Of(other: char)    [+Social]
rel Patron_Of(client: char)      [+Social]
rel Client_Of(patron: char)      [+Social]
rel Mentor_Of(student: char)     [+Social]
rel Student_Of(mentor: char)     [+Social]
rel Confidant_Of(other: char)    [+Social]
rel Beloved_Of(other: char)      [+Social]
rel Witness_To(event: evt)  [+Social]
rel Bound_To(force: char|concept)        [+Social]
rel Indebted_To(other: char)     [+Social]
rel LoyalTo(side: char|set|concept)          [+Social]    // allegiance to a side, faction, or cause
rel Avenges(subject: char)       [+Social]    // bound to right a wrong done to the subject — the vengeance tie
rel Foils(other: char)           [+Narrative]  // a contrast tie — one character throws another into relief


// =============================================================================
// TIER 8 — LIFE EVENTS
// Universal punctuation marks of a life. Verbs: appear on evt nodes.
// =============================================================================
//
// REQUIRED-ROLE CONVENTION (S12 recognition): a verb param TYPED without `null`
// is a REQUIRED role — recognition won't match an event that omits it (a bare
// [&Reveals] is not a recognition). An UNTYPED param stays flexible: present for
// authoring/binding, but never gated on. Type a role only when the corpus uses
// it consistently (one dominant key, ~no bare usages); leave loaded-but-rare or
// mixed-key verbs flexible until usage stabilizes (noted inline below).

verb Born                  [+Vital]
verb Dies                  [+Vital]
verb Wounds(by)           [+Vital]   // role flexible: corpus mixes subject=/by= — no single required role yet
verb Healed(by)            [+Vital]

verb Married(partner)      [+Interpersonal]
verb Separated(from)       [+Interpersonal]
verb Divorced(from)        [+Interpersonal]
verb Departs(from)        [+Interpersonal]
verb Returned(to)          [+Interpersonal]
verb Initiated(into)       [+Interpersonal]    // rite of passage, induction
verb Reconciled(with)      [+Interpersonal]
verb Estranges(from)       [+Interpersonal]
verb Adopted(child)        [+Interpersonal]
verb Chooses(by)            [+Interpersonal]
verb Exiles(by)            [+Interpersonal]
verb Liberates(by)         [+Interpersonal]
verb Crowned(by)           [+Political]
verb Deposes(by)           [+Political]
verb Abdicated(to)         [+Political]


// =============================================================================
// TIER 9 — INTERPERSONAL ACTS
// What characters do to each other. Verbs on evt nodes.
// =============================================================================

verb Confessed(to)         [+Interpersonal]
verb Forgave(other)        [+Interpersonal]
verb Betrays(target: char) [+Interpersonal]   // the betrayed party is required (param aligned to corpus `target=` usage)
verb Sacrificed_For(other) [+Interpersonal]   // role flexible: too few corpus usages to require
verb Protected(other)      [+Interpersonal]
verb Abandoned(other)      [+Interpersonal]
verb Pursued(other)        [+Interpersonal]
verb Rejected(other)       [+Interpersonal]
verb Deceives(other)       [+Interpersonal]
verb Witnessed(event: evt)  [+Interpersonal]
verb Challenged(other)     [+Interpersonal]
verb Surrenders(to)       [+Interpersonal]
verb Aided(other)          [+Interpersonal]
verb Mourned(other)        [+Interpersonal]
verb Celebrated(with)      [+Interpersonal]
verb Confronted(other: char)     [+Interpersonal]
verb Consoled(other)       [+Interpersonal]
verb Silenced(other)       [+Interpersonal]
verb Threatens(target: entity)     [+Interpersonal]    // menaces — promises harm to coerce
verb Attains(object: entity)       [+Interpersonal]    // reaches / wins a goal or object
verb Refuses               [+Interpersonal]    // declines — the no (the call, the terms, the demand)
verb Acts                  [+Interpersonal]    // exercises agency — takes the decisive action


// =============================================================================
// TIER 10 — TRANSMISSION
// How things pass between entities: knowledge, legacy, burden, influence.
// =============================================================================

verb Transmitted(to)       [+Interpersonal]
verb Taught(to)            [+Interpersonal]
verb Learned_From(src)     [+Interpersonal]
verb Passed_On(to)         [+Interpersonal]    // deliberate — often at end of life
verb Carried(burden)       [+Interpersonal]    // bears what was not originally theirs
verb Inherited_From(src)   [+Kinship]
verb Entrusted(to, item)   [+Interpersonal]


// =============================================================================
// TIER 11 — NARRATIVE ROLES & ARCHETYPES
// What function an entity serves in the story structure.
// Props: a character's narrative role is typically stable within a text.
// =============================================================================

// Functional roles — what job the entity does
prop Protagonist   [+Narrative]
prop Antagonist    [+Narrative]
prop Ally          [+Narrative]
prop Neutral       [+Narrative]
prop Bystander     [+Narrative]
prop Observer      [+Narrative]
prop Victim        [+Narrative]
prop Instigator    [+Narrative]
prop Catalyst      [+Narrative]    // causes change; does not change itself
prop Vessel        [+Narrative]    // carries something beyond itself
prop Survivor      [+Narrative]    // the one who lives through what others did not
prop Traitor       [+Narrative]    // betrays the side they appear to serve

// Narrative conditions
state Fated(to)    [+Narrative]    // bound to a foretold outcome (the prophecy cluster's core state)
state Redeemed     [+Narrative]    // completed a redemption arc — the turn paid off
state Doomed       [+Narrative]    // bound for a fall — the outcome already leaning toward ruin
state Reversal     [+Narrative]    // a turn of fortune — the peripeteia, the line of the story bending
state Called       [+Narrative]    // summoned to the story's task — the call to adventure landed

// Deep archetypes (Campbell / Vogler / Propp). The definite article marks the *archetype* — the
// universal role — distinct from the same-named *role-trope* (`the_mentor` → `imply Mentor`): TheX is
// the archetype, X is the trope (STYLE §5 / S13 §6.1).
prop TheHero        [+Narrative]
prop TheVillain     [+Narrative]
prop TheMentor      [+Narrative]
prop TheHerald      [+Narrative]    // announces change; delivers the call
prop TheTrickster   [+Narrative]    // disrupts; reveals through chaos
prop TheGuardian    [+Narrative]    // threshold guardian — tests the hero
prop TheShapeshifter [+Narrative]   // allegiance or nature is unclear
prop TheShadow      [+Narrative]    // dark mirror of the protagonist
prop TheLoveInterest [+Narrative]


// =============================================================================
// TIER 12 — NARRATIVE PATHS
// The direction an entity is moving. Props, but more mutable than archetypes —
// a character's path can change under a major rule.
// =============================================================================

prop Path_Heroic      [+Narrative]
prop Path_Corruption  [+Narrative]
prop Path_Redemption  [+Narrative]
prop Path_Sacrifice   [+Narrative]
prop Path_Ambiguous   [+Narrative]
prop Path_Hidden      [+Narrative]    // true path not yet visible


// =============================================================================
// TIER 13 — NARRATIVE FUNCTIONS
// What a node does in the story structure.
// =============================================================================

prop MacGuffin        [+Narrative]    // desired object; its nature is irrelevant
prop Coveted          [+Narrative]    // the watched prize all eyes are on — a MacGuffin in play
prop Counterfeit      [+Narrative]    // a forged copy — the decoy built to take the prize's place
prop Threshold        [+Narrative]    // crossing this changes everything
prop Remnant          [+Narrative]    // what survives — relic, scar, memory
prop PendingPayoff    [+Narrative]    // Chekhov tracker — parameterize with item=

// Story-level verbs — what events do at the narrative level
verb Foreshadows(event: evt) [+Narrative]
verb Resolves(tension)     [+Narrative]   // role flexible: param vs corpus subject= mismatch, too rare to align
verb Reverses(subject: entity) [+Narrative] // peripeteia — the one whose fortune inverts (param off the `state` keyword)
verb Reveals(fact: concept) [+Narrative]   // anagnorisis — recognition; the disclosed fact is required (a contentless reveal is not a recognition)
verb Crosses(threshold: entity)    [+Narrative]
verb Transforms(entity)    [+Narrative]
verb Initiates(thread: arc) [+Narrative]   // begins a narrative arc (param renamed off the `arc` keyword)
verb Concludes(thread: arc) [+Narrative]   // closes a narrative arc
verb Catalyzes(change)     [+Narrative]


// =============================================================================
// TIER 14 — SPATIAL
// Properties of locations and environments.
// =============================================================================

prop Interior      [+Spatial]
prop Exterior      [+Spatial]
prop Domestic      [+Spatial]     // home, hearth — quotidian space
prop Sacred        [+Spatial]
prop Profane       [+Spatial]
prop Contested     [+Spatial]
prop Liminal       [+Spatial]     // threshold space: borders, crossroads, doorways

state Safe         [+Spatial]
state Dangerous    [+Spatial]
state Familiar     [+Spatial]
state Unknown      [+Spatial]
state Accessible   [+Spatial]
state Sealed       [+Spatial]

// Time of day — on set entities
state Day          [+Temporal]
state Night        [+Temporal]
state Dawn         [+Temporal]
state Dusk         [+Temporal]


// =============================================================================
// TIER 15 — TEMPORAL
// Time-related properties on any entity.
// =============================================================================

prop Ancient       [+Temporal]
prop Ephemeral     [+Temporal]
prop Cyclical      [+Temporal]
prop Timeless      [+Temporal]
prop Eternal       [+Temporal]
prop Fleeting      [+Temporal]

state Past         [+Temporal]    // exists in memory or record — not current
state Future       [+Temporal]    // anticipated — not yet manifest


// =============================================================================
// TIER 16 — POLITICAL & INSTITUTIONAL
// Power, governance, faction. Covers historical, political, and social drama.
// =============================================================================

verb Commands(other)           [+Political]   // role flexible: too few corpus usages to require
verb Represents(group)         [+Political]
verb Opposes(other)            [+Political]
verb Legislates(domain)        [+Political]
verb Dissolves(institution)    [+Political]
verb Negotiates(with)          [+Political]
verb Allies_With(other)        [+Political]   // role flexible: too few corpus usages to require
verb Prosecutes(other)         [+Political]
verb Pardons(other)            [+Political]

rel Vassal_Of(liege: char)           [+Political]
rel Liege_Of(vassal: char)           [+Political]
rel Successor_Of(predecessor: char)  [+Political]
rel Contemporary_Of(other: char)     [+Political]
rel Member_Of(group: char|set)           [+Political]


// =============================================================================
// TIER 17 — MYTHOLOGICAL & COSMIC
// Stories operating at the level of gods, creation, fate, or deep time.
// =============================================================================

prop Divine        [+Mythological]
prop Mortal_Born   [+Mythological]    // of divine parentage but mortal
prop Fallen        [+Mythological]    // once elevated, now diminished
prop Transcendent  [+Mythological]    // beyond ordinary categories
prop Cursed        [+Mythological]
prop Blessed       [+Mythological]
prop Prophesied    [+Mythological]
prop Primordial    [+Mythological]    // also Ontological — dual membership valid

verb Descended(into)          [+Mythological]    // katabasis
verb Ascended(from)           [+Mythological]    // anabasis
verb Transformed_Into(form)   [+Mythological]    // metamorphosis
verb Ordained(by)             [+Mythological]    // appointed by higher force
verb Sacrificed(for)          [+Mythological]
verb Created(entity)          [+Mythological]
verb Destroyed(entity)        [+Mythological]   // role flexible: too few corpus usages to require

rel Worships(deity: char)           [+Mythological]
rel Emanation_Of(source: char|concept)      [+Mythological]
rel Prophet_Of(deity: char)         [+Mythological]
rel Cursed_By(agent: char)          [+Mythological]
rel Blessed_By(agent: char)         [+Mythological]
rel Created_By(creator: char)       [+Mythological]
rel MadeBy(by: char|set)                [+Social]         // mundane provenance — an object's maker (cf. mythological Created_By)


// =============================================================================
// TIER 18 — EPISTEMIC
// The gap between what is true and what is known.
// Applies universally — mystery, drama, tragedy, comedy equally.
// =============================================================================

prop Alias(name: value)        [+Epistemic]    // the alias surface form — a literal string
prop Perceives(target, as)     [+Epistemic]
prop Knows(target)             [+Epistemic]
prop Suspects(target)          [+Epistemic]
prop Believes(fact)            [+Epistemic]
prop Remembers(event: evt)     [+Epistemic]
prop Forgot(event: evt)        [+Epistemic]
prop MotivatedBy(reason)       [+Epistemic]
prop Trusts(target)            [+Epistemic]
prop Lineage(id)               [+Epistemic]
prop PendingPayoff(item)       [+Epistemic]    // Chekhov tracker


// =============================================================================
// TIER 19 — INTENTIONAL (DIRECTED)
// Psychological orientations directed toward a target.
// Sigil in usage: [~Name(target=x)]
// Target must be a declared graph node — char, obj, evt, set, arc, or concept.
// =============================================================================

verb Desires(target)           [+Intentional]
verb Fears(target)             [+Intentional]
verb Longs_For(target)         [+Intentional]
verb Loves(target)             [+Intentional]    // love directed at concept/thing
verb Hates(target)             [+Intentional]
verb Obsessed_With(target)     [+Intentional]
verb Devoted_To(target)        [+Intentional]
verb Pursues(goal)             [+Intentional]    // directed at a goal/objective (a concept or graph node)
verb Distrusts(target)         [+Intentional]
verb Mourns(target)            [+Intentional]    // target may be concept or entity
verb Envies(target)            [+Intentional]
verb RootsFor(target)          [+Intentional]    // pulls for — the audience's (or ally's) alignment toward someone
verb Reveres(target)           [+Intentional]
verb Attached_To(target)       [+Intentional]
verb Repelled_By(target)       [+Intentional]
verb Seeks(target)             [+Intentional]
verb Avoids(target)            [+Intentional]
verb Blames(target)            [+Intentional]
verb Forgives(target)          [+Intentional]
verb Yearns_For(target)        [+Intentional]
verb Committed_To(target)      [+Intentional]
