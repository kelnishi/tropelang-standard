// === PREAMBLE ===
// @trope    Internal Reveal
// @category Epistemic / Narrative Devices
// @source   https://allthetropes.org/wiki/Internal_Reveal
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): something known to the audience is now known by a character — the
// audience already holds the secret and the tension is the wait for the cast to catch up; when
// a character finally finds out, the ramifications land. FRONTIER: the CLOSING of the
// dramatic-irony gap from the CHARACTER's side. A fact the audience has known for some time
// (the gap [+Dramatic_Irony] opened by theory_of_mind.trl) is finally learned by a character who
// was [#Mistaken]: the recognition collapses the asymmetry and the character passes to [#Knows].
// DISTINCT from The Reveal (the_reveal.trl), which surprises the AUDIENCE — here the audience is
// NOT surprised; they knew all along, and only the character is. DISTINCT from Anagnorisis, which
// welds recognition to peripeteia ([&Reverses] in the same beat) and drowns it in grief — Internal
// Reveal carries no required reversal of fortune and no required tragic affect; it is purely the
// gap-closing. The signature: a fact !established for the audience!, a character [#Mistaken] who
// never witnessed it, then a [&Reveals] to that character -> [#Knows], and the irony gap CLOSES.


// === IMPORTS & ASSOCIATIONS ===
import "trl/modules/theory_of_mind.trl"   // [#Mistaken] -> [#Knows]; the Dramatic_Irony gap this CLOSES
import "trl/tropes/dramatic_irony.trl"    // the asymmetric-knowledge state Internal Reveal resolves
import "trl/tropes/the_reveal.trl"        // the AUDIENCE-facing sibling; Internal Reveal is its character-facing inverse

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc internal_reveal -> [
  dramatic_irony : "is the closing, from the character's side, of the gap held open by",
  revelation     : "is a revelation aimed at the character, not the",
  recognition    : "is the character's passage from ignorance to"
]


// === ONTOLOGY ===
// Internal Reveal is a disclosure (a reveal) whose audience already knew — so it subsumes the
// reveal's Disclosure with the asymmetric-knowledge cluster, and its distinguishing mark is that
// the gap it resolves was Audience_Aware all along.
imply InternalReveal -> [Disclosure, Asymmetric_Knowledge, Audience_Aware, Narrative]


// === ABSTRACT RULE ===
// Recognition: a fact $p is established in-world (the audience holds it — the !asserted! truth of
// the dramatic-irony setup); a character $c holds it FALSELY ([#Mistaken]) and never witnessed the
// truth, so the [+Dramatic_Irony] gap stands. A disclosure event then [&Reveals] $p TO $c — and
// because $c was the only one in the dark, the recognition closes the audience-vs-character gap:
// $c passes [#Mistaken] -> [#Knows], and the asymmetry is gone. No [&Reverses] clause appears —
// that is the whole signature against Anagnorisis; and the audience is unsurprised — that is the
// whole signature against The Reveal (theory_of_mind.trl / the_reveal.trl).
rule InternalReveal {
  when:
    evt  $truth      [&Reveals(fact=$p)]           // the fact the AUDIENCE already holds
    char $c          [#Mistaken(subject=$p)]        // the character is the one still in the dark
    not ( $c [@Witness_To(event=$truth)] )          // the dramatic-irony gap stood until now
    evt  $disclosure [&Reveals(fact=$p, to=$c)]     // a disclosure aimed AT the character
    $truth != $disclosure                            // the audience already held it; now $c is told
    $disclosure -> $c
  then:
    $c [-Mistaken(subject=$p)]
    $c [#Knows(target=$p)]                           // the character catches up to the audience
    !$disclosure [+InternalReveal]!
    !$disclosure [-Dramatic_Irony(over=$p)]!         // the audience-vs-character gap CLOSES
    surface(target=$c, message="What we have known all along, you finally know.")
}


// === CONCRETE VIGNETTE: Frasier — Daphne learns Niles loves her (TV sitcom, 1993–2004) ===
// For seven seasons the audience watched Niles Crane pine for Daphne Moon — the asides, the
// spilled coffee, the longing across the living room — while Daphne, oblivious, treated him as a
// dear friend and her employer's brother. The dramatic irony was the whole engine of the show:
// everyone watching knew; she did not. The Internal Reveal lands not as a twist to us but as the
// long-awaited collapse of that gap from HER side — at the end of "Something Borrowed, Someone
// Blue," Daphne is finally told what we have always known, and the ramifications (a runaway from
// her own wedding) are exactly the huge that the wait promised. No fortune is reversed in the
// telling; no tragedy attends it; the audience is not surprised for an instant. Only Daphne is.

// NILES CRANE — the fastidious brother who has loved Daphne in silence for seven years
char niles [+LoveInterest]
!niles [@Loves(target=daphne)]!                     // the audience has known this since season one

// DAPHNE MOON — the live-in physiotherapist, warm and oblivious to the man across the room
char daphne [+Protagonist]
daphne [#Mistaken(subject=niles_loves_her)]         // she reads his devotion as ordinary friendship

// INT. THE WINNEBAGO — NIGHT — chasing down the wedding, the truth blurted at last
set winnebago [+Interior] [+Night]

arc the_gap_closes [+InternalReveal]

scene something_borrowed {
  beat 1 {
    // The dramatic-irony setup: the audience holds the fact; Daphne holds its contrary; she has
    // never witnessed the truth, so the gap [+Dramatic_Irony] has stood for seven seasons.
    evt the_pining [&Reveals(fact=niles_loves_her)]
    daphne [#Mistaken(subject=niles_loves_her)]
    // and she never witnessed the truth — so the gap [+Dramatic_Irony] has stood for seven seasons
    !the_pining [+Dramatic_Irony(over=niles_loves_her, hidden=true)]!
  }
  beat 2 {
    daphne @ winnebago
    // The disclosure aimed AT the character — not a twist for us, the wait paying off for her.
    evt the_telling [&Reveals(fact=niles_loves_her, to=daphne)]
        dialog(inject=[speaker=daphne], inline="""
               speaker: "{speaker}"
               cue: "the truth catching up with her, years late, in a borrowed Winnebago"
               tone: stunned, dawning
               text: "Niles is in love with me? ...Niles is in love with me."
               """)
    the_telling -> daphne
    // InternalReveal fires here, deriving daphne [-Mistaken] [#Knows] and closing the gap
    // (!the_telling [+InternalReveal]!, [-Dramatic_Irony]) — the rule's payoff, not asserted.
  }
}
