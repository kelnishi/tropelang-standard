// === PREAMBLE ===
// @trope    The Quest
// @category Plots
// @source   https://allthetropes.org/wiki/The_Quest
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): the defining High Fantasy storyline — the hero (and a supporting cast) travel
// across the world toward a firm goal: recover a MacGuffin, save the princess, defeat the Big Bad.
// FRONTIER: the goal-directed JOURNEY as a plot type. Distinct from the Call to Adventure (the summons
// that begins it) and the Hero's Journey (the inward arc beneath it): The Quest is the outward
// undertaking toward an [+Objective]. Booker separates it from Overcoming the Monster — the Quest is the
// journey-with-obstacles toward a sought thing, not the straight line to the Big Bad.


// === IMPORTS & ASSOCIATIONS ===
import "trl/modules/heros_journey.trl"          // the inward arc the outward journey often carries
import "trl/tropes/arc/growth/call_to_adventure.trl"   // the summons that sets the quest in motion

assoc the_quest -> [
  call_to_adventure : "the journey that answers",
  heros_journey     : "the outward face of",
  macguffin         : "often undertaken to recover a"
]


// === ONTOLOGY ===
// — founded here (the sought objective + the undertaking is the discriminator; promotion model) —
prop Objective    [+Narrative]   // the firm goal a quest is mounted to reach — the thing sought
verb Quests(for)  [+Narrative]   // undertakes a goal-directed journey toward a sought objective

imply TheQuest -> [Structure, Narrative]


// === ABSTRACT RULE ===
// Naming rule: a [+Protagonist] QUESTS for an [+Objective] — the objective bound on the `for=` role of a
// [&Quests] event (agent=$hero), so phase-2 re-checks [+Objective] on the bound goal (STYLE §8). Binding
// the sought thing on the journey event is what parts this from a bare Call to Adventure (a summons, no
// goal undertaken) and from the inward Hero's Journey: here a firm objective is actively pursued across
// a journey.
rule The_Quest {
  when:
    char $hero [+Protagonist]
    obj  $goal [+Objective]
    evt  $journey [&Quests(agent=$hero, for=$goal)]
  then:
    $journey [+TheQuest]
}


// === CONCRETE VIGNETTE: Journey to the West — Xuanzang's pilgrimage (Chinese, Wu Cheng'en, 16th c.) ===
// The monk Xuanzang is sent west out of Tang China to fetch the true Buddhist scriptures from India, and the
// firm goal drives the whole road: mountains and rivers, demon-haunted passes, eighty-one ordeals, with Sun
// Wukong and his fellow disciples guarding him every step. The sutras are the one fixed thing every trial
// stands between him and: the objective is set, and the journey is the story.

// XUANZANG — the monk sent west to fetch the scriptures
char xuanzang [+Protagonist]

// THE SUTRAS — the true scriptures in the West, the firm goal that drives the whole journey
obj the_sutras [+Objective] [+Sacred]

scene the_pilgrimage_west {
  beat 1 {
    // the goal is set; he sets out across the world to reach it
    evt the_journey_west [&Quests(agent=xuanzang, for=the_sutras)]
    // The_Quest -> the_journey_west [+TheQuest]
  }
}
