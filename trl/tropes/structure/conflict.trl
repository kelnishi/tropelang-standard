// === PREAMBLE ===
// @trope    Conflict
// @category Omnipresent Tropes
// @source   https://allthetropes.org/wiki/Conflict
// @version  1.3
// @domain    Narrative
// @registry reuse   // title maps to an existing concept; no own registry entry
// @uses     trl/concepts/narrative.trl — the `conflict` concept
//
// Laconic: the opposition of forces that drives a story; without it, narrative collapses
// into description. The classic axes are vs Man, vs Self, vs Nature, vs Society, vs Fate.
// Builds on the `conflict` concept and the >< (mutual conflict) operator.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc conflict -> [
  dilemma     : "can crystallize as",
  consequence : "produces",
  change      : "forces"
]


// === ONTOLOGY ===

imply Conflict           -> [Opposition, Generative, Narrative]
imply Conflict_vs_Man     -> [Conflict, Interpersonal]
imply Conflict_vs_Self    -> [Conflict, Internal]
imply Conflict_vs_Nature  -> [Conflict, Environmental]
imply Conflict_vs_Society -> [Conflict, Institutional]
imply Conflict_vs_Fate    -> [Conflict, Cosmic]


// === ABSTRACT RULE ===
// A conflict exists wherever two forces stand opposed. The >< edge is the canonical form; the
// opposition rides an EVENT (the forces meeting, [&Confronted]) so the rule is recalled and both
// sides are event-bound (STYLE §8). The protagonist–antagonist case is its interpersonal form;
// here it is Man vs Nature. Reuses `conflict`.
rule Conflict_Exists {
  when:
    char $a
    char $b
    $a != $b
    $a >< $b
    evt  $clash [&Confronted(agent=$a, other=$b)]
  then:
    $a -- conflict
    $b -- conflict
    $a [+InConflict(with=$b)]
}


// === CONCRETE VIGNETTE: The Old Man and the Sea — Santiago vs the marlin (novella; Man vs Nature) ===

// SANTIAGO
char santiago [+Protagonist] [+Fisherman]

// THE GREAT MARLIN
char marlin [+Quarry] [+Magnificent]

// THE GULF STREAM
set sea [+Exterior] [+Vast] [+Indifferent]

scene the_struggle {
  beat 1 {
    santiago @ sea
    santiago >< marlin
    // the old man and the great fish, matched against each other on the open sea
    evt the_contest [&Confronted(agent=santiago, other=marlin)]
    // Not enmity but elemental struggle — the marlin is nature's adversary, admired.
    santiago [+Conflict_vs_Nature]
    santiago -- conflict
    marlin   -- conflict
  }
}
