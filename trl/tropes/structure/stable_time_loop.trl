// === PREAMBLE ===
// @trope    Stable Time Loop
// @category Time Travel / Speculative Fiction
// @source   https://allthetropes.org/wiki/Stable_Time_Loop
// @domain   Narrative
// @scale    arc
// @version  1.0
// @engine   >= 0.8.0   (S23 story-time: chron / @@ / [+Loop])
//
// Laconic (per the wiki): "It happened because you went back in time. And vice-versa." The FIXED-timeline
// model: nothing can be changed because the trip into the past was always part of history — the traveller's
// own act is the cause of the very situation that sent them. (Bootstrap / Ontological Paradox redirects here.)
//
// @model    Presentation-time is the spine; the character EVOLVES (Harry-overwhelmed → Harry-the-caster are
//           two states the engine already distinguishes). `chron`/`@@` only supply WORLD-LINE CONTINUITY —
//           binding those states to one in-world person across a closed loop ([+Loop]), not duplicate Harrys.
//           FRONTIER: the discriminator is a deed whose own consequence, looped back, is what produced it.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"
import "trl/tropes/epistemic/irony/self_fulfilling_prophecy.trl"   // the non-time-travel sibling: a fate sealed by averting it

assoc stable_time_loop -> [
  self_fulfilling_prophecy : "the time-travel form of",
  grandfather_paradox : "the consistent timeline whose mutable opposite is"
]


// === ONTOLOGY ===
// — founded here (the closed-loop causation is the discriminator; promotion model) —
verb Causes(outcome) [+Temporal]   // an act brings about a condition — here, across the loop, its own precondition

imply StableTimeLoop -> [Temporal, Narrative]


// === ABSTRACT RULE ===
// Naming rule (arc scale): a traveller CAUSES an outcome whose story-time the deed precedes on a closed
// world-line — the agent bound on a [&Causes] event (the recall anchor) with `before($deed, $outcome)`
// re-checking the story-order over a [+Loop] chron (S23). The cause lying inside the loop is the
// discriminator: parts it from a plain consequence (no loop) and from the Grandfather Paradox (a MUTABLE
// timeline the act unmakes). Story-time is the overlay; the deed/agent event is the spine.
rule Stable_Time_Loop {
  when:
    char $traveller
    obj  $outcome
    evt  $deed [&Causes(agent=$traveller, outcome=$outcome)]
    before($deed, $outcome)
  then:
    $deed [+StableTimeLoop]
}


// === CONCRETE VIGNETTE: Prisoner of Azkaban — the Time-Turner Patronus (novel/film, 1999/2004) ===
// The same three hours by the lake, lived twice. First traversal: Harry collapses under the dementors and a
// stag Patronus saves him from across the water, caster unseen. Turned back, on the second traversal he
// realises the distant saviour was always himself and casts the stag — the rescue that let him live to come
// back and cast it. The cause sits inside the loop; nothing was changed, only completed. (`[+Loop]` chron;
// `harry` is one evolving world-line, not two boys.)

// HARRY — one world-line across the loop: overwhelmed, then (evolved) the knowing caster
char harry [+Protagonist]

// HIS SURVIVAL — the outcome his own later act produces, which in turn produces that later act
obj his_survival

// the three hours as a closed cycle: the casting loops back to the peril it answers
chron the_casting [+Loop] ~> the_rescue ~> the_casting

scene by_the_lake @@ the_casting {
  beat 1 {
    // anchored at the casting, the stag he sends across the water is the cause of his own survival
    evt the_stag [&Causes(agent=harry, outcome=his_survival)]
    // Stable_Time_Loop -> the_stag [+StableTimeLoop]
  }
}
