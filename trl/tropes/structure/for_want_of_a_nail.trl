// === PREAMBLE ===
// @trope    For Want of a Nail
// @category Time Travel / Speculative Fiction
// @source   https://allthetropes.org/wiki/For_Want_of_a_Nail
// @domain   Narrative
// @scale    arc
// @version  1.0
// @engine   >= 0.8.0   (S23 story-time: chron `~>` + after())
//
// Laconic (per the wiki): a tiny change in the past amplifies into a wholly divergent present — "step on a
// butterfly" and mammals never evolve. The BRANCHING/cascade subgenre: the smallest divergence is enough to
// remake everything downstream. (Contrast In Spite of a Nail, where the timeline shrugs the change off.)
//
// @model    Presentation-time is the spine; chron supplies world-line continuity. The discriminator is a
//           negligible act whose later consequence is out of all proportion — `after($outcome, $change)`
//           re-checks that the transformed world lies later in story-time than the trivial change that bred it.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"
import "trl/tropes/structure/alternate_timeline.trl"   // the branching model this cascade-divergence belongs to

assoc for_want_of_a_nail -> [
  alternate_timeline : "the amplified-divergence case of the branch in"
]


// === ONTOLOGY ===
// — founded here (the disproportionate downstream cascade is the discriminator; promotion model) —
verb Cascades(into) [+Temporal]   // a negligible past act amplifies into a wholly divergent outcome

imply ForWantOfANail -> [Temporal, Narrative]


// === ABSTRACT RULE ===
// Naming rule (arc scale): a trivial act CASCADES into a transformed later world — the agent bound on a
// [&Cascades] event (the recall anchor) whose `into=` names an outcome that `after($outcome, $change)` places
// later in story-time (S23). The disproportion between a negligible cause and a remade present is the
// discriminator: parts it from a deliberate Set Right (a proportionate, purposed repair) and from In Spite of
// a Nail (the change that fails to matter).
rule For_Want_Of_A_Nail {
  when:
    char $agent
    obj  $outcome
    evt  $change [&Cascades(agent=$agent, into=$outcome)]
    after($outcome, $change)
  then:
    $outcome [+Transformed]
    $change [+ForWantOfANail]
}


// === CONCRETE VIGNETTE: A Sound of Thunder — Eckels and the butterfly (Bradbury, short story, 1952) ===
// On a guided safari sixty-five million years back, Eckels panics and strays off the anti-grav path, crushing
// a single butterfly underfoot. He returns to a present subtly, then sickeningly, wrong: the very spelling on
// the signs has changed, and a different man has won the election. One dead insect, an age ago, and the whole
// downstream world is remade. The smallest nail, the lost kingdom.

// ECKELS — the hunter whose one careless step remakes the future
char eckels [+Protagonist]

// THE ALTERED PRESENT — the wholly divergent world he returns to
obj the_altered_present

// in-world order: the misstep lies earlier than the transformed world it breeds
chron the_safari ~> the_return

scene the_misstep @@ the_safari {
  beat 1 {
    // one crushed butterfly cascades into a remade present out of all proportion to the act
    evt the_crushed_butterfly [&Cascades(agent=eckels, into=the_altered_present)]
    // For_Want_Of_A_Nail -> the_altered_present [+Transformed]; the_crushed_butterfly [+ForWantOfANail]
  }
}
