// === PREAMBLE ===
// @trope    Cerebus Syndrome
// @category Plot Devices / Tone
// @source   https://allthetropes.org/wiki/Cerebus_Syndrome
// @domain   Narrative
// @scale    arc
// @version  1.3
//
// Laconic (per the wiki): a work that begins light or comedic and, OVER ITS RUN, gradually grows serious,
// dramatic, and dark — named for the comic Cerebus. FRONTIER: the slow tonal arc (the arc-scale companion
// to Mood Whiplash's scene-scale spike). The discriminator is a [+Lighthearted] work bound on the subject
// of a [&Darkens] event — a gradual, work-spanning descent into seriousness. Distinct from Mood Whiplash
// (an abrupt single-beat tonal break): this is the long, deliberate darkening of the whole.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"
import "trl/tropes/rhetoric/mood_whiplash.trl"   // the abrupt scene-scale counterpart

assoc cerebus_syndrome -> [
  mood_whiplash : "the slow-arc counterpart to the spike of",
  character_development : "often rides deepening"
]


// === ONTOLOGY ===
// — founded here (the gradual whole-work darkening is the discriminator; promotion model) —
prop Lighthearted [+Narrative]   // a work that begins light or comedic in tone
verb Darkens(subject) [+Narrative] // grows steadily more serious and grim across the run

imply CerebusSyndrome -> [Transformation, Narrative]


// === ABSTRACT RULE ===
// Naming rule (arc scale): a [+Lighthearted] work DARKENS — the light-started work bound on the `subject=`
// role of a [&Darkens] event, so phase-2 re-checks [+Lighthearted] on it (STYLE §8). Binding the
// light-origin on the long darkening is the discriminator: a whole-work tonal descent, parting it from
// Mood Whiplash (an abrupt single-beat break).
rule Cerebus_Syndrome {
  when:
    obj  $work [+Lighthearted]
    evt  $shift [&Darkens(agent=$author, subject=$work)]
  then:
    $shift [+CerebusSyndrome]
}


// === CONCRETE VIGNETTE: M*A*S*H — comedy to anti-war drama (TV, 1972–83) ===
// The series begins as a broad service comedy — pranks in the Swamp, martinis, hijinks between surgeries.
// But season by season the laughter thins and the war presses in: the jokes give way to exhaustion,
// moral injury, and grief, until the finale is a feature-length meditation on trauma with barely a punch
// line. The same show that opened on farce closes on a man's breakdown. A whole work, darkened by
// degrees.

// M*A*S*H — the service comedy it began as
obj mash [+Lighthearted]

// THE WRITERS — who let the war press in, season by season
char the_writers

scene over_the_seasons {
  beat 1 {
    // the same show darkens by degrees, comedy giving way to grief across its run
    evt the_darkening [&Darkens(agent=the_writers, subject=mash)]
    // Cerebus_Syndrome -> the_darkening [+CerebusSyndrome]
  }
}
