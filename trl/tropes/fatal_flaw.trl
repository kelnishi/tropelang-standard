// === PREAMBLE ===
// @trope    Fatal Flaw (Hamartia / Tragic Flaw)
// @category Characterization / Tragedy
// @source   https://allthetropes.org/wiki/Fatal_Flaw
// @domain   Mind
// @version  1.3
//
// Laconic (per the wiki): Aristotle's hamartia — a single defining trait, often a virtue carried to
// excess (pride, ambition, jealousy), that prevents the Tragic Hero from succeeding and brings about
// their downfall despite their best efforts. FRONTIER: where Fall From Grace models the SLIDE (deed
// lowers the threshold for the next deed) and Booker's TRAGEDY names the plot, this names the CAUSAL
// LINK itself — it is the one NAMED trait, and no other, that authors the ruin. The recognition does
// not fire on a generic misfortune: it requires that the very thing the character is defined by is
// the thing that undoes them. Flaw and fall are tied; sever the flaw and the fall does not follow.


// === IMPORTS & ASSOCIATIONS ===
import "trl/modules/emotion_dynamics.trl"      // the inner pressure the flaw exerts; the slide's engine
import "trl/modules/booker_seven_plots.trl"    // TRAGEDY — "a flaw drives the protagonist down into ruin"
import "trl/concepts/index.trl"                 // the vices a flaw is made of: pride_excess, envy, wrath, longing
import "trl/tropes/fall_from_grace.trl"         // the SLIDE the flaw drives, deed by deed

assoc fatal_flaw -> [
  fall_from_grace : "is the named cause whose slide is",
  tragedy         : "is the engine of Booker's plot",
  pride_excess    : "hubris is its commonest form",
  the_past        : "Gatsby's flaw is the refusal to release"
]


// === ONTOLOGY ===
// A Fatal Flaw is the hamartia: the trait that doubles as the undoing. The cluster is the tragic
// machinery — the recognition (anagnorisis) comes too late, the reversal (peripeteia) is already in
// motion, and the fall is the flaw's own consequence.
imply FatalFlaw -> [Hamartia, Tragedy, Transformation, Narrative]


// === ABSTRACT RULE ===
// Recognition: a protagonist is DEFINED by a single trait — modelled as an obsession directed at a
// vice ([~Obsessed_With(target=$flaw)]) — and an event REVERSES their fortune (peripeteia). The
// signature that makes this a Fatal Flaw and not mere bad luck: the undoing is the flaw's own work,
// so the rule ties the named flaw to the fall ($flaw -> $c : "Undoes") and marks the character
// [+Fallen] — once elevated, now diminished BY the very thing that defined them.
rule Fatal_Flaw {
  when:
    char $c [+Protagonist] [~Obsessed_With(target=$flaw)]
    evt  $undoing [&Reverses(state=$c)]
  then:
    $c [+Fallen]
    $flaw -> $c : "Undoes"
    $c -- $flaw : "Hamartia"
}


// === CONCRETE VIGNETTE: The Great Gatsby — the dream that would not be let go (novel, 1925) ===
// Jay Gatsby remakes himself, mansion and shirts and parties, all of it aimed at one thing: to undo
// the years and reclaim Daisy as she was. His defining trait is the refusal to accept the past is
// gone — "Can't repeat the past? Why of course you can." The flaw is not a vice in the ledger sense
// but a hunger held past all reason, and it is precisely that hunger that ruins him: he shoulders the
// blame for the death Daisy caused, and Wilson, misled, shoots him in his own pool. The green light
// he reached for was always the thing that would undo him. Jazz-age America; intimate, not epic.

// JAY GATSBY — the self-made man fixed on an irretrievable past
char gatsby [+Protagonist]
gatsby [~Obsessed_With(target=the_past)]

// DAISY BUCHANAN — the green light at the end of the dock
char daisy [+LoveInterest]

// GEORGE WILSON — the instrument of the undoing, himself deceived
char wilson [+Antagonist]

// THE GREEN LIGHT — the dream made object
obj green_light [+Symbolic]

// EXT. GATSBY'S POOL, WEST EGG - DAY
set the_pool [+Exterior] [+Day]

arc gatsbys_undoing [+FatalFlaw]

scene the_dream_that_kills {
  beat 1 {
    gatsby > green_light : "reaches for the light across the water"
    gatsby [~Obsessed_With(target=the_past)]   // the defining trait: the past can be repeated
    gatsby -- daisy : "five years gone, and not a day relinquished"
  }
  beat 2 {
    gatsby @ the_pool
    // he takes Daisy's guilt as his own — the flaw makes him do it
    evt the_shooting [&Reverses(state=gatsby)]
        dialog(inject=[speaker=gatsby], inline="""
               speaker: "{speaker}"
               cue: "to Nick, the night before, certain the past is still in reach"
               tone: luminous, deluded
               text: "Can't repeat the past? Why of course you can, old sport."
               """)
    // Fatal_Flaw -> gatsby [+Fallen];  the_past -> gatsby : "Undoes";  gatsby -- the_past : "Hamartia"
    !gatsby [+Fallen]!
    the_past -> gatsby : "Undoes"
  }
}
