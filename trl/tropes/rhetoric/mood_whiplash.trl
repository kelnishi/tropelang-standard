// === PREAMBLE ===
// @trope    Mood Whiplash
// @category Rhetoric / Tone
// @source   https://allthetropes.org/wiki/Mood_Whiplash
// @domain   Narrative
// @scale    act
// @version  1.3
//
// Laconic (per the wiki): an abrupt, jarring shift in tone — a moment of levity suddenly broken by horror
// or grief (or the reverse). FRONTIER: a tonal-JUXTAPOSITION shape — the recognizer's weak spot, since it
// lives in the seam between two beats. Modeled here by a LINK: a [+Levity] moment whose mood is the target
// of a [&Shatters] event — the second beat explicitly breaks the first's tone, binding the adjacency. The
// whiplash is the shatter of the established lightness, not merely the co-presence of two tones.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"
import "trl/tropes/rhetoric/tear_jerker.trl"   // where the shattered levity often lands

assoc mood_whiplash -> [
  tear_jerker : "the abrupt setup for a",
  cerebus_syndrome : "the scene-scale spike vs the slow arc of",
  pratfall : "can puncture or be punctured by a"
]


// === ONTOLOGY ===
// — founded here (the shattered light moment is the discriminator; promotion model) —
prop Levity     [+Narrative]      // an established light, comedic, or happy moment
verb Shatters(mood) [+Narrative]  // abruptly breaks an established tone into its opposite

imply MoodWhiplash -> [Contrast, Narrative]


// === ABSTRACT RULE ===
// Naming rule (act scale): a [&Shatters] event breaks a [+Levity] mood — the light moment bound on the
// `mood=` role of the shatter (agent=$turn), so phase-2 re-checks [+Levity] on the broken moment (STYLE
// §8). Binding the established lightness on the act that breaks it is the discriminator: it links the two
// adjacent tones into a whiplash, rather than merely noting a story has both a funny and a sad beat.
rule Mood_Whiplash {
  when:
    obj  $moment [+Levity]
    evt  $turn [&Shatters(agent=$cause, mood=$moment)]
  then:
    $turn [+MoodWhiplash]
}


// === CONCRETE VIGNETTE: Up — the opening montage (animated film, 2009) ===
// The montage is pure joy: Carl and Ellie marry, fix up their little house, picnic and dream of
// Paradise Falls, growing old together in a warm flurry of light comedy and tenderness. And then, without
// a cut to soften it, the same gentle music carries us to a hospital, a single chair, a funeral — Ellie
// is gone, and Carl is alone. The established happiness is shattered into grief in the space of a breath.
// The whiplash that makes audiences weep four minutes into a kids' movie.

// THE MARRIED-LIFE MONTAGE — the established joy and warmth
obj the_happy_montage [+Levity]

// THE LOSS — Ellie's death, breaking the mood without warning
char the_loss [+Antagonist]

scene married_life {
  beat 1 {
    // the established lightness is broken, without a softening cut, into grief
    evt the_turn [&Shatters(agent=the_loss, mood=the_happy_montage)]
    // Mood_Whiplash -> the_turn [+MoodWhiplash]
  }
}
