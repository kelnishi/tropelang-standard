// === PREAMBLE ===
// @trope    Mood Whiplash
// @category Rhetoric / Tone
// @source   https://allthetropes.org/wiki/Mood_Whiplash
// @domain   Narrative
// @scale    scene
// @version  1.4
//
// Laconic (per the wiki): an abrupt, jarring shift in tone — a moment of levity suddenly broken by horror or
// grief (or the reverse). FRONTIER: a tonal-JUXTAPOSITION shape. Built on the promoted first-class Tone
// (prelude `[+Levity]` / `[+Gravity]`): the discriminator is the CO-PRESENCE of both tonal poles linked by a
// [&Shatters] event — an established [+Levity] moment shattered beside a [+Gravity] one. The whiplash is the
// collision of two opposite tones, not merely that a story has a funny beat somewhere and a sad beat elsewhere.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"
import "trl/tropes/rhetoric/tear_jerker.trl"   // where the shattered levity often lands

assoc mood_whiplash -> [
  tear_jerker : "the abrupt setup for a",
  cerebus_syndrome : "the scene-scale spike vs the slow arc of",
  pratfall : "can puncture or be punctured by a"
]


// === ONTOLOGY ===
// — reuses the promoted Tone poles ([+Levity]/[+Gravity], prelude); founds only the breaking verb —
verb Shatters(mood) [+Narrative]   // abruptly breaks an established tone into its opposite

imply MoodWhiplash -> [Contrast, Narrative]


// === ABSTRACT RULE ===
// Naming rule (scene scale): an established [+Levity] moment is SHATTERED beside a [+Gravity] one — the light
// moment bound on the `mood=` role of the [&Shatters] event (agent=$cause, the recall anchor) with an
// opposite-pole [+Gravity] moment co-present, so phase-2 re-checks BOTH tonal poles (STYLE §8). The
// juxtaposition of the two opposite tones is the discriminator — parting it from a story that merely holds a
// light beat and a grave beat far apart (no collision), and from Cerebus Syndrome (a slow whole-work arc).
rule Mood_Whiplash {
  when:
    obj  $light [+Levity]
    obj  $grave [+Gravity]
    evt  $turn  [&Shatters(agent=$cause, mood=$light)]
  then:
    $turn [+MoodWhiplash]
}


// === CONCRETE VIGNETTE: Up — the opening montage (animated film, 2009) ===
// The montage is pure joy: Carl and Ellie marry, fix up their little house, picnic and dream of Paradise
// Falls, growing old together in a warm flurry of light comedy and tenderness. And then, without a cut to
// soften it, the same gentle music carries us to a hospital, a single chair, a funeral — Ellie is gone, and
// Carl is alone. The established happiness is shattered into grief in the space of a breath. The whiplash that
// makes audiences weep four minutes into a kids' movie.

// THE MARRIED-LIFE MONTAGE — the established joy and warmth (the light pole)
obj the_happy_montage [+Levity]

// THE EMPTY CHAIR — the grief that lands without a softening cut (the grave pole, beside the levity)
obj the_grief [+Gravity]

// ELLIE'S DEATH — the loss that breaks the established mood without warning
char the_loss [+Antagonist]

scene married_life {
  beat 1 {
    // the established lightness is shattered, without a softening cut, against the grief beside it
    evt the_turn [&Shatters(agent=the_loss, mood=the_happy_montage)]
    // Mood_Whiplash -> the_turn [+MoodWhiplash]
  }
}
