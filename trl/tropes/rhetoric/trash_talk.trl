// === PREAMBLE ===
// @trope    Trash Talk
// @category Combat / Rhetoric
// @source   https://allthetropes.org/wiki/Trash_Talk
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): combatants belittle and needle each other during a contest — intimidation and
// distraction to psych the opponent out. FRONTIER: the in-contest jab. The discriminator is a [+Opponent]
// (someone one is matched against in a contest) bound on the target of a [&Taunts] event — so it fires on
// a belittling aimed at a competitor mid-contest, parting it from a Badass Boast (self-praise, not aimed
// to rattle a specific foe) and "The Reason You Suck" Speech (a fault-cataloguing takedown of a
// [+Culpable] target, not a contest jab).


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

assoc trash_talk -> [
  badass_boast : "the opponent-directed cousin of self-praising",
  the_reason_you_suck_speech : "a lighter, contest-bound jab beside",
  worthy_opponent : "its tone gauges how worthy an"
]


// === ONTOLOGY ===
// — founded here (the contest opponent + the rattling jab are the discriminator; promotion model) —
prop Opponent    [+Social]          // a contestant one is matched against — the foe in a duel/game/fight
verb Taunts(target) [+Interpersonal] // belittles an opponent to intimidate and psych them out

imply TrashTalk -> [Pathos, Narrative]


// === ABSTRACT RULE ===
// Naming rule: a competitor TAUNTS an [+Opponent] — the matched foe bound on the target role of a
// [&Taunts] event (agent=$a), so phase-2 re-checks [+Opponent] on the bound target (STYLE §8). Binding the
// contest-foe on the jab is the discriminator: the belittling is aimed at someone one is competing
// against, to rattle them — parting it from a Badass Boast (self-praise) and a fault-cataloguing "Reason
// You Suck" Speech.
rule Trash_Talk {
  when:
    char $a
    char $b [+Opponent]
    $a != $b
    evt  $jab [&Taunts(agent=$a, target=$b)]
  then:
    $jab [+TrashTalk]
}


// === CONCRETE VIGNETTE: Muhammad Ali — the pre-fight needle (boxing, 1960s–70s) ===
// Ali turned the press conference into a second ring. Before the bell he would tell the world — and the
// man across from him — exactly how it would go: "float like a butterfly, sting like a bee"; "I'm so mean
// I make medicine sick"; promising to put the champion on the canvas in a named round. Half showmanship,
// half warfare, every line aimed to get inside the opponent's head and rattle him before a punch was
// thrown. The art of the jab that lands before the fight.

// MUHAMMAD ALI — the master of the pre-fight needle
char ali [+Protagonist]

// THE CHALLENGER — the man across the ring, the target of the needling
char the_challenger [+Opponent]

// INT. THE WEIGH-IN - the press crowding the dais
set the_weigh_in [+Interior] [+Crowded]

scene the_pre_fight_presser {
  beat 1 {
    ali @ the_weigh_in
    // every line aimed to get inside the opponent's head before the bell
    evt the_needle [&Taunts(agent=ali, target=the_challenger)]
    // Trash_Talk -> the_needle [+TrashTalk]
  }
}
