// === PREAMBLE ===
// @trope    Unreliable Narrator
// @category Narrative Devices / Epistemic
// @source   https://allthetropes.org/wiki/Unreliable_Narrator
// @version  1.3
//
// Laconic (per the wiki): the narrator's facts contradict the truth — the audience is never as
// well informed as the story pretends. The teller may be a liar, a madman, or a naif; knowing
// or not. FRONTIER: the first corpus trope to use S14 diegetic levels. The narration is its own
// plane, declared `non_canon` with a `teller` — so by the §8 canon rule it can mint NO absolute
// fact. The truth lives one level out, as an `!immutable!` fact the tale cannot touch. The
// divergence between the two planes IS the unreliability; the reveal is when a witness (the
// classic interrogator, cf. Dragon Age II's Varric) catches the tale out.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // revelation, deception-adjacent concepts
import "trl/modules/theory_of_mind.trl"    // the knowledge-asymmetry this trope weaponizes

assoc unreliable_narrator -> [
  revelation    : "undone by a",
  theory_of_mind : "exploits the reader's"
]


// === ONTOLOGY ===

imply UnreliableNarrator -> [Deceptive, Epistemic, Narrative]


// === ABSTRACT RULE ===
// Naming rule: the moment a witness catches the teller out, the narration is exposed as unreliable.
rule Unreliable_Narration {
  when:
    evt $reveal [&Exposes(agent=$witness, target=$teller)]
  then:
    $reveal [+UnreliableNarrator]
}


// === CONCRETE VIGNETTE: The Usual Suspects — "Verbal" Kint / Keyser Söze (film) ===

// The interrogation room — the reality plane, where the truth lives (and can be absolute).
<<reality>>
char verbal [+Protagonist]
char kujan  [+Detective]
!verbal [+KeyserSoze]!                          // the immutable truth: the cripple IS the kingpin

// The story Verbal spins for Kujan — a NON-CANON plane, so it can mint no truth of its own.
<<reality.tale : non_canon, teller=verbal>>
char kint [+Pawn]                                // himself, as narrated — a harmless gimp
char soze [+Phantom] [+Antagonist]               // "Keyser Söze" narrated as a separate boogeyman
kint [~Fears(target=soze)]                        // in the tale, Kint dreads Söze as another man

// Back in the room — the tale comes apart (the dropped mug, the bulletin board).
<<reality>>
scene the_reveal {
  beat 1 {
    evt the_mug [&Exposes(agent=kujan, target=verbal)]
    // Unreliable_Narration -> the_mug [+UnreliableNarrator]; the whole tale was spun from the room
  }
}
