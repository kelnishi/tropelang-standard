// @title   TropeLang Trope Registry
// @version 0.1
// @note    One canonical entry per converted trope title, so a reference to a trope can be
//          REHYDRATED — resolved back to its definition (the `imply` + rules in the imported
//          file) and provenance (category + wiki source). A title that already exists as a
//          concept is REUSED (DRY), not redeclared.
//
//          Convention: the applied form is a [+PascalCase] tag (its `imply` lives in the
//          trope file); the canonical entry is the snake_case node below, marked [+Trope]
//          (the prelude meta-category) and carrying `category` + `source`.
//
// Importing this file brings the base concepts AND every converted trope into scope.

import "trl/concepts/index.trl"

import "trl/tropes/foreshadowing.trl"
import "trl/tropes/hope_spot.trl"
import "trl/tropes/the_reveal.trl"
import "trl/tropes/the_protagonist.trl"
import "trl/tropes/the_antagonist.trl"
import "trl/tropes/the_deuteragonist.trl"
import "trl/tropes/conflict.trl"
import "trl/tropes/the_hero.trl"
import "trl/tropes/the_mentor.trl"
import "trl/tropes/call_to_adventure.trl"
import "trl/tropes/three_act_structure.trl"
import "trl/tropes/chekhovs_gun.trl"
import "trl/tropes/red_herring.trl"
import "trl/tropes/refusal_of_the_call.trl"
import "trl/tropes/revenge.trl"
import "trl/tropes/despair_event_horizon.trl"
import "trl/tropes/heel_face_turn.trl"
import "trl/tropes/survivors_guilt.trl"


// === TROPE TITLE ENTRIES ===

// FORESHADOWING — a planted sign that pays off later. Reuses the existing concept
// `foreshadowing` (trl/concepts/narrative.trl); its [+Foreshadowing] tag is defined there.
foreshadowing [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Foreshadowing")]

// HOPE SPOT — a glimmer of escape, snatched away (sibling: Eucatastrophe). New entry; built
// on the existing `hope` / `despair` concepts (trl/concepts/emotional.trl).
concept hope_spot [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Hope_Spot")] [%Narrative]

// THE REVEAL — a concealed truth disclosed. Reuses concept `revelation` (narrative.trl);
// the cover/payoff is an epistemic collapse (perception -> knowledge).
revelation [+Trope(category="Omnipresent", source="allthetropes.org/wiki/The_Reveal")]

// CHEKHOV'S GUN — a planted object that must pay off. An honest species of Foreshadowing.
concept chekhovs_gun [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Chekhovs_Gun")] [%Narrative]

// RED HERRING — a clue deliberately planted to mislead. A false species of Foreshadowing.
concept red_herring [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Red_Herring")] [%Narrative]

// REVENGE — a wrong drives the hunt for the wrongdoer. Reuses concept `revenge`
// (narrative.trl); rides the emotion-dynamics vengeance thread.
revenge [+Trope(category="Death Tropes", source="allthetropes.org/wiki/Revenge")]

// DESPAIR EVENT HORIZON — the irreversible crossing into total despair. Rides the
// emotion-dynamics hope -> despair thread; the dark mirror of Hope Spot.
concept despair_event_horizon [+Trope(category="Despair", source="allthetropes.org/wiki/Despair_Event_Horizon")] [%Narrative]

// HEEL FACE TURN / FACE HEEL TURN — a moral-alignment reversal (villain -> hero, or the
// fall back). Rides the emotion-dynamics appraisal layer (guilt / grief catalyzes the flip).
concept heel_face_turn [+Trope(category="Character Development", source="allthetropes.org/wiki/Heel_Face_Turn")] [%Narrative]
concept face_heel_turn [+Trope(category="Character Development", source="allthetropes.org/wiki/Face_Heel_Turn")] [%Narrative]

// SURVIVOR'S GUILT — the guilt of having lived when others died. A self-directed trauma
// that composes with S8 (Memory): imprint -> trigger -> catharsis / repression.
concept survivors_guilt [+Trope(category="Trauma", source="allthetropes.org/wiki/Survivor_Guilt")] [%Psychological]

// CHARACTER-ROLE BUILDING BLOCKS (Universal Tropes) — the cast structure. The applied
// forms are the prelude roles [+Protagonist] / [+Antagonist]; these are the canonical
// title nodes. The deuteragonist is the secondary main character.
concept protagonist   [+Trope(category="Universal", source="allthetropes.org/wiki/The_Protagonist")] [%Narrative]
concept antagonist    [+Trope(category="Universal", source="allthetropes.org/wiki/The_Antagonist")] [%Narrative]
concept deuteragonist [+Trope(category="Universal", source="allthetropes.org/wiki/Deuteragonist")] [%Narrative]

// CONFLICT — the engine of narrative. Reuses concept `conflict` (narrative.trl).
conflict [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Conflict")]

// THE HERO — the courageous protagonist who sacrifices for others. New entry; built on
// the prelude [+Protagonist]/[+Courageous] and the `sacrifice` concept.
concept hero [+Trope(category="Universal", source="allthetropes.org/wiki/The_Hero")] [%Narrative]

// THE MENTOR — the wise guide of the protagonist. New entry; built on the prelude
// Mentor_Of / Student_Of relations and the Wise / Ally roles.
concept mentor [+Trope(category="Universal", source="allthetropes.org/wiki/Mentors")] [%Narrative]

// CALL TO ADVENTURE — the inciting summons out of the ordinary world. Reuses the `calling`
// concept (narrative.trl).
concept call_to_adventure [+Trope(category="Universal", source="allthetropes.org/wiki/Call_to_Adventure")] [%Narrative]

// THREE-ACT STRUCTURE — the dramatic spine (setup / confrontation / resolution). Maps onto
// the built-in `act` temporal scopes.
concept three_act_structure [+Trope(category="Universal", source="allthetropes.org/wiki/Three_Act_Structure")] [%Narrative]

// REFUSAL OF THE CALL — the hero first declines the summons (Hero's Journey beat 2).
concept refusal_of_the_call [+Trope(category="Universal", source="allthetropes.org/wiki/Refusal_of_the_Call")] [%Narrative]
