// === TROPE TITLE ENTRIES ===

// FORESHADOWING — a planted sign that pays off later. Reuses the existing concept
// `foreshadowing` (trl/concepts/narrative.trl); its [+Foreshadowing] tag is defined there.
foreshadowing [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Foreshadowing")]

// HOPE SPOT — a glimmer of escape, snatched away (sibling: Eucatastrophe). New entry; built
// on the existing `hope` / `despair` concepts (trl/concepts/emotional.trl).
concept hope_spot [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Hope_Spot")] [%Narrative]

// THE REVEAL — a concealed truth disclosed. Reuses concept `revelation` (narrative.trl);
// the cover/payoff is an epistemic collapse (perception -> knowledge).
revelation [+Trope(category="Omnipresent", source="allthetropes.org/wiki/The_Reveal")]

// CHEKHOV'S GUN — a planted object that must pay off. An honest species of Foreshadowing.
concept chekhovs_gun [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Chekhovs_Gun")] [%Narrative]

// RED HERRING — a clue deliberately planted to mislead. A false species of Foreshadowing.
concept red_herring [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Red_Herring")] [%Narrative]

// REVENGE — a wrong drives the hunt for the wrongdoer. Reuses concept `revenge`
// (narrative.trl); rides the emotion-dynamics vengeance thread.
revenge [+Trope(category="Death Tropes", source="allthetropes.org/wiki/Revenge")]

// DESPAIR EVENT HORIZON — the irreversible crossing into total despair. Rides the
// emotion-dynamics hope -> despair thread; the dark mirror of Hope Spot.
concept despair_event_horizon [+Trope(category="Despair", source="allthetropes.org/wiki/Despair_Event_Horizon")] [%Narrative]

// HEEL FACE TURN / FACE HEEL TURN — a moral-alignment reversal (villain -> hero, or the
// fall back). Rides the emotion-dynamics appraisal layer (guilt / grief catalyzes the flip).
concept heel_face_turn [+Trope(category="Character Development", source="allthetropes.org/wiki/Heel_Face_Turn")] [%Narrative]

// CHARACTER TRANSFORMATION ARCS — the whole moral/developmental trajectory (vs the single-beat
// turn): Redemption (ascent), Fall From Grace (the descending slide), Coming of Age (development).
concept redemption_arc         [+Trope(category="Transformation", source="allthetropes.org/wiki/The_Atoner")] [%Mind]
concept fall_from_grace        [+Trope(category="Transformation", source="allthetropes.org/wiki/Start_of_Darkness")] [%Mind]
concept coming_of_age          [+Trope(category="Transformation", source="allthetropes.org/wiki/Coming_of_Age_Story")] [%Mind]
concept face_heel_turn [+Trope(category="Character Development", source="allthetropes.org/wiki/Face_Heel_Turn")] [%Narrative]

// SURVIVOR'S GUILT — the guilt of having lived when others died. A self-directed trauma
// that composes with S8 (Memory): imprint -> trigger -> catharsis / repression.
concept survivors_guilt [+Trope(category="Trauma", source="allthetropes.org/wiki/Survivor_Guilt")] [%Psychological]

// SPECIFIC ACTIONS — conflict & cooperation at the event level (ride action_dynamics).
// The Finishing Move (a decisive signature blow, often set up by an ally), Bar the Door (deny
// access / buy time), and the Improvised Weapon (an indirect, environmental attack).
concept finishing_move   [+Trope(category="Combat", source="allthetropes.org/wiki/Finishing_Move")] [%Interpersonal]
concept bar_the_door     [+Trope(category="Tactics", source="allthetropes.org/wiki/Hold_The_Line")] [%Interpersonal]
concept improvised_weapon [+Trope(category="Tactics", source="allthetropes.org/wiki/Improvised_Weapon")] [%Interpersonal]

// MORE ACTION TACTICS (ride action_dynamics). Feint (bait an overcommit, then punish it), Ambush
// (strike from concealment, bypassing guard), and Heroic Sacrifice (spend your own position to
// save an ally — the costly extreme of cooperation).
concept feint            [+Trope(category="Tactics", source="allthetropes.org/wiki/Defensive_Feint_Trap")] [%Interpersonal]
concept ambush           [+Trope(category="Tactics", source="allthetropes.org/wiki/Inescapable_Ambush")] [%Interpersonal]
concept heroic_sacrifice [+Trope(category="Sacrifice", source="allthetropes.org/wiki/Heroic_Sacrifice")] [%Interpersonal]

// SIEGE & REACTIVE TACTICS (ride action_dynamics). Last Stand (hold against the odds, buy time at
// a cost) and The Cavalry (relief arrives) are a matched pair — the held line and its relief.
// Counter (let the foe commit, then turn it back) is the reactive mirror of the Feint.
concept last_stand  [+Trope(category="Tactics", source="allthetropes.org/wiki/Last_Stand")] [%Interpersonal]
concept the_cavalry [+Trope(category="Tactics", source="allthetropes.org/wiki/The_Cavalry")] [%Interpersonal]
concept counter     [+Trope(category="Tactics", source="allthetropes.org/wiki/Counter_Attack")] [%Interpersonal]

// PROPHECY / FOREKNOWLEDGE (ride prophecy.trl). Self-Fulfilling (the avoidance seals the fate —
// latent → absolute; Oedipus) and the Prophecy Twist (the equivocation collapses the unforeseen
// way — §11 ambiguity + resolve; Macbeth's "none of woman born").
concept self_fulfilling_prophecy [+Trope(category="Fate", source="allthetropes.org/wiki/Self-Fulfilling_Prophecy")] [%Epistemic]
concept prophecy_twist           [+Trope(category="Fate", source="allthetropes.org/wiki/Prophecy_Twist")] [%Epistemic]

// COMMON KNOWLEDGE (ride common_knowledge.trl). The two resolutions of mutual knowledge: spoken
// (Emperor's New Clothes — the child makes it common and the fiction collapses) vs. unspoken
// (Open Secret — a tacit pact keeps it from ever becoming common; Discworld's Carrot).
concept emperors_new_clothes [+Trope(category="Social", source="allthetropes.org/wiki/The_Emperor's_New_Clothes")] [%Epistemic]
concept open_secret          [+Trope(category="Social", source="allthetropes.org/wiki/Open_Secret")] [%Epistemic]

// MORE EPISTEMIC ARENAS. Cassandra Truth (true foresight that can't propagate — the inverse of
// common knowledge; Troy). The Gambit (a plan built on predicting others' behaviour — weaponized
// theory of mind; Code Geass). Tomato Surprise (a fact withheld from the audience, surfaced to
// recolour everything — latent → absolute; Pale Fire).
concept cassandra_truth  [+Trope(category="Knowledge", source="allthetropes.org/wiki/Cassandra_Truth")] [%Epistemic]
concept the_gambit       [+Trope(category="Strategy", source="allthetropes.org/wiki/Batman_Gambit")] [%Epistemic]
concept tomato_surprise  [+Trope(category="Narrative Devices", source="allthetropes.org/wiki/Tomato_Surprise")] [%Epistemic]

// DRAMATIC IRONY — promoted to a first-class trope (the baseline the epistemic cluster defines
// itself against). Reuses the existing `dramatic_irony` concept from theory_of_mind.trl (DRY).
dramatic_irony [+Trope(category="Narrative Devices", source="allthetropes.org/wiki/Dramatic_Irony")]

// POLITICAL / COLLECTIVE SCALE (ride power_dynamics — the [%Political] domain). Klingon Promotion
// (take a rank by killing its holder; Commodus), Full-Circle Revolution (the deposers become the
// deposed; Animal Farm), Divide and Conquer (keep rivals from uniting; Jay Gould).
concept klingon_promotion      [+Trope(category="Power", source="allthetropes.org/wiki/Klingon_Promotion")] [%Political]
concept full_circle_revolution [+Trope(category="Power", source="allthetropes.org/wiki/Full-Circle_Revolution")] [%Political]
concept divide_and_conquer     [+Trope(category="Power", source="allthetropes.org/wiki/Divide_and_Conquer")] [%Political]
concept the_coup               [+Trope(category="Power", source="allthetropes.org/wiki/The_Coup_d'Etat")] [%Political]
concept smear_campaign   [+Trope(category="Reputation", source="https://allthetropes.org/wiki/Malicious_Slander")] [%Social]   // serialised slander brands one name into common belief
concept praetorian_guard       [+Trope(category="Power", source="allthetropes.org/wiki/Praetorian_Guard")] [%Political]
concept decadent_court         [+Trope(category="Power", source="allthetropes.org/wiki/Deadly_Decadent_Court")] [%Political]
concept we_have_reserves       [+Trope(category="Conflict", source="allthetropes.org/wiki/We_Have_Reserves")] [%Political]

// THE DUEL — bridges the Reputation and action_dynamics modules (honor injured -> honor answered
// with a strike). Filed social/conflict; reuses [%Social] + [%Interpersonal] domains.
concept the_duel               [+Trope(category="Honor", source="allthetropes.org/wiki/Duel_to_the_Death")] [%Social]

// RHETORIC / AUDIENCE (ride rhetoric.trl — the author->audience layer). Rule of Funny (comic
// framing makes the audience laugh, logic be damned; Zoolander), Deus Ex Machina (authorial
// override imposes an unearned resolution — a diegetic crossing; Euripides), Cliffhanger (the
// curiosity gap held open to leash attention; "Who shot J.R.?").
concept rule_of_funny    [+Trope(category="Comedy", source="allthetropes.org/wiki/Rule_of_Funny")] [%Narrative]
concept deus_ex_machina  [+Trope(category="Resolution", source="allthetropes.org/wiki/Deus_Ex_Machina")] [%Narrative]
concept cliffhanger      [+Trope(category="Suspense", source="allthetropes.org/wiki/Cliff_Hanger")] [%Narrative]
concept rule_of_cool     [+Trope(category="Spectacle", source="allthetropes.org/wiki/Rule_of_Cool")] [%Narrative]

// CHARACTER RELATIONSHIPS (the dyad — long a gap). The Foil (contrastive characterization — a
// character defined by the GAP with another; Quixote & Sancho) and Star-Crossed Lovers (mutual
// love across an unbridgeable obstacle; Pyramus & Thisbe).
concept the_foil             [+Trope(category="Characterization", source="allthetropes.org/wiki/Foil")] [%Narrative]
concept star_crossed_lovers  [+Trope(category="Romance", source="allthetropes.org/wiki/Star-Crossed_Lovers")] [%Interpersonal]

// CHARACTER RELATIONSHIPS — the dyad/triad domain. Sidekick (loyal support), The Rival
// (generative competition), Unrequited Love (the asymmetric dyad), Found Family (a family
// assembled), Enemies to Lovers (the reversal), Love Triangle (the first non-dyad structure).
concept the_sidekick      [+Trope(category="Cast", source="allthetropes.org/wiki/Sidekick")] [%Interpersonal]
concept the_rival         [+Trope(category="Cast", source="allthetropes.org/wiki/The_Rival")] [%Interpersonal]
concept unrequited_love   [+Trope(category="Romance", source="allthetropes.org/wiki/Unrequited_Love_Lasts_Forever")] [%Interpersonal]
concept found_family      [+Trope(category="Bonds", source="allthetropes.org/wiki/Chosen_Family")] [%Interpersonal]
concept enemies_to_lovers [+Trope(category="Romance", source="allthetropes.org/wiki/Foe_Yay")] [%Interpersonal]
concept love_triangle     [+Trope(category="Romance", source="allthetropes.org/wiki/Love_Triangle")] [%Interpersonal]

// MORE RELATIONSHIPS: The Big Bad (the nemesis dyad) and Mentor & Student (the teaching bond).
concept the_big_bad        [+Trope(category="Cast", source="allthetropes.org/wiki/Big_Bad")] [%Interpersonal]
concept mentor_and_student [+Trope(category="Bonds", source="allthetropes.org/wiki/Mentors")] [%Interpersonal]
concept pyrrhic_victory  [+Trope(category="Conflict", source="https://allthetropes.org/wiki/Pyrrhic_Victory")] [%Interpersonal]   // a win that costs more than the loss it averts
concept the_trap         [+Trope(category="Tactics", source="https://allthetropes.org/wiki/Lured_into_a_Trap")] [%Interpersonal]   // lure + sealed exit + strike (the kill-zone)
concept pincer_maneuver  [+Trope(category="Tactics", source="https://allthetropes.org/wiki/Pincer_Attack")] [%Interpersonal]   // two converging jaws; the foe cannot face both

// IDENTITY / WORLDBUILDING (the drams-flagged gap — archetype tags that subsume world-specific
// lineage/disguise/destiny facts). Hidden Identity, Rightful King Returns, The Chosen One.
concept hidden_identity       [+Trope(category="Identity", source="allthetropes.org/wiki/Secret_Identity")] [%Epistemic]
concept rightful_king_returns [+Trope(category="Identity", source="allthetropes.org/wiki/Rightful_King_Returns")] [%Political]
concept the_chosen_one        [+Trope(category="Fate", source="allthetropes.org/wiki/The_Chosen_One")] [%Narrative]

// CAST ARCHETYPES BY TRAIT (close the trait gap in both eval stories). The Paragon (incorruptible
// virtue — Trustworthy/Loyal/Honorable) and The Everyman (the ordinary, mortal audience surrogate).
concept the_paragon       [+Trope(category="Cast", source="allthetropes.org/wiki/The_Paragon")] [%Narrative]
concept the_everyman      [+Trope(category="Cast", source="allthetropes.org/wiki/Everyman")] [%Narrative]

// NON-FICTION FORMS (ride non_fiction.trl). The Host (the on-screen guide), Putting It to the Test
// (the experiment as a narrative beat; reality writes the verdict), Based on a True Story (the
// truth-claim + fidelity dial).
concept the_host                [+Trope(category="Non-Fiction", source="allthetropes.org/wiki/The_Host")] [%Narrative]
concept putting_it_to_the_test  [+Trope(category="Non-Fiction", source="allthetropes.org/wiki/MythBusters")] [%Narrative]
concept based_on_a_true_story   [+Trope(category="Non-Fiction", source="allthetropes.org/wiki/Based_on_a_True_Story")] [%Narrative]

// FOREGONE CONCLUSION — the assumption-fix the Olympic biopic surfaced: the curiosity gap has a
// PROCESS mode (known outcome, suspense in the how/why), not only the Cliffhanger's outcome mode.
concept foregone_conclusion    [+Trope(category="Suspense", source="allthetropes.org/wiki/Foregone_Conclusion")] [%Narrative]

// HUMAN INTEREST STORY — the live-broadcast athlete profile; the purest instance of audience
// INVESTMENT (rhetoric Â§3): endear a real person over an UNKNOWN outcome so the live result lands.
concept human_interest_story   [+Trope(category="Non-Fiction", source="allthetropes.org/wiki/Human_Interest_Story")] [%Narrative]

// PROPAGANDA — persuasion's dark twin: ethos + pathos + REPETITION installing a false belief
// against reality, and entrenching it against the truth (the Big Lie).
concept propaganda             [+Trope(category="Oratory", source="allthetropes.org/wiki/Big_Lie")] [%Narrative]

// ROUSING SPEECH — honest pathos-only persuasion (the bright mirror of propaganda): appeal to
// shared honor to turn a disheartened band's fear into resolve, galvanizing straight to action.
concept rousing_speech         [+Trope(category="Oratory", source="allthetropes.org/wiki/Rousing_Speech")] [%Narrative]

// ROGUE JUROR — the burden-of-proof gate: a reasonable doubt defeats an otherwise-persuasive case.
concept rogue_juror            [+Trope(category="Oratory", source="allthetropes.org/wiki/Rogue_Juror")] [%Narrative]

// THE DEBATE — adversarial persuasion: two speakers contend for one audience, a rebuttal unseats
// the held thesis and belief swings. The audience is contested ground.
concept the_debate             [+Trope(category="Oratory", source="allthetropes.org/wiki/The_Debate")] [%Narrative]

// UNRELIABLE NARRATOR — the narration's facts diverge from the truth. The first corpus trope
// to use S14 diegetic levels: a non_canon narration plane (with a teller) vs the reality plane.
concept unreliable_narrator [+Trope(category="Narrative Devices", source="allthetropes.org/wiki/Unreliable_Narrator")] [%Epistemic]
concept the_narrator     [+Trope(category="Narrative Devices", source="https://allthetropes.org/wiki/Narrator")] [%Narrative]   // the teller on a level above the tale (S14)

// DIEGETIC-LEVEL DEVICES (all built on S14 levels). Frame Story nests canon tales (Frankenstein,
// 3 deep); Dream Sequence is a non_canon dream that dissolves to latent on waking (Link's
// Awakening); Breaking the Fourth Wall crosses OUT to the audience plane (Ferris Bueller).
concept frame_story    [+Trope(category="Narrative Devices", source="allthetropes.org/wiki/Framing_Device")] [%Narrative]
concept dream_sequence [+Trope(category="Narrative Devices", source="allthetropes.org/wiki/All_Just_a_Dream")] [%Epistemic]
concept fourth_wall    [+Trope(category="Metafiction", source="allthetropes.org/wiki/Breaking_the_Fourth_Wall")] [%Narrative]

// MORE DIEGETIC-LEVEL DEVICES. Dream Within a Dream stacks non_canon planes (Inception, 4 deep);
// Show Within a Show is an inner fiction that mirrors a canon truth and loops back (Hamlet);
// Or Was It a Dream? pairs the dream plane with an uncollapsed `(real|dream)` ambiguity (Coleridge).
concept dream_within_a_dream [+Trope(category="Narrative Devices", source="allthetropes.org/wiki/Dream_Within_a_Dream")] [%Epistemic]
concept show_within_a_show   [+Trope(category="Metafiction", source="allthetropes.org/wiki/Show_Within_a_Show")] [%Narrative]
concept or_was_it_a_dream    [+Trope(category="Narrative Devices", source="allthetropes.org/wiki/All_Just_a_Dream")] [%Epistemic]

// CHARACTER-ROLE BUILDING BLOCKS (Universal Tropes) — the cast structure. The applied
// forms are the prelude roles [+Protagonist] / [+Antagonist]; these are the canonical
// title nodes. The deuteragonist is the secondary main character.
concept protagonist   [+Trope(category="Universal", source="allthetropes.org/wiki/The_Protagonist")] [%Narrative]
concept antagonist    [+Trope(category="Universal", source="allthetropes.org/wiki/The_Antagonist")] [%Narrative]
concept deuteragonist [+Trope(category="Universal", source="allthetropes.org/wiki/Deuteragonist")] [%Narrative]

// CONFLICT — the engine of narrative. Reuses concept `conflict` (narrative.trl).
conflict [+Trope(category="Omnipresent", source="allthetropes.org/wiki/Conflict")]

// THE HERO — the courageous protagonist who sacrifices for others. New entry; built on
// the prelude [+Protagonist]/[+Courageous] and the `sacrifice` concept.
concept hero [+Trope(category="Universal", source="allthetropes.org/wiki/The_Hero")] [%Narrative]

// THE MENTOR — the wise guide of the protagonist. New entry; built on the prelude
// Mentor_Of / Student_Of relations and the Wise / Ally roles.
concept mentor [+Trope(category="Universal", source="allthetropes.org/wiki/Mentors")] [%Narrative]

// CALL TO ADVENTURE — the inciting summons out of the ordinary world. Reuses the `calling`
// concept (narrative.trl).
concept call_to_adventure [+Trope(category="Universal", source="allthetropes.org/wiki/Call_to_Adventure")] [%Narrative]

// THREE-ACT STRUCTURE — the dramatic spine (setup / confrontation / resolution). Maps onto
// the built-in `act` temporal scopes.
concept three_act_structure [+Trope(category="Universal", source="allthetropes.org/wiki/Three_Act_Structure")] [%Narrative]

// REFUSAL OF THE CALL — the hero first declines the summons (Hero's Journey beat 2).
concept refusal_of_the_call [+Trope(category="Universal", source="allthetropes.org/wiki/Refusal_of_the_Call")] [%Narrative]

