// === PREAMBLE ===
// @trope    Unrequited Love
// @category Relationships / Romance
// @source   https://allthetropes.org/wiki/Unrequited_Love_Lasts_Forever
// @version  1.3
// @domain    Interpersonal
//
// Laconic (per the wiki): one loves another who does not love them back — and pines, often with a
// selfless "I want my beloved to be happy" rather than possession. The asymmetric dyad: the whole
// weight of feeling falls on one side, and the gap between them is the ache.

import "trl/concepts/index.trl"            // love, longing

assoc unrequited_love -> [
  love    : "the unanswered half of",
  longing : "settles, unanswered, into"
]

imply UnrequitedLove -> [love, Sorrow, Narrative]

// Naming rule: loving one who does not love back leaves the lover pining — that is Unrequited Love.
rule Unrequited_Love {
  when:
    char $a [~Loves(target=$b)]
    not ( $b [~Loves(target=$a)] )
  then:
    $a [+Pining(for=$b)]
    $a -- longing
}

// === CONCRETE VIGNETTE: Cyrano de Bergerac — the balcony (play, 1897) ===
// Cyrano loves Roxane, who loves the handsome Christian; ashamed of his nose, Cyrano lends his own
// words to woo her for his rival, and goes to his grave with the truth — wanting only her joy.
char cyrano    [+Protagonist]  [~Loves(target=roxane)]
char roxane    [+LoveInterest] [~Loves(target=christian)]
char christian [+Ally]

scene under_the_balcony {
  beat 1 {
    cyrano -- roxane : "his words in another man's mouth"
    // Unrequited_Love -> cyrano [+Pining(for=roxane)]
  }
}
