// === PREAMBLE ===
// @trope    Sibling Rivalry
// @category Relationships / Family
// @source   https://allthetropes.org/wiki/Sibling_Rivalry
// @domain    Interpersonal
// @version  1.3
//
// Laconic (per the wiki): two siblings end up rivals — competing for toys, love, food, attention,
// inheritance, supremacy, in short for everything. A little is healthy and builds character; left
// to fester it curdles, and where a parent takes sides one becomes The Unfavorite. The signature
// over a plain Rival: the rivals are KIN. The bond and the contest COEXIST, so the rivalry is
// sharpened by shared blood — set against the one you are bound to love, the envy cuts deeper.

// === IMPORTS & ASSOCIATIONS ===
import "trl/tropes/character/roles/the_rival.trl"          // Rival_Of, Spurred, TheRival — the rivalry dyad it rides
import "trl/modules/emotion_dynamics.trl"  // Envies, Resentful — the envy/resentment it inherits
import "trl/concepts/index.trl"            // envy, inheritance, conflict

assoc sibling_rivalry -> [
  the_rival   : "is, between kin, an intensified",
  envy        : "shared blood sharpens the contest into",
  inheritance : "the parent's love or estate is the",
  conflict    : "bond and contest coexist as a"
]

// === ONTOLOGY ===
// A Rival dyad that also carries the Kinship bond — the contest rides on shared blood.
imply SiblingRivalry -> [TheRival, Kinship, Narrative]

// === ABSTRACT RULE ===
// Recognition rule: two siblings ALSO set as rivals -> a rivalry intensified by kinship. The kin
// bond does not soften the contest; it sharpens it into envy and resentment (what a plain Rival
// lacks). The dyad is tagged SiblingRivalry, and each kin-rival begrudges the one they're bound to.
rule Sibling_Rivalry {
  when:
    char $a [@Sibling_Of(other=$b)] [@Rival_Of(other=$b)]
    evt  $contest [&Challenged(agent=$a, other=$b)]     // the kin-rival presses the contest (binds the dyad)
  then:
    $a [+SiblingRivalry]
    $a [~Envies(target=$b)]
    $a [#Resentful]
    $contest [+SiblingRivalry]
    $a -- envy
}

// === CONCRETE VIGNETTE: The Lion King — Mufasa and Scar (animated film, 1994) ===
// Two brothers of the royal line: one born to the throne, the other second and seething. Scar's
// envy of Mufasa — the crown, Sarabi, the pride's love, all of which the elder holds — festers
// across a lifetime of being Always Second Best, until the bond of blood becomes the path to
// fratricide: he lures Mufasa into the gorge and lets him fall. Kingdom-scale stakes; mythic.

// MUFASA — the king, the favored elder
char mufasa [+Protagonist] [+King] [@Sibling_Of(other=scar)] [@Rival_Of(other=scar)]

// SCAR — the second-born, Always Second Best
char scar [+Antagonist] [@Sibling_Of(other=mufasa)] [@Rival_Of(other=mufasa)]
scar [+Unfavorite]
scar [~Desires(target=throne)]

// THE THRONE — the inheritance contested
obj throne [+MacGuffin]

// EXT. PRIDE ROCK - DAY
set pride_rock [+Exterior] [+Day]

scene the_second_son {
  beat 1 {
    mufasa @ pride_rock
    scar @ pride_rock
    scar -- mufasa : "born first, and so born king — while I am left the throne's shadow"
    evt the_gorge [&Challenged(agent=scar, other=mufasa)]   // the kin-rival presses the contest to its end
    // Sibling_Rivalry -> scar [+SiblingRivalry] [~Envies(mufasa)] [#Resentful] -- envy; the_gorge [+SiblingRivalry]
  }
}
