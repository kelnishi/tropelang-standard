// === PREAMBLE ===
// @trope    The Mentor
// @category Universal Tropes
// @source   https://allthetropes.org/wiki/Mentors
// @version  1.3
// @domain    Narrative
//
// Laconic: the wise, experienced figure who guides and trains a less-experienced
// protagonist. The connective detail is encoded below in CODE — `import` for the nodes it
// depends on, `assoc` for lateral thematic links, `imply` for hierarchy — not left in this
// note, so evaluators and embeddings can follow the actual connections.


// === IMPORTS — explicit dependencies on other nodes ===
import "trl/concepts/virtues.trl"      // wisdom
import "trl/concepts/universal.trl"    // legacy
import "trl/concepts/existential.trl"  // becoming, death


// === ASSOCIATIONS — lateral, optional, machine-followable (was buried in the laconic) ===
assoc mentor -> [
  wisdom   : "imparts",
  legacy   : "leaves behind",
  becoming : "catalyzes in the student",
  death    : "occupational hazard",
  hero     : "guides"
]


// === ONTOLOGY — hierarchy ===
imply Mentor -> [Ally, Authority, Wise]


// === ABSTRACT RULE ===
// A wise ally bound to a protagonist by the mentor/student relation is The Mentor; the
// bond is made reciprocal. (Reuses the prelude Mentor_Of / Student_Of rels.)
rule TheMentor {
  when:
    char $mentor [+Wise]
    char $student [+Protagonist]
    $mentor [@Mentor_Of(student=$student)]
  then:
    $mentor  [+Mentor]
    $student [@Student_Of(mentor=$mentor)]
}


// === CONCRETE VIGNETTE: The Karate Kid — Mr. Miyagi and Daniel (film) ===

// DANIEL LARUSSO
char daniel [+Protagonist] [+Untrained]

// MR. MIYAGI
char miyagi [+Wise] [+Elder]
miyagi [@Mentor_Of(student=daniel)]

scene the_lessons {
  beat 1 {
    evt discipline -> miyagi > daniel : "Wax On, Wax Off"
    evt reveal     -> daniel @ miyagi : "The Chores Were The Training"
    miyagi [+Mentor]
    daniel [@Student_Of(mentor=miyagi)]
  }
}
