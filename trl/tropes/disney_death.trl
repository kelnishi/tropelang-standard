// === PREAMBLE ===
// @trope    Disney Death
// @category Death Tropes
// @source   https://allthetropes.org/wiki/Disney_Death
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): a death scene that isn't — a sympathetic character appears to die
// in a dramatic, tear-jerking moment, the cast and the room mourn, and then they are revealed
// alive after all. The grief is real but the death is not; the loss is staged for pathos and
// then taken back. FRONTIER: the false-DEATH inversion of the Hope Spot's false-HOPE. Where
// the Hope Spot dangles a rescue that proves [+Deceptive] and is snatched away (audience joy ->
// grief), the Disney Death dangles a DEATH that proves [+Deceptive] and is reversed by a
// &Reveals (audience grief -> joy). Distinct from Eucatastrophe: a eucatastrophe is a REAL,
// unlooked-for rescue of a still-imperiled hero; here the death itself was never real — nothing
// is delivered, a misperception is corrected. The disclosure is The Reveal applied to a death.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // joy, grief as edge targets
import "trl/tropes/hope_spot.trl"          // the inverted sibling — false HOPE vs this false DEATH
import "trl/tropes/the_reveal.trl"         // the death disclosed false — a &Reveals payoff
import "trl/modules/rhetoric.trl"          // the audience whose grief this turns to joy

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc disney_death -> [
  grief         : "stages, over the room, a false",
  joy           : "reverses the staged grief into",
  hope_spot     : "the false-DEATH inversion of the false-HOPE",
  the_reveal    : "the death disclosed false is a",
  eucatastrophe : "NOT a real unlooked-for rescue, unlike",
  revelation    : "the disclosure that reverses the death is a",
  audience      : "moves from grief to joy, the"
]


// === ONTOLOGY ===
// A reversal that REVOKES a death — the Hope Spot's [Reversal, Deceptive] cluster, signed the
// other way: there the glimmer is FalseHope, here the death is FalseDeath. Both are deceptive
// reversals of an imperiled situation; the Disney Death's apparent loss is, secretly, false.

imply DisneyDeath -> [Reversal, Deceptive, Narrative]
imply FalseDeath  -> [Deceptive, Reversal]


// === ABSTRACT RULE ===
// An apparently dead character lies in a dramatic loss; the cast mourns and the audience falls
// into grief. The death is LATENTLY [+Deceptive] (?...?) — present in the graph, surfaced to no
// one: the character is not truly gone. A &Reveals disclosure (The Reveal, applied to the death)
// collapses the misperception: the character is [-Dead] [+Alive], and the audience is carried
// in a single beat from grief to joy. The life, once disclosed, is the felt truth (!...!) — the
// bright mirror of the Hope Spot's !despair!, reached by the opposite route (a false death lifted,
// not a false hope crushed).
rule DisneyDeath {
  when:
    char $hero [+Dead]
    audience [#Grieving]
    ?$hero [+Deceptive]?
    evt $disclosure [&Reveals(fact=$alive)]
    not ( $disclosure [+Resolved] )
  then:
    $disclosure [+Resolved] [+TheReveal]
    $hero [-Dead]
    $hero [+Alive]
    audience [-Grieving]
    !$hero [+Alive]!
    !audience [#Joyful]!
    audience -> grief : "Turns From"
    audience -> joy : "Turns To"
    audience -- joy
}


// === CONCRETE VIGNETTE: The Iron Giant — "Superman." and the Iceland coda (animated film, 1999) ===
// At the climax the Giant flies up to meet the warhead so the town will live; he closes his eyes,
// says "Superman," and is gone — the screen, the town, and the audience mourn a sacrifice that
// looks total. Then the coda: in Iceland, a stray self-repairing bolt stirs toward its own body.
// The death was real-seeming but false; he was only scattered, and he is reassembling. Grief lifts
// into joy — not a rescue winched in, but a loss revealed never to have been final.

// THE IRON GIANT
char giant [+Protagonist] [#Imperiled]
giant [+MotivatedBy(reason="Chosen Goodness")]

// HOGARTH HUGHES — the boy who mourns him
char hogarth [+Protagonist] [#Grieving]

// THE WARHEAD — the doom he flies up to meet
obj warhead [+Threat]

// THE STRAY BOLT — the piece that survives and seeks its body
obj stray_bolt [+Symbolic]
stray_bolt [+Vital]

// EXT. ROCKWELL SKY - DAY — the sacrifice, the apparent death
set rockwell_sky [+Exterior] [+Day]

// EXT. ICELAND SNOWFIELD - DAWN — the coda, the reversal
set iceland [+Exterior] [+Dawn]

scene the_sacrifice {
  beat 1 {
    giant @ rockwell_sky
    warhead @ rockwell_sky
    giant >< warhead
        dialog(inject=[speaker=giant], inline="""
               speaker: "{speaker}"
               cue: "eyes closing as he climbs to meet the missile, choosing what he will be"
               tone: serene
               text: "Superman."
               """)
    // The death looks total — but it is secretly false: he is scattered, not ended.
    giant [+Dead]
    ?giant [+Deceptive]?
  }
  beat 2 {
    hogarth @ rockwell_sky
    hogarth -> grief : "Falls Into"
    !hogarth [#Grieving]!
    !audience [#Grieving]!
    audience -- grief
  }
}

scene the_coda {
  beat 1 {
    stray_bolt @ iceland
    evt reassembly [&Reveals(fact=alive)]
        dialog(kind=narration, inline="""
               cue: "a lone bolt, far from the wreckage, clicks and turns itself toward home"
               tone: quietly triumphant
               text: "Somewhere cold and bright, a small piece of him remembered which way was home."
               """)
    // Disney Death: the death was never real — a &Reveals lifts it. Not snatched away (Hope Spot),
    // not a fresh rescue of the doomed (Eucatastrophe): the loss itself is revoked.
    reassembly [+Resolved] [+TheReveal]
    giant [-Dead]
    giant [+Alive]
    audience [-Grieving]
    !giant [+Alive]!
    !audience [#Joyful]!
    audience -> grief : "Turns From"
    audience -> joy : "Turns To"
    audience -- joy
  }
}
