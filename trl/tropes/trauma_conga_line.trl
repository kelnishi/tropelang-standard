// === PREAMBLE ===
// @trope    Trauma Conga Line
// @category Tragedy / Audience Reactions
// @source   https://allthetropes.org/wiki/Trauma_Conga_Line
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): a character is subjected to an unbroken CHAIN of misfortunes — one
// blow after another, each landing before they can recover from the last — with NO respite and
// NO relief; the universe simply piles on, relentlessly, until the audience winces at the sheer
// accumulation. The trope IS the chain: not any one tragedy and not the breaking it may produce,
// but the relentless, unbroken SEQUENCE itself. It rides the SAME count(&Crushes) accumulation
// emotion_dynamics' Thread_Hope_To_Despair uses — but where Break the Cutie requires an INNOCENT
// target and pays off in a hollow husk, and Break the Haughty a proud one paying off in humility,
// the Conga Line is target-agnostic: ANY character will do, and the recognized payoff is the CHAIN
// being named (an unbroken run with no respite), whatever breaking it does or does not cause. The
// relentlessness — count high (>= 4-5) and crucially NOT BROKEN by relief — is the whole trope.


// === IMPORTS & ASSOCIATIONS ===
import "trl/modules/emotion_dynamics.trl"     // count(&Crushes) accumulation (Thread_Hope_To_Despair)
import "trl/tropes/break_the_cutie.trl"       // sibling: same engine, but innocent-targeted & pays off in a husk
import "trl/tropes/break_the_haughty.trl"     // sibling: same engine, proud-targeted, pays off in humility

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc trauma_conga_line -> [
  suffering        : "the unbroken chain of",
  despair          : "where the relentlessness tends, if unbroken",
  isolation        : "the pile-on leaves the target alone with",
  break_the_cutie  : "the innocent-targeted, husk-paying special case of",
  break_the_haughty: "the proud-targeted, humbling special case of",
  hope_spot        : "the respite the Conga Line withholds — its absence IS the trope"
]


// === ONTOLOGY ===
// The unbroken chain itself, and the beleaguered target the pile-on singles out.
imply TraumaCongaLine -> [Suffering, Relentless, Narrative]
imply CongaLineTarget -> [Beleaguered, LongSuffering]


// === ABSTRACT RULE ===
// ANY character (no innocence or pride precondition — the relentlessness is target-agnostic) hit by
// an unbroken chain of misfortunes: the count runs HIGH (>= 5, above the siblings' >= 3 breaking
// threshold — the Conga Line is recognized by sheer length, not by the single blow that breaks) AND
// no respite intervenes (no relief event has cleared the chain). What it RECOGNIZES is the chain
// itself — the target is named beleaguered, long-suffering, ground down by an unbroken pile-on —
// independent of whether the breaking (the siblings' payoff) follows.
rule TraumaCongaLine {
  when:
    char $c
    count( evt $blow [&Crushes(target=$c)] ) >= 5
    not ( evt $respite [&Relieves(target=$c)] )   // a single relief breaks the CHAIN — and the trope
    not ( $c [+Beleaguered] )
  then:
    $c [+Beleaguered] [+LongSuffering] [#Withdrawn]
    $c -- suffering
    $c -- isolation
}

// SUBVERSION — the chain is broken: a single genuine respite lands amid the blows, so the misery,
// however heavy, is NOT an unbroken Conga Line. The relief interrupts the sequence and the trope does
// not fire — the universe, for once, let up.
rule TraumaCongaLine_Broken {
  when:
    char $c
    count( evt $blow [&Crushes(target=$c)] ) >= 5
    evt  $respite [&Relieves(target=$c)]
  then:
    $c [+Beleaguered]
    $c -- relief
}


// === CONCRETE VIGNETTE: The Book of Job (Hebrew scripture, Wisdom literature) ===
// The archetypal pile-on. Job is blameless and prosperous; then, in a single day, messenger after
// messenger arrives — each before the last has finished speaking — and the universe strips him bare:
// the oxen and donkeys raided, the sheep burned, the camels taken, the servants put to the sword, and
// then his sons and daughters crushed when the house falls. He is not yet allowed to grieve before the
// next blow: his own body breaks out in boils from sole to crown, and his wife and friends turn the
// knife. Five, six, seven calamities with no breath between them — the chain unbroken, no respite — and
// Job sits in the ashes, beleaguered past any single tragedy, scraping himself with a potsherd.

// JOB — the blameless man the wager singles out
char job [+Protagonist] [+Innocent]
job [#Hopeful] [+Faithful]

// THE MESSENGERS — each arriving before the last has finished, "while he was yet speaking"
char messengers [+Herald]

// JOB'S WIFE — who counsels him to curse God and die; even kin turns the knife
char wife [+LoveInterest]

// EXT. THE ASH-HEAP - DAY — outside the city, where Job sits scraping his sores
set the_ash_heap [+Exterior] [+Day]

scene the_pile_on {
  beat 1 {
    job @ the_ash_heap
    evt the_raid       [&Crushes(target=job)]   // blow 1 — Sabeans take the oxen and donkeys, kill the servants
    evt the_fire       [&Crushes(target=job)]   // blow 2 — "fire of God" falls and burns up the sheep
        dialog(inject=[speaker=messengers], inline="""
               speaker: "{speaker}"
               cue: "the second runner arriving while the first still speaks — no pause to grieve"
               tone: breathless, ruinous
               text: "While he was yet speaking, there came also another, and said —"
               """)
  }
  beat 2 {
    evt the_raiders    [&Crushes(target=job)]   // blow 3 — Chaldeans carry off the camels, kill more servants
    evt the_house_fell [&Crushes(target=job)]   // blow 4 — the great wind; the house falls on all his children
  }
  beat 3 {
    evt the_boils      [&Crushes(target=job)]   // blow 5 — sore boils from the sole of his foot to his crown
    wife -- job : "Curse God and Die"           // even his wife turns the knife; no relief anywhere
    // the chain is unbroken — no &Relieves event has landed — and the count crosses the threshold
    // TraumaCongaLine fires: count(&Crushes target=job) >= 5, not(&Relieves target=job)
    job [+Beleaguered] [+LongSuffering] [#Withdrawn]
    job -- suffering
    job -- isolation
        dialog(inject=[speaker=job], inline="""
               speaker: "{speaker}"
               cue: "in the ashes, a potsherd in his hand, the blows still not finished"
               tone: hollowed, unbroken
               text: "Naked I came, and naked I shall return. Why did I not perish at birth?"
               """)
  }
}
