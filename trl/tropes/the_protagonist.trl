// === PREAMBLE ===
// @trope    The Protagonist
// @category Universal Tropes
// @source   https://allthetropes.org/wiki/The_Protagonist
// @version  1.3
// @domain    Narrative
// @uses     trl/concepts/narrative.trl — the `conflict` concept
//
// Laconic: the principal character — the story is about them, be they Hero, Villain
// Protagonist, or innocent bystander. The character the central arc centers on and whose
// choices drive its turning points. Builds on the prelude [+Protagonist] role.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc protagonist -> [
  conflict       : "drives",
  antagonist     : "opposed by",
  transformation : "often undergoes"
]


// === ONTOLOGY ===

imply Protagonist -> [Central, Sympathetic_Focus, Agent]


// === ABSTRACT RULE ===
// Heuristic recognition: the character at the centre of the most turning points of the
// central arc is its protagonist. (Centrality is ultimately authorial; agency is the
// structural signal we can see.)
rule TheProtagonist {
  when:
    arc  $story
    char $c
    count( evt $turn -> $c ) >= 3
  then:
    $c [+Protagonist]
    $c -- $story
    $c -- conflict
}


// === CONCRETE VIGNETTE: Breaking Bad — Walter White (TV; a villain protagonist) ===

// WALTER WHITE
char walter [+ChemistryTeacher]

// THE METH EMPIRE
arc the_empire

scene the_turn {
  beat 1 {
    walter -- the_empire
    evt cook   -> walter > the_empire : "Builds The Operation"
    evt expand -> walter @ the_empire : "Seizes Control"
    evt fall   -> walter @ the_empire : "Brings It All Down"
    walter [+Protagonist]
    // The story centers on him even as he turns monstrous — a villain protagonist.
    walter [+Villain_Protagonist]
  }
}
