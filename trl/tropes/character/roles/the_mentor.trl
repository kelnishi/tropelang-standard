// === PREAMBLE ===
// @trope    The Mentor
// @category Universal Tropes
// @source   https://allthetropes.org/wiki/Mentors
// @version  1.3
// @domain    Narrative
// @registry reuse   // title maps to an existing concept; no own registry entry
//
// Laconic: the wise, experienced figure who guides and trains a less-experienced
// protagonist. The connective detail is encoded below in CODE — `import` for the nodes it
// depends on, `assoc` for lateral thematic links, `imply` for hierarchy — not left in this
// note, so evaluators and embeddings can follow the actual connections.


// === IMPORTS — explicit dependencies on other nodes ===
import "trl/concepts/virtues.trl"      // wisdom
import "trl/concepts/universal.trl"    // legacy
import "trl/concepts/existential.trl"  // becoming, death


// === ASSOCIATIONS — lateral, optional, machine-followable (was buried in the laconic) ===
assoc mentor -> [
  wisdom   : "imparts",
  legacy   : "leaves behind",
  becoming : "catalyzes in the student",
  death    : "occupational hazard",
  hero     : "guides"
]


// === ONTOLOGY — hierarchy ===
imply Mentor -> [Ally, Authority, Wise]


// === ABSTRACT RULE ===
// A wise figure who TEACHES a protagonist is The Mentor; the bond is made reciprocal. The
// guidance rides an EVENT ([&Taught], the act of training) so the rule is recalled and phase-2
// coverage re-checks [+Wise] on the teacher and [+Protagonist] on the student (STYLE §8).
rule TheMentor {
  when:
    char $mentor [+Wise]
    char $student [+Protagonist]
    evt  $lesson [&Taught(agent=$mentor, to=$student)]
  then:
    $mentor  [+Mentor]
    $student [@Student_Of(mentor=$mentor)]
}


// === CONCRETE VIGNETTE: The Bhagavad Gita — Krishna and Arjuna (Hindu, the Mahabharata) ===
// On the eve of battle at Kurukshetra the warrior Arjuna falters: he cannot bring himself to fight kinsmen,
// teachers, and friends, and lays down his bow in despair. His charioteer is Krishna — the divine in human
// form — who across the length of the field instructs him in duty and detachment, action and the self, until
// Arjuna takes up the bow again, taught. The act of teaching is the discriminator.

// ARJUNA — the warrior who falters on the field and must be taught his way
char arjuna [+Protagonist] [+Untrained]

// KRISHNA — the divine charioteer whose counsel is the Gita itself
char krishna [+Wise] [+Divine]

scene the_field_of_kurukshetra {
  beat 1 {
    // Krishna instructs the despairing warrior in duty and the self — the act of teaching is the discriminator.
    evt the_counsel [&Taught(agent=krishna, to=arjuna)]
    // TheMentor derives: krishna [+Mentor], arjuna [@Student_Of(mentor=krishna)]
  }
}
