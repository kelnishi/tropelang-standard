// === PREAMBLE ===
// @trope    The Sidekick
// @category Relationships / Cast
// @source   https://allthetropes.org/wiki/Sidekick
// @version  1.3
// @domain    Interpersonal
//
// Laconic (per the wiki): the hero's loyal helper — a secondary character whose loyalty is an
// unselfish willingness to support the lead, gives the hero someone to explain the plot to, and
// often gets into trouble so the hero can rescue them. The support half of the central dyad
// (frequently also a Foil — pragmatic where the hero is hot-headed).

import "trl/concepts/index.trl"            // loyalty

assoc the_sidekick -> [
  loyalty : "the central virtue of",
  the_foil : "is very often also a"
]

imply Sidekick -> [loyalty, Support, Narrative]

// Naming rule: a loyal helper who AIDS the protagonist IS a Sidekick. The support rides an
// EVENT ([&Aided], the act of helping) so the rule is recalled and phase-2 coverage re-checks
// [+Loyal] on the helper and [+Protagonist] on the lead (STYLE §8). Loyalty is the positive
// discriminator the laconic names — what separates the Sidekick from a one-off helping hand.
rule The_Sidekick {
  when:
    char $h [+Protagonist]
    char $s [+Loyal]
    evt  $help [&Aided(agent=$s, other=$h)]
  then:
    $h [+Accompanied(by=$s)]
    $s [+Sidekick]
    $s -- loyalty
}

// === CONCRETE VIGNETTE: Shrek — Donkey (animated film, 2001) ===
// The ogre wants only to be left alone; the donkey will not be left, and his relentless, loyal,
// motor-mouthed company is what drags Shrek into the world — and into being a hero at all.
char shrek  [+Protagonist]
char donkey [+Deuteragonist] [+Loyal]

scene the_swamp_road {
  beat 1 {
    // Relentless, loyal company — the donkey will not be left; his help is the act that defines him.
    evt the_company [&Aided(agent=donkey, other=shrek)]
    // The_Sidekick derives: shrek [+Accompanied(by=donkey)], donkey [+Sidekick] -- loyalty
  }
}
