// === PREAMBLE ===
// @trope    The Hero
// @category Universal Tropes
// @source   https://allthetropes.org/wiki/The_Hero
// @version  1.3
// @domain    Narrative
// @registry reuse   // title maps to an existing concept; no own registry entry
// @uses     trl/concepts/narrative.trl — the `sacrifice` concept
//
// Laconic: the courageous central character who acts for something beyond themselves —
// the protagonist's most common form, but not its only one. Distinct from The Protagonist
// (a structural role); The Hero is a moral / archetypal one. Builds on the prelude
// [+Protagonist] and [+Courageous].


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc hero -> [
  courage     : "embodies",
  sacrifice   : "makes",
  mentor      : "guided by",
  protagonist : "is a kind of"
]


// === ONTOLOGY ===

imply Hero -> [Protagonist, Courageous, Aspirational]


// === ABSTRACT RULE ===
// A courageous protagonist who acts in sacrifice for another rises to The Hero. (Reuses
// the prelude Protagonist / Courageous roles and the Sacrificed_For verb; ties to the
// `sacrifice` concept.)
rule TheHero {
  when:
    char $c [+Protagonist] [+Courageous]
    evt  $deed [&Sacrificed_For(agent=$c, other=$beneficiary)]
  then:
    $c [+Hero]
    $c -- sacrifice
}


// === CONCRETE VIGNETTE: The Hungry Tigress Jataka — Prince Mahasattva (Buddhist, the Jatakamala) ===
// Walking in the forest, Prince Mahasattva — a former life of the Buddha — comes upon a tigress so starved
// she is about to devour her own newborn cubs. Moved by compassion, and finding no other food to give, he
// lays his own body down before her so that she may feed and the cubs may live. The supreme self-giving: a
// life laid down, for another's.

// PRINCE MAHASATTVA — a former life of the Buddha, who lays down his body out of compassion
char mahasattva [+Protagonist] [+Courageous]

// THE TIGRESS — starving, about to devour her own cubs but for his gift
char the_tigress [+Mortal]

// EXT. THE FOREST CLIFF (the famished tigress and her cubs, the prince's descent)
set the_forest_cliff [+Exterior]

scene the_gift_of_the_body {
  beat 1 {
    mahasattva @ the_forest_cliff
    the_tigress @ the_forest_cliff
    evt the_offering [&Sacrificed_For(agent=mahasattva, other=the_tigress)]
    the_offering -> mahasattva > the_tigress : "Lays Down His Body"
    mahasattva [+Hero]
    mahasattva -- sacrifice
  }
}
