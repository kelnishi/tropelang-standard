// === PREAMBLE ===
// @trope    The Big Bad
// @category Relationships / Cast
// @source   https://allthetropes.org/wiki/Big_Bad
// @version  1.3
// @domain    Interpersonal
//
// Laconic (per the wiki): the principal antagonist whose schemes drive the central conflict — the
// dark pole the hero is defined against. A relational role: the Big Bad and the hero are each
// other's nemesis, and the story's stakes are the gap between what each wants.

import "trl/concepts/index.trl"            // conflict

assoc the_big_bad -> [
  conflict     : "the dark pole of a",
  the_chosen_one : "hunts down a"
]

imply BigBad -> [Antagonist, Mastermind, Narrative]

// Naming rule: a MASTERMIND antagonist whose schemes menace the hero IS the Big Bad. The driving
// scheme rides an EVENT ([&Threatens], the menace that powers the central conflict) so the rule is
// recalled and phase-2 coverage re-checks [+Antagonist] [+Mastermind] on the villain and
// [+Protagonist] on the hero (STYLE §8). [+Mastermind] is the positive discriminator over a plain
// antagonist — the principal scheming foe, not merely an opposer.
rule The_Big_Bad {
  when:
    char $h [+Protagonist]
    char $v [+Antagonist] [+Mastermind]
    evt  $scheme [&Threatens(agent=$v, target=$h)]
  then:
    $v [+BigBad]
    $h [+Opposed_By(villain=$v)]
    $v -- conflict
}

// === CONCRETE VIGNETTE: Sherlock Holmes — Professor Moriarty (novel, 1893) ===
// The Napoleon of Crime, the spider at the centre of London's web — the one mind Holmes reckons
// his equal, and the only foe worth his own destruction at the Reichenbach Falls.
char holmes   [+Protagonist]
char moriarty [+Antagonist] [+Mastermind] [@Nemesis_Of(other=holmes)]

scene reichenbach {
  beat 1 {
    // The spider's web of schemes closes on the detective — the menace that drives the central conflict.
    evt the_web [&Threatens(agent=moriarty, target=holmes)]
    // The_Big_Bad derives: moriarty [+BigBad], holmes [+Opposed_By(villain=moriarty)]
  }
}
