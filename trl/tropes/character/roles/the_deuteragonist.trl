// === PREAMBLE ===
// @trope    The Deuteragonist
// @category Universal Tropes
// @source   https://allthetropes.org/wiki/Deuteragonist
// @version  1.3
// @domain    Narrative
// @registry reuse   // title maps to an existing concept; no own registry entry
//
// Laconic: the second character the story is about — a secondary main character, with or
// against the protagonist, more present than the supporting cast but not the centre. Not
// the Sidekick (who merely follows) and not the antagonist.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc deuteragonist -> [
  protagonist : "shadows",
  loyalty     : "often embodies",
  sacrifice   : "may make"
]


// === ONTOLOGY ===

imply Deuteragonist -> [Secondary_Focus, Central]


// === ABSTRACT RULE ===
// The second focus of the story, tied to the protagonist at their side. Defined POSITIVELY by
// [+Secondary_Focus] (the tag the siblings lack — the protagonist is Central/Sympathetic, the
// sidekick is loyalty/Support), not by a count of mentions or a pair of negations. The bond rides
// an EVENT ([&Allies_With], standing with the lead) so the rule is recalled and coverage re-checks
// [+Secondary_Focus] on the bound second (STYLE §8).
rule TheDeuteragonist {
  when:
    char $protagonist [+Protagonist]
    char $c [+Secondary_Focus]
    $c != $protagonist
    evt  $shared [&Allies_With(agent=$c, other=$protagonist)]
  then:
    $c [+Deuteragonist]
}


// === CONCRETE VIGNETTE: Sherlock Holmes — Dr. Watson beside Holmes (short stories) ===

// SHERLOCK HOLMES
char holmes [+Protagonist]

// DR. JOHN WATSON — the second the story is also about: joins the cases, chronicles them
char watson [+Secondary_Focus] [+Ally] [+Chronicler]

scene the_partnership {
  beat 1 {
    // Partners with Holmes — joins every investigation at his side.
    evt the_cases [&Allies_With(agent=watson, other=holmes)]
    // TheDeuteragonist derives: watson [+Deuteragonist]
  }
}
