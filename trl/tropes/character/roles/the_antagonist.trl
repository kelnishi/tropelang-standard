// === PREAMBLE ===
// @trope    The Antagonist
// @category Universal Tropes
// @source   https://allthetropes.org/wiki/The_Antagonist
// @version  1.3
// @domain    Narrative
// @registry reuse   // title maps to an existing concept; no own registry entry
//
// Laconic: the character whose role is to OPPOSE the protagonist — and who exists for that
// purpose. Need not be a villain, a Big Bad, or morally objectionable; opposition is the
// whole definition. Builds on the prelude [+Antagonist] role and the [~Opposes] verb.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc antagonist -> [
  protagonist : "opposes",
  conflict    : "embodies",
  corruption  : "often carries"
]


// === ONTOLOGY ===

imply Antagonist -> [Opposition, Obstacle]


// === ABSTRACT RULE ===
// The antagonist is defined RELATIONALLY: whoever opposes the protagonist. The opposition
// rides an EVENT ([&Opposes], the act of standing against them) so the rule is recalled and
// phase-2 coverage re-checks [+Protagonist] on the bound target (STYLE §8); the central
// conflict is the mutual-conflict edge between them.
rule TheAntagonist {
  when:
    char $protagonist [+Protagonist]
    char $c
    $c != $protagonist
    evt  $clash [&Opposes(agent=$c, other=$protagonist)]
  then:
    $c [+Antagonist]
    $c >< $protagonist
}


// === CONCRETE VIGNETTE: Les Misérables — Javert opposes Valjean (novel; antagonist, no villain) ===

// JEAN VALJEAN
char valjean [+Protagonist]

// INSPECTOR JAVERT
char javert [+Lawman] [+Righteous]

scene the_pursuit {
  beat 1 {
    // The lifelong pursuit is the act of opposition — lawful conviction, not malice.
    evt manhunt [&Opposes(agent=javert, other=valjean)]
    // TheAntagonist derives: javert [+Antagonist] >< valjean — an antagonist who is no villain.
  }
}
