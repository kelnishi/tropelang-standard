// === PREAMBLE ===
// @trope    Berserk Button
// @category Characterization Tropes / Triggers
// @source   https://allthetropes.org/wiki/Berserk_Button
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): an otherwise calm character has one specific topic or act that, when hit,
// instantly sends them into an extreme, often unstoppable rage. FRONTIER: the specific rage-trigger. The
// discriminator is a [+HairTrigger] character (one who carries a known instant-rage button) bound on the
// target of a [&Provokes] event — so it fires when that button is tripped and the holder goes [+Enraged],
// not on ordinary anger from any character. Distinct from a slow burn or a Villainous Breakdown: this is
// the instant, specific switch.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

assoc berserk_button -> [
  beware_the_nice_ones : "the trigger that proves",
  mama_bear            : "often a button over a"
]


// === ONTOLOGY ===
// — founded here (the specific instant-rage trigger is the discriminator; promotion model) —
prop HairTrigger    [+Psychological]   // carries a specific topic/act that trips instant rage
verb Provokes(target) [+Interpersonal] // trips another's specific rage trigger

imply BerserkButton -> [Psychological, Narrative]


// === ABSTRACT RULE ===
// Naming rule: a provoker PROVOKES a [+HairTrigger] character — the trigger-holder bound on the `target=`
// role of a [&Provokes] event (agent=$provoker), so phase-2 re-checks [+HairTrigger] on the bound holder
// (STYLE §8). Binding the specific-trigger trait on the provoked party is the discriminator: the button
// is hit and the holder goes [+Enraged], parting it from ordinary anger (no standing trigger) and a slow
// Villainous Breakdown.
rule Berserk_Button {
  when:
    char $c [+HairTrigger]
    evt  $trip [&Provokes(agent=$provoker, target=$c)]
  then:
    $c [+Enraged]
    $trip [+BerserkButton]
}


// === CONCRETE VIGNETTE: The Incredible Hulk — Bruce Banner (Marvel comics, 1962) ===
// Bruce Banner is mild, soft-spoken, a scientist who would rather walk away from any fight. But he warns
// everyone of the one rule, the single switch you must not flip: "Don't make me angry. You wouldn't like
// me when I'm angry." Provoke him past it and the calm man is gone — green, roaring, an unstoppable rage
// no one nearby survives unscathed. The button is anger itself, and pressing it is the worst mistake in
// the room.

// BRUCE BANNER — mild, until the one specific switch is flipped
char banner [+Protagonist] [+HairTrigger]

// THE PROVOKER — whoever pushes him past the line
char the_provoker [+Antagonist]

scene dont_make_me_angry {
  beat 1 {
    // the one switch is flipped — and the calm man is gone
    evt the_provocation [&Provokes(agent=the_provoker, target=banner)]
    // Berserk_Button -> banner [+Enraged]; the_provocation [+BerserkButton]
  }
}
