// === PREAMBLE ===
// @trope    Anti-Hero
// @category Cast / Character
// @source   https://allthetropes.org/wiki/Anti-Hero
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): the central character who lacks the conventional attributes of a hero —
// selfish, ruthless, cynical, or morally grey — yet remains the one we follow and root for.
// FRONTIER: model the grey by POSITIVE EVIDENCE, not by negation. The Anti-Hero is not "a protagonist
// who lacks [+Virtuous]" (closed-world absence fires on every unwritten protagonist, and morality has
// no scale to sit below). It is the CO-PRESENCE of two positives in tension — an allegiance we keep
// ([+Sympathetic_Focus]) AND un-heroic conduct we witness (an un-scrupulous character shown crossing a
// line). "Grey" is the conjunction, not a missing flag or a low score. Not a Villain Protagonist (whom
// we watch but do not root for) and not a Fall From Grace (a trajectory); the Anti-Hero is a stable
// cast position — un-heroic means, kept standing.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // virtues — the register the anti-hero compromises

assoc anti_hero -> [
  the_protagonist : "is a kind of",
  the_paragon     : "is the protagonist who is NOT a",
  the_hero        : "keeps the standing of, by un-heroic means",
  integrity       : "is rooted for despite compromising",
  fall_from_grace : "is a standing state, not the slope of"
]


// === ONTOLOGY ===
// The archetype subsumes: a protagonist's sympathetic focus, plus the morally-grey path and un-heroic
// conduct. The signature is the co-presence of allegiance and witnessed un-heroic action.
imply AntiHero -> [Protagonist, Sympathetic_Focus, Path_Ambiguous, Unheroic, Narrative]


// === ABSTRACT RULE ===
// POSITIVE evidence, no negation: a protagonist we root for ([+Sympathetic_Focus]) who is un-scrupulous
// ([+Unscrupulous] — a standing characterization, asserted, not assumed from a missing virtue) AND is
// SHOWN crossing a line (the deed — an [&Crosses] event, which also gives the trope a recognizable
// shape). The [+Unscrupulous] coverage is the discriminator: it separates the Anti-Hero from a clean
// protagonist who merely crosses a journey threshold, and it never fires on the unwritten — because the
// trait must be present, not merely un-negated.
rule Anti_Hero {
  when:
    char $c [+Protagonist] [+Sympathetic_Focus] [+Unscrupulous]
    evt  $e [&Crosses(agent=$c, threshold=$line)]
  then:
    $c [+Unheroic]
    $c [+Path_Ambiguous]
    $c [+AntiHero]
    $c -- integrity : "rooted for despite the means, not for any lack of virtue"
}


// === CONCRETE VIGNETTE: Breaking Bad — Walter White (TV, 2008–2013) ===
// A dying, broke, humiliated chemistry teacher cooks meth to leave his family money before the cancer
// takes him — and we follow the underdog, rooting for him. But the means curdle the man: he lies, he
// poisons a child to manipulate, he lets Jane choke, he kills. The line is crossed long before he
// admits the goal was never the family at all — "I did it for me. I liked it. I was good at it." Kept
// allegiance, un-heroic methods: the grey is the co-presence, not a missing virtue.

// WALTER WHITE (Heisenberg)
char walter [+Protagonist] [+Sympathetic_Focus]
walter [+Unscrupulous] [+Prideful]               // un-heroic conduct, asserted — the positive marker
walter [~Pursues(goal=provide_for_family)]        // the sympathetic claim that keeps us with him

// THE GOAL we are given to endorse, and THE LINE he crosses to serve it
concept provide_for_family
concept the_line [%Essence]                        // teacher → killer: the moral threshold, not a place

// JESSE — partner and, by turns, what the means consume
char jesse [+Partner] [+Victim]

// INT. THE SUPERLAB — NIGHT
set superlab [+Interior] [+Night] [+Hidden]

scene the_crossing {
  beat 1 {
    walter @ superlab
    walter -- jesse : "Partners, after a fashion"
  }
  beat 2 {
    evt the_rubicon [&Crosses(agent=walter, threshold=the_line)]
    // Anti_Hero -> walter [+Unheroic] [+Path_Ambiguous] [+AntiHero] -- integrity (DERIVED, not asserted)
  }
}
