// === PREAMBLE ===
// @trope    Redemption Quest
// @category Character Development / Redemption
// @source   https://allthetropes.org/wiki/Redemption_Quest
// @domain   Narrative
// @scale    arc
// @version  1.3
//
// Laconic (per the wiki): a character who has fallen — a Fallen Hero, an Anti-Villain, a repentant Villain
// Protagonist — is granted one final chance to do better, usually a grand, nearly impossible task by which
// they may atone. FRONTIER: redemption as an undertaken quest. The discriminator is a [+Penitent] character
// bound on the agent of a [&Quests] event (reused from The Quest) whose `for=` object is the [+Redemptive]
// task offered to them — a refinement of The Quest with redemption stakes. Distinct from a Redemption Arc
// (the gradual inward turn) by the explicit assigned quest, and from a plain Quest by the atonement at stake.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"
import "trl/tropes/arc/redemption/redemption_arc.trl"   // the gradual inward turn this externalizes as a task
import "trl/tropes/structure/the_quest.trl"             // reuses [&Quests(for)] — this IS The Quest, with redemption stakes

assoc redemption_quest -> [
  redemption_arc : "the assigned-task form of",
  the_quest : "a redemption-stakes form of",
  heel_face_turn : "the deed that follows a"
]


// === ONTOLOGY ===
// — founded here (the penitent setting out on the offered task is the discriminator; reuses [&Quests] from
//   The Quest — a Redemption Quest IS a quest, with redemption stakes) —
prop Penitent   [+Narrative]        // one with a stain to wipe clean — fallen, and seeking to atone
prop Redemptive [+Narrative]        // (of a task) the grand chance offered to earn redemption

imply RedemptionQuest -> [Transformation, Narrative]


// === ABSTRACT RULE ===
// Naming rule (arc scale): a [+Penitent] character QUESTS for a [+Redemptive] task — the seeker bound on the
// agent and the offered task on the `for=` role of a [&Quests] event (reused from The Quest), so phase-2
// re-checks [+Penitent] on the seeker and [+Redemptive] on the task (STYLE §8). It REFINES The Quest: the
// redemption tags ([+Penitent] seeker, [+Redemptive] task) specialize the same [&Quests] journey — parting it
// from a plain Quest ([+Protagonist] for an [+Objective], no redemption at stake) and from a Redemption Arc
// (the gradual inward turn, no assigned task).
rule Redemption_Quest {
  when:
    char $seeker [+Penitent]
    obj  $task [+Redemptive]
    evt  $quest [&Quests(agent=$seeker, for=$task)]
  then:
    $quest [+RedemptionQuest]
}


// === CONCRETE VIGNETTE: Red Dead Redemption — John Marston (game, 2010) ===
// John Marston was an outlaw; now the government holds his wife and son and gives him one way to buy them —
// and himself — back: hunt down and bring in the members of his own old gang, the men he rode and killed
// with. It is a grand, bloody, nearly impossible task, and it is laid on him explicitly as the price of his
// redemption. He takes it. The title says the shape of it outright: a redemption, made into a quest.

// JOHN MARSTON — the former outlaw given one last task to atone and win his family back
char john [+Penitent] [+Protagonist]

// THE HUNT FOR THE GANG — the grand, near-impossible task offered as his path to redemption
obj the_hunt [+Redemptive]

// EXT. THE WESTERN FRONTIER - the long road after his old gang
set the_frontier [+Exterior]

scene the_bargain {
  beat 1 {
    john @ the_frontier
    // he takes on the offered task — hunt down his own old gang — as the price of redemption
    evt the_undertaking [&Quests(agent=john, for=the_hunt)]
    // Redemption_Quest -> the_undertaking [+RedemptionQuest]
  }
}
