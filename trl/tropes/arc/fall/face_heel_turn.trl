// === PREAMBLE ===
// @trope    Face Heel Turn
// @category Character Development / Alignment
// @source   https://allthetropes.org/wiki/Face_Heel_Turn
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): a "face" (a good guy) is tempted by the dark side — or just gets fed
// up — and becomes a "heel" (a bad guy). The wrestling terms for a hero's deliberate crossing to
// villainy. FRONTIER: the direct moral INVERSE of Heel Face Turn, and the MOMENT (not the slope)
// of a fall. It rides the same emotion-dynamics appraisal layer the heroic mirror does, but the
// catalyst flows the other way: a precipitating WOUND or TEMPTATION (a betrayal suffered, an
// attack on what one loves) curdles into the resentment that flips a trusted, heroic figure across
// the line. Heel Face Turn pays a debt and is redeemed; this one INCURS the debt — the alignment
// flips toward betrayal, not redemption. Fall From Grace names the slope this moment stands on.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"               // betrayal, corruption, loyalty, revenge, redemption
import "trl/modules/emotion_dynamics.trl"     // the appraisal that produces the catalyst feeling

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc face_heel_turn -> [
  heel_face_turn  : "moral inverse of",
  fall_from_grace : "is the moment whose slope is",
  corruption      : "crosses into",
  betrayal        : "ends in",
  loyalty         : "forsakes",
  revenge         : "often catalyzed by"
]


// === ONTOLOGY ===
// The crossing is itself a Reversal — the mirror of the redemptive one, bending toward Corruption.
imply FaceHeelTurn -> [Reversal, corruption, Narrative]


// === ABSTRACT RULE ===
// A trusted, heroic figure, wounded into resentment by a betrayal or an attack on what he loves
// (the catalyst feeling the emotion module appraises), acts on it: he FORSAKES the cause and
// crosses the line, the alignment flipping from hero to villain — the debt incurred, not paid.
// (Mirror of Heel Face Turn, where guilt -> defection -> redemption. Here resentment -> forsaking
// -> betrayal.) The wound is the trigger; the crossing is the deed.
rule FaceHeelTurn {
  when:
    char $c [+Protagonist] [#Resentful]
    evt  $turn [&Forsakes(agent=$c)]
    not ( $c [+Antagonist] )
  then:
    $c [-Protagonist]
    $c [+Antagonist]
    $c -- corruption
    $c -- betrayal
}


// === CONCRETE VIGNETTE: The Godfather — Michael Corleone (film, 1972) ===
// The decorated war hero who tells Kay "that's my family, Kay, it's not me." Then Sollozzo's men
// gun his father down in the street and the police captain breaks his jaw. The wound turns; the
// boy who would have nothing to do with the family business volunteers to kill Sollozzo and
// McCluskey at Louis' Restaurant — and never crosses back. By the baptism he has become the Don.
// The vignette asserts only the cause (the wound -> resentment, the forsaking deed) and lets the
// engine DERIVE the crossing.

// MICHAEL CORLEONE — the youngest son, the war hero who stood outside the family's violence
char michael [+Protagonist]

// VITO CORLEONE — the father; the attempt on his life is the wound that turns Michael
char vito [+Mentor]

// CAPTAIN McCLUSKEY — the corrupt cop whose blow seals Michael's crossing
char mccluskey [+Antagonist]

// INT. LOUIS' RESTAURANT — NIGHT — the gun taped behind the cistern; the point of no return
set louis_restaurant [+Interior] [+Night]

scene the_crossing {
  beat 1 {
    michael @ louis_restaurant
    mccluskey @ louis_restaurant
    evt the_shooting [&Betrayed(agent=mccluskey, target=vito)]   // the attack on what he loves
    michael [~Attached_To(target=vito)]
    michael [#Resentful]                 // the wound curdles — Appraise_Betrayal's blame, turned hard
  }
  beat 2 {
    evt the_hit [&Forsakes(agent=michael)]   // he takes up the gun he swore he never would
    michael > mccluskey : "Kills"
    // FaceHeelTurn -> michael [-Protagonist] [+Antagonist] -- corruption -- betrayal
    // (NOT hand-asserted: the rule derives the crossing from the wound + the forsaking deed)
  }
}
