// === PREAMBLE ===
// @trope    The Dog Bites Back
// @category Character Tropes / Revenge
// @source   https://allthetropes.org/wiki/The_Dog_Bites_Back
// @domain   Interpersonal
// @version  1.3
//
// Laconic (per the wiki): a long-abused, downtrodden character — a kicked subordinate, a
// despised servant, a minion held only by fear — is pushed past endurance and finally turns
// on the very tormentor who ground them down. The worm turns; "even a dog gets tired of being
// kicked." The signature is an IDENTITY closure: the hand that retaliates strikes the SAME hand
// that abused it (agent of the cruelty == target of the strike), and the dog is a powerless
// inferior, not a rival. FRONTIER: the OUTWARD release of accumulated abuse. Break the Cutie
// takes the identical count of &Crushes and turns it INWARD — the innocent collapses, [+Broken],
// [#Withdrawn]. Here the same accumulation turns OUTWARD, into a strike at the abuser. Distinct
// from a Klingon Promotion / Coup: the dog does NOT seize the master's power — it bites, then is
// done; the motive is a crime of opportunity, not ambition.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"               // suffering, injustice, revenge, dignity, wrath
import "trl/modules/emotion_dynamics.trl"     // accumulated &Crushes — the abuse that hardens toward the turn
import "trl/modules/action_dynamics.trl"      // Strikes — what the bite cashes out as, turned on the master
import "trl/tropes/death/revenge.trl"               // the named vengeance pattern this is the powerless-subordinate case of
import "trl/tropes/arc/fall/break_the_cutie.trl"       // the INWARD twin: the same accumulation, collapsing instead of striking

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc the_dog_bites_back -> [
  suffering       : "the accumulated ground that drives it",
  injustice       : "answers a long",
  revenge         : "the powerless-subordinate variant of",
  dignity         : "the last of it, reclaimed in the strike",
  wrath           : "the held-down fury finally released",
  break_the_cutie : "the inward-collapsing twin of the same accumulated abuse",
  emotion_dynamics : "rides the accumulated-blows count of"
]


// === ONTOLOGY ===
// The downtrodden worm, and the turn when it finally bites.
imply TheDogBitesBack -> [Retribution, Reversal, Narrative]


// === ABSTRACT RULE ===
// A powerless inferior ([+Subject]), abused again and again by a master — the COUNT is the trope,
// the same >= 3 accumulation threshold emotion_dynamics' Thread_Hope_To_Despair / Break the Cutie
// use — finally strikes the very abuser. The identity closure is the signature: the agent of the
// crushing IS the target of the strike ($master both crushes and is struck). It is NOT the inward
// collapse (the dog must not be [+Broken]) and NOT a power grab (the dog stays the inferior; it
// takes nothing). The turn reverses the relation: the master is [+Hit] and the dog [+Defiant],
// its dignity reclaimed in the one blow.
rule TheDogBitesBack {
  when:
    char $dog    [+Subject]
    char $master [+Authority]
    count( evt $abuse [&Crushes(agent=$master, target=$dog)] ) >= 3
    evt  $turn [&Strikes(agent=$dog, target=$master)]
    not ( $dog [+Broken] )                 // the inward path (Break the Cutie) is the other branch
    $dog != $master
  then:
    $master [+Hit]
    $dog [+Defiant]
    $dog -- dignity
    $turn [+TheDogBitesBack]
}


// === CONCRETE VIGNETTE: Carrie — the prom (Stephen King, horror novel/film, 1974) ===
// Carrie White is the cast-out girl: tormented at school, ground down at home by a fanatic mother,
// the designated victim of every cruelty her classmates can invent. Blow on blow lands on the most
// powerless person in the room — the locker-room jeering, the years of being the joke, and at last
// the bucket of pig's blood tipped over her at the crowning of the prom queen. That last humiliation
// is one kick too many: the downtrodden girl turns her telekinesis on the very crowd that kicked her,
// and the hall burns. She does not seize anything, does not rule — she bites, once, and it consumes
// her tormentors and herself. The worm turned.

// CARRIE WHITE — the despised, powerless girl; the dog that finally bites
char carrie [+Protagonist] [+Subject]
carrie [+Outcast]

// THE PROM CROWD / CHRIS HARGENSEN — the tormentors who held her down by ridicule
char crowd [+Antagonist] [+Authority] [+Collective]

// INT. EWEN HIGH GYMNASIUM — PROM NIGHT — the bright hall that becomes her reckoning
set gymnasium [+Interior] [+Night] [+Crowded]

scene the_prom {
  beat 1 {
    carrie @ gymnasium
    crowd @ gymnasium
    evt the_locker_room [&Crushes(agent=crowd, target=carrie)]
    // blow 1 — the shower-room jeering: the first cruelty in a long ledger
  }
  beat 2 {
    evt the_years_of_jokes [&Crushes(agent=crowd, target=carrie)]
    carrie -- suffering : "The Designated Victim"
    // blow 2 — years of being everyone's joke; the abuse accumulates
  }
  beat 3 {
    evt the_pigs_blood [&Crushes(agent=crowd, target=carrie)]
    // blow 3 — the bucket tipped at her crowning; the count crosses the threshold (>= 3)
  }
  beat 4 {
    evt the_burning [&Strikes(agent=carrie, target=crowd)]
        dialog(inject=[speaker=carrie], inline="""
               speaker: "{speaker}"
               cue: "drenched and shaking at the center of the laughing hall, something in her going still and cold"
               tone: quiet, terrible
               text: "They're all going to laugh at you. Not anymore."
               """)
    // TheDogBitesBack fires: count(&Crushes agent=crowd target=carrie) >= 3, and the abused
    // turns the strike on the very crowd that abused her —
    crowd [+Hit]
    carrie [+Defiant]
    carrie -- dignity
    the_burning [+TheDogBitesBack]
  }
}
