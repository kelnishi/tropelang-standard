// === PREAMBLE ===
// @trope    The Siege
// @category Military and Warfare Tropes
// @source   https://allthetropes.org/wiki/The_Siege
// @domain   Interpersonal
// @version  1.3
//
// Laconic (per the wiki): an army surrounds and invests a fortified position, cutting it off to
// force surrender by starvation, assault, or attrition — the garrison holds the walls while
// supplies and hope dwindle. The protracted ENCIRCLEMENT-AND-ATTRITION is the trope: the besieger
// Bars the holder from the outside world (the investment that cuts off supply) while the holder
// Holds the walls, and the besieged's needs FALL over time (food, then safety) until the line
// breaks one of three ways — breach, relief, or surrender. Rides action_dynamics (the Bars/Holds
// tactics, event-level) and needs (the besieged's dwindling supply/safety, the lower rungs going
// unmet). Distinct from a single Last Stand or one assault: a Last Stand is a bare hold that buys
// time; The Siege is the slow grind of being cut off, where attrition — not one charge — is the
// weapon.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // conflict, surrender
import "trl/modules/action_dynamics.trl"   // Bars (the investment) / Holds (the walls)
import "trl/modules/needs.trl"             // [#Lacks] — supply and safety dwindling on the besieged

assoc the_siege -> [
  action_dynamics : "the Bars + Holds tactics of",
  needs           : "starves the lower rungs of the besieged via",
  last_stand      : "the protracted attrition behind a",
  the_cavalry     : "is broken by relief, the",
  surrender       : "forces, by attrition, a"
]


// === ONTOLOGY ===

imply TheSiege -> [Investment, Attrition, Tactic, Narrative]


// === ABSTRACT RULE ===
// Naming rule: a besieger who BARS a holder off (the investment that cuts supply) while that holder
// HOLDS the walls AND is bleeding a basic need (attrition has started biting) IS The Siege — so
// long as relief has not yet reached them. The [#Lacks] clause is the distinguisher from a bare
// Last Stand: here the besieged is being ground down by being cut off, not just overwhelmed in one
// rush. The chokepoint geography and the three exits (breach / relief / surrender) live in the
// vignette; relief, if it comes, fires action_dynamics' own Reinforcement (see The Cavalry).
rule The_Siege {
  when:
    evt  $invest [&Bars(agent=$besieger, against=$holder)]
    evt  $hold   [&Holds(agent=$holder, against=$besieger)]
    char $holder [#Lacks]
    not ( $holder [+Relieved] )
  then:
    $invest [+TheSiege]
    $holder [+Besieged]
    $besieger -- $holder : "Invests"
}


// === CONCRETE VIGNETTE: the Siege of Masada (military history, 73–74 CE) ===
// After Jerusalem fell, the last Sicarii rebels held the desert fortress of Masada atop its sheer
// rock. The Tenth Legion ringed the plateau with a circumvallation wall and camps, sealing the
// defenders off from the world, then spent months raising a great earthen ramp against the western
// face. Cut off, the garrison's supplies and hope drained as the ramp crept up; when the breach
// finally came the rebels chose mass suicide over surrender — the siege's third exit, refused.

// THE SICARII GARRISON ATOP THE ROCK
char eleazar  [+Protagonist] [+Collective]   // Eleazar ben Ya'ir and the Sicarii defenders
// THE TENTH LEGION (FRETENSIS) RINGING THE PLATEAU
char silva    [+Antagonist] [+Collective]    // Flavius Silva and the Roman host
// EXT. THE FORTRESS OF MASADA — THE DESERT ROCK — DAY
set  masada   [+Exterior] [+Day] [+Fortified]

scene the_rock {
  beat 1 {
    eleazar @ masada
    evt circumvallation [&Bars(agent=silva, against=eleazar)]   // the ring-wall: the investment, cutting them off
    evt hold [&Holds(agent=eleazar, against=silva)]
    eleazar [#Lacks(rank=1, salience=4)]                         // food and water, draining on the rock
    // The_Siege -> circumvallation [+TheSiege];  eleazar [+Besieged];  silva -- eleazar : "Invests"
  }
  beat 2 {
    eleazar [#Lacks(rank=2, salience=7)]                         // the ramp crests; safety itself now fails — attrition bites
  }
  beat 3 {
    evt the_ramp [&Strikes(agent=silva, target=eleazar)]        // the breach: assault, the first exit
    // not relieved, not surrendered — the third exit (surrender) is refused
  }
}
