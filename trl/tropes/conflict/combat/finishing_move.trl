// === PREAMBLE ===
// @trope    Finishing Move (Combination Finisher)
// @category Combat / Action
// @source   https://allthetropes.org/wiki/Finishing_Move
// @version  1.3
// @domain    Interpersonal
// @registry reuse   // title maps to an existing concept; no own registry entry
//
// Laconic: a character's signature, decisive technique — deployed to END a fight, and often
// SET UP by an ally who first pins or exposes the target (a combination attack). Rides the
// action-dynamics Assist_Pin → Finisher chain: cooperation opens the foe, the finisher closes.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // conflict
import "trl/modules/action_dynamics.trl"   // Assist_Pin -> [+Exposed] -> Finisher

assoc finishing_move -> [
  action_dynamics : "the Finisher rule of",
  conflict        : "ends a"
]


// === ONTOLOGY ===

imply FinishingMove -> [Decisive, Technique, Narrative]


// === ABSTRACT RULE ===
// Naming rule: the COMBINATION finisher — a teammate's setup ([&Pins], opening the foe to [+Exposed])
// lets a second hand land the finisher. The setup is the discriminator: it scopes the trope to the
// two-man combo (this file's title and laconic), so a SOLO kill of a foe weakened by its own weak
// point (David Versus Goliath, Achilles' Heel, Combat Pragmatist) no longer trips this — those have a
// finisher on an exposed foe but no allied setup. (Setup agent distinct from the finisher.)
rule Finishing_Move {
  when:
    char $y [+Exposed]
    char $ally
    char $x
    $ally != $x
    evt  $setup [&Pins(agent=$ally, target=$y)]
    evt  $f     [&Finishes(agent=$x, target=$y)]
  then:
    $f [+FinishingMove]
}


// === CONCRETE VIGNETTE: Naruto — Rasenshuriken vs. Hidan (anime / manga) ===
// A two-man combination: Shikamaru's Shadow Possession holds the immortal Hidan in place
// (the setup), so Naruto's Wind-Style finisher can land (the close).

char naruto    [+Protagonist]
char shikamaru [+Ally]
char hidan     [+Antagonist] [+Immortal]   // can't be killed by ordinary means — needs the combo

scene the_combination {
  beat 1 {
    evt shadow_bind [&Pins(agent=shikamaru, target=hidan)]
    hidan [+Exposed]   // the setup holds him open — stated literally so coverage re-checks it (Assist_Pin also derives it)
  }
  beat 2 {
    evt rasenshuriken [&Finishes(agent=naruto, target=hidan)]
    // Finisher -> hidan [+Defeated];  Finishing_Move tags the technique
  }
}
