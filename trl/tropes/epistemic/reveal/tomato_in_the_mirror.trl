// === PREAMBLE ===
// @trope    Tomato in the Mirror
// @category Epistemic / Narrative Devices
// @source   https://allthetropes.org/wiki/Tomato_in_the_Mirror
// @domain   Mind
// @version  1.3
//
// Laconic (per the wiki): a Twist Ending where the PROTAGONIST themselves discovers they are not
// what they believed — a robot, a ghost, a clone, the villain, an impostor: "it is not the world
// which is wrong, but you." It is the self-directed variant of Tomato Surprise: there the AUDIENCE
// is blindsided about a character; here the blindsiding lands on the CHARACTER, about their OWN
// nature. The signature is reflexive recognition — the discoverer IS the subject discovered. The
// hero holds a self-belief ($cover) about what they are; that self-model is [#Mistaken]; a
// revelatory event surfaces the true nature ($truth) to the very mind that held the false one, and
// the character comes to [#Knows] themselves. FRONTIER: rides theory_of_mind to model a self-model
// being overturned from the inside — anagnorisis turned on the self, not on another.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // self, identity, recognition, revelation
import "trl/modules/theory_of_mind.trl"    // Believes / Reveals / Mistaken / Knows — the self-model machinery

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc tomato_in_the_mirror -> [
  self            : "overturns the protagonist's model of their own",
  recognition     : "is anagnorisis turned reflexive — the hero finally sees their own",
  revelation      : "delivers its overturning through a self-directed",
  theory_of_mind  : "folds the false belief inward — the deceived and the subject are one, modeled in",
  tomato_surprise : "is the self-aware sibling of (there the audience is blindsided, here the hero)",
  the_reveal      : "is the reveal whose audience is the very subject revealed"
]


// === ONTOLOGY ===

imply TomatoInTheMirror -> [Reflexive_Recognition, Twist, Narrative]


// === ABSTRACT RULE ===
// Recognition: the protagonist $self holds a belief about their OWN nature ($cover) that DIVERGES
// from the truth — their self-model is [#Mistaken] about themselves. A revelatory event surfaces the
// true nature ($truth) to that same mind. Because the discoverer is the subject, the false self-model
// collapses: the hero stops believing the cover, the cover and truth are marked contraries, and the
// character comes to KNOW themselves. This reflexive close (the deceived == the subject) is what
// separates Tomato in the Mirror from Tomato Surprise (audience-only) and Plot Twist (audience belief).
rule Tomato_In_The_Mirror {
  when:
    char $self [+Protagonist] [#Believes(claim=$cover)] [#Mistaken(subject=$self)]
    evt  $mirror [&Reveals(fact=$truth)]
    $cover != $truth
  then:
    $self [-Believes(claim=$cover)]
    $self [#Knows(target=$self)]
    $cover >< $truth
    !$self [+Revealed(truth=$truth)]!
    $mirror -- recognition : "Is"
    !$mirror [+TomatoInTheMirror]!
    surface(target=$self, message="You are not what you believed yourself to be.")
}


// === CONCRETE VIGNETTE: Oedipus Rex — the king investigates the plague and finds himself (play, c. 429 BCE) ===
// Oedipus, who believes himself the rightful saviour-king of Thebes and a stranger to its old crimes,
// hunts the murderer of Laius to lift the plague. The shepherd's testimony surfaces the truth to the
// very man pursuing it: HE is Laius's killer and son — the polluter he has sworn to exile. The
// recognition lands on the investigator himself; the discoverer is the discovered.

// OEDIPUS, KING OF THEBES
char oedipus [+Protagonist]
oedipus [#Believes(claim=righteous_outsider)]      // his self-model: saviour-king, no kin to the crime
?oedipus [#Mistaken(subject=oedipus)]?             // true from before the play opened — unsurfaced to him

// THE SHEPHERD OF KITHAIRON
char shepherd [+Witness_To(event=the_exposure)]

// INT. THE PALACE OF THEBES — DAY
set palace [+Interior] [+Day]

scene the_investigation {
  beat 1 {
    oedipus @ palace
    shepherd @ palace
    // The self-model he has acted on all play — surfaced to him, taken as true.
    oedipus [#Believes(claim=righteous_outsider)]
    // Latent before this scene: the man hunting the polluter is the polluter.
    !oedipus [#Mistaken(subject=oedipus)]!
  }
  beat 2 {
    evt the_testimony [&Reveals(fact=he_is_the_son_and_slayer)]
        dialog(inject=[speaker=shepherd], inline="""
               speaker: "{speaker}"
               cue: "wrung from him under threat, the last thread of the riddle"
               tone: dread
               text: "The child was Laius's own. And they said — you were the one to kill him."
               """)
    // The cover (righteous outsider) and the truth (son-and-slayer) are contraries; the self-model inverts.
    righteous_outsider >< he_is_the_son_and_slayer
    // Tomato_In_The_Mirror fires here, deriving oedipus [-Believes] [#Knows(self)]
    // !+Revealed! and !the_testimony [+TomatoInTheMirror]! (the rule's payoff, not asserted).
  }
}
