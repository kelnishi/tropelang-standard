// === PREAMBLE ===
// @trope    The Mole
// @category Spy Fiction / Betrayal
// @source   https://allthetropes.org/wiki/The_Mole
// @domain   Mind
// @version  1.3
//
// Laconic (per the wiki): a trusted member of a group is secretly an agent of the enemy, feeding
// information out and sabotage in; the treachery stays hidden until it springs. FRONTIER: this rides
// theory_of_mind (the group MODELS the mole as one of their own and does not KNOW his true
// allegiance) and the_reveal (concealment, then exposure). The signature is a LATENT allegiance: the
// mole is [+Trusted] inside the group while [@LoyalTo] the enemy the whole time — that loyalty lives
// in the ?…? latent epistemic tier (in the graph, surfaced to no one) and only collapses to known
// when the betrayal fires.
//
// DISTINCT FROM a Face-Heel Turn: a turncoat was GENUINELY loyal and then switched ([&Defects], a
// real prior [+Ally]). The Mole never switched — he was the enemy's from before the first scene. No
// defection event; the allegiance was latent, not reversed. That is the discriminator below.


// === IMPORTS & ASSOCIATIONS ===
import "trl/modules/theory_of_mind.trl"    // the group MODELS the mole; the true allegiance is un-Known
import "trl/tropes/epistemic/reveal/the_reveal.trl"         // concealment (cover trusted) then exposure (betrayal springs)

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc the_mole -> [
  theory_of_mind   : "the group's false model of (trusts the mind set against them)",
  revelation       : "the betrayal is the exposure of a",
  deception        : "a sustained one — the cover is a lived lie",
  face_heel_turn   : "NOT — the turncoat was once loyal; the mole never was",
  smear_campaign   : "may be sabotaged FROM inside by"
]


// === ONTOLOGY ===
// The mole is a betrayer who is also an infiltrator: trusted cover over a latent, opposed allegiance.
imply TheMole -> [Infiltrator, Betrayer, Deceptive, Concealment, Narrative]


// === ABSTRACT RULES ===

// CONCEALMENT (the cover) — a member is taken into a group and trusted as one of their own, while
// his real allegiance runs to the enemy faction. The group's trust is the false model
// (theory_of_mind); the allegiance to the enemy is LATENT (?…?) — present in the graph, surfaced to
// no one. No betrayal has fired yet.
rule TheMole_Latent {
  when:
    char $mole [+Trusted] [@Member_Of(group=$group)]
    char $insider [@Member_Of(group=$group)]
    char $enemy [+Faction]
    $insider -- $mole : "Trusts"
    $group >< $enemy
    not ( $insider [#Knows(target=$mole)] )
    $insider != $mole
  then:
    $insider [+Perceives(target=$mole, as=loyal_insider)]
    ?$mole [@LoyalTo(faction=$enemy)]?       // latent: the true allegiance, in the graph, known to none
    ?$mole [+Deceptive]?
}

// THE BETRAYAL (it springs) — the mole, latently loyal to the enemy, acts on it: he betrays an
// insider who trusted him. The cover collapses; the trusting insider now KNOWS him; the once-latent
// allegiance surfaces to absolute truth. This is the_reveal turned against the group from within.
rule TheMole_Springs {
  when:
    char $mole [+Trusted] [@LoyalTo(faction=$enemy)]
    char $insider [+Perceives(target=$mole, as=loyal_insider)]
    evt  $strike [&Betrays(agent=$mole, target=$insider)]
  then:
    $insider [-Perceives(target=$mole, as=loyal_insider)]
    $insider [#Knows(target=$mole)]
    $mole [-Trusted]
    !$mole [+Revealed(truth=enemy_agent)]!   // the treachery is now ground truth, no longer latent
    $strike [+TheMole]
    surface_global(title="The Mole", description="The trusted one was the enemy's all along.")
}

// DISCRIMINATOR — a Face-Heel Turn is NOT a mole. A turncoat held a GENUINE prior allegiance ([+Ally],
// [@LoyalTo] his OWN group) and then DEFECTS ([&Defects]) — a reversal. The mole never reversed: there
// is no defection event and no genuine prior loyalty to switch. This rule fires only on the turncoat,
// keeping the two apart.
rule FaceHeelTurn_NotAMole {
  when:
    char $c [+Ally] [@LoyalTo(faction=$own)]
    evt  $turn [&Defects(agent=$c)]
  then:
    $c [+Genuine_Turncoat]                    // a real switch — categorically not The Mole
}


// === CONCRETE VIGNETTE: The Departed — Colin Sullivan inside the State Police (film, 2006) ===
// Raised and groomed by mob boss Frank Costello, Colin Sullivan rises through the Massachusetts State
// Police as a model officer — trusted, decorated, even running the unit hunting Costello. The squad
// models him as one of their own; nobody knows he has been Costello's man the whole time. His loyalty
// to the mob is latent, lived under a perfect cover — until he tips Costello off and the wire he is
// supposed to be tracing leads back to himself.

// SGT. COLIN SULLIVAN — Costello's man, in the uniform of the State Police
char sullivan [+Trusted]
sullivan [@Member_Of(group=state_police)]
sullivan [+MotivatedBy(reason="Bought_Young")]

// CAPT. QUEENAN — the honest officer who trusts and runs the unit
char queenan [+Protagonist]
queenan [@Member_Of(group=state_police)]

// FRANK COSTELLO — the South Boston crime boss; the enemy the unit is built to catch
char costello [+Antagonist] [+Faction]

// THE SPECIAL INVESTIGATIONS UNIT — the group, set against the Costello crew
char state_police [+Faction]

scene the_cover {
  beat 1 {
    queenan -- sullivan : "Trusts"           // the captain takes him for a model officer
    state_police >< costello                 // the unit exists to bring Costello down
    // TheMole_Latent -> queenan [+Perceives(sullivan, as=loyal_insider)];
    //   ?sullivan [@LoyalTo(faction=costello)]?  ?sullivan [+Deceptive]?  (loyalty latent, known to none)
  }
}

scene it_springs {
  beat 1 {
    evt the_tipoff [&Betrays(agent=sullivan, target=queenan)]   // Sullivan warns Costello; the unit is sold out
        dialog(inject=[speaker=sullivan], inline="""
               speaker: "{speaker}"
               cue: "low, fast, into a phone the squad does not know he carries"
               tone: cold
               text: "They've got a guy inside. You're being watched."
               """)
    // TheMole_Springs -> queenan [-Perceives…]; queenan [#Knows(sullivan)]; sullivan [-Trusted];
    //   !sullivan [+Revealed(truth=enemy_agent)]!; the_tipoff [+TheMole]; surface "The Mole"
  }
}
