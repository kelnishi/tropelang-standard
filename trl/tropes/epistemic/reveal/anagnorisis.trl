// === PREAMBLE ===
// @trope    Anagnorisis
// @category Narrative Devices / Tragedy
// @source   https://allthetropes.org/wiki/Anagnorisis
// @domain   Narrative
// @version  1.3
//
// Laconic (per the wiki): the moment a character makes a critical discovery — Aristotle's
// "recognition," the change from ignorance to knowledge — that sends the tragedy inevitably to its
// end. The hero's sudden awareness of the real situation, often of who they themselves are or what
// they have done. FRONTIER: the TRAGIC recognition specifically — the Aristotelian beat where a
// figure who was [#Mistaken] comes to [#Knows] a devastating truth, paired with peripeteia (the
// reversal of fortune) and drowned in grief. Where tomato_in_the_mirror frames the reflexive
// AUDIENCE-vs-character twist (a self-model overturned, $cover != $truth), Anagnorisis is the
// recognition welded to the tragic turn: the knowing comes too late, the fortune has already
// inverted, and the truth is not a surprise to enjoy but a grief to bear. Where heel_realization is
// the seeing without the reversal, Anagnorisis is the seeing AT the reversal — recognition and
// peripeteia striking as one. The signature: [#Mistaken] -> [#Knows] of a $truth, [&Reverses] in the
// same beat, -- grief.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"               // recognition, grief, despair, the tragic affect
import "trl/modules/theory_of_mind.trl"       // Mistaken / Reveals / Knows — ignorance-to-knowledge
import "trl/modules/emotion_dynamics.trl"     // appraises the devastating truth -> grief
import "trl/tropes/character/archetypes/tragic_hero.trl"           // the figure this recognition befalls; peripeteia, the fall
import "trl/tropes/epistemic/reveal/tomato_in_the_mirror.trl"  // the reflexive self-reveal; Anagnorisis is the tragic sibling
import "trl/tropes/arc/redemption/heel_realization.trl"      // the seeing without the turn; Anagnorisis is the seeing AT the reversal

// Lateral thematic links (optional, machine-followable — for discovery / embeddings).
assoc anagnorisis -> [
  recognition         : "is Aristotle's own word for this change from ignorance to",
  tragic_hero         : "is the recognition that lands the fall of the",
  tomato_in_the_mirror: "is the tragic, grief-bearing sibling of the reflexive",
  heel_realization    : "is the seeing welded to the reversal, where this is the seeing alone",
  grief               : "delivers its devastating truth as",
  despair             : "leaves the recognizer, too late, in"
]


// === ONTOLOGY ===
// Anagnorisis subsumes the recognition itself, the tragic register it belongs to, and the reversal
// (peripeteia) Aristotle binds it to — the turn from ignorance to knowledge seen as a tragic beat.
imply Anagnorisis -> [recognition, Reversal, tragedy, Narrative]


// === ABSTRACT RULE ===
// Recognition: a figure $c is [#Mistaken] about some matter; a revelatory event surfaces the
// devastating $truth ([&Reveals]) AND reverses their fortune in the same beat ([&Reverses] —
// peripeteia, the Aristotelian pairing). The figure passes from ignorance to knowledge — [#Knows] the
// $truth — but the knowing is too late to avert the turn it explains, and it lands as grief. The
// [&Reverses] clause is the whole signature against tomato_in_the_mirror (a reveal with no reversal)
// and heel_realization (a seeing with no reversal): here recognition and peripeteia strike together.
rule Anagnorisis {
  when:
    char $c [#Mistaken(subject=$c)]
    evt  $disclosure [&Reveals(fact=$truth)] [&Reverses(state=$c)]
  then:
    $c [-Mistaken(subject=$c)]
    $c [#Knows(target=$truth)]
    $c [#Grieving(source=$truth)]
    $c -- grief
    $disclosure -- recognition : "Is"
    !$disclosure [+Anagnorisis]!
    surface(target=$c, message="Now, too late, you see the truth — and it is the ruin of you.")
}


// === CONCRETE VIGNETTE: King Lear — the king over Cordelia's body (Shakespeare, ~1606) ===
// Lear, in the first scene, demanded his daughters profess their love and measured the kingdom by the
// flattery; Cordelia, who loved him truly, would not perform it, and he banished her in a rage. The
// whole tragedy is the price of that error — the misjudging of which love was real. At the end, an old
// man broken on the heath, he carries her hanged body onstage and at last understands: the daughter he
// cast out was the one who loved him, and his own blindness killed her. The recognition arrives welded
// to the reversal — he sees the truth in the very instant it can change nothing — and he dies of it.

// KING LEAR — the king who measured love by flattery and banished the daughter who would not flatter
char lear [+Protagonist]
lear [#Mistaken(subject=lear)]                 // mistaken from scene one: that Cordelia's silence was want of love

// CORDELIA — the youngest, who loved him and would not perform it; hanged in prison
char cordelia [+LoveInterest]

// EXT. THE BRITISH CAMP — DAWN — defeat, the prisoners taken, the storm spent
set camp [+Exterior] [+Dawn] [+Contested]

arc lears_recognition [+Anagnorisis]

scene the_body_in_his_arms {
  beat 1 {
    lear @ camp
    cordelia @ camp
    // The error he has acted on the whole play: that her plain love was its absence.
    lear [#Mistaken(subject=lear)]
  }
  beat 2 {
    // The disclosure surfaces the truth AND inverts his fortune in one stroke — recognition welded
    // to peripeteia: she is dead, and she was the one who truly loved him.
    evt the_body [&Reveals(fact=she_loved_him_true)] [&Reverses(state=lear)]
        dialog(inject=[speaker=lear], inline="""
               speaker: "{speaker}"
               cue: "over Cordelia's body, the recognition and the ruin in one breath"
               tone: shattered, grieving, undone
               text: "Her voice was ever soft, gentle and low — an excellent thing in woman. And my poor fool is hanged."
               """)
    // Anagnorisis fires here, deriving lear [-Mistaken] [#Knows(she_loved_him_true)] !#Grieving! -- grief
    // and !the_body [+Anagnorisis]! — recognition welded to peripeteia, the rule's payoff (not asserted).
  }
}
