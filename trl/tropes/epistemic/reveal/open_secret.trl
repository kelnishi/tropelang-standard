// === PREAMBLE ===
// @trope    Open Secret
// @category Epistemic / Social
// @source   https://allthetropes.org/wiki/Open_Secret
// @version  1.3
// @domain    Epistemic
//
// Laconic (per the wiki): a fact practically everyone knows, yet nobody officially acknowledges
// or openly discusses. The STABLE resolution of mutual knowledge — the mirror of the Emperor's
// New Clothes. There the silence is fragile and one voice shatters it; here the silence is a
// tacit pact that everyone keeps, so the truth stays [+Unspoken] and never becomes common.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // revelation
import "trl/modules/common_knowledge.trl"  // the mutual knowledge that is deliberately never made common

assoc open_secret -> [
  common_knowledge   : "the never-made-common case of",
  emperors_new_clothes : "the stable mirror of"
]


// === ONTOLOGY ===

imply OpenSecret -> [Pretense, Knowledge, Narrative]


// === ABSTRACT RULE ===
// Naming rule: a widely-known truth deliberately kept unspoken IS an Open Secret (tags it). The
// tacit pact rides an EVENT (the keepers guarding the truth by silence, [&Guards]) so the rule is
// recalled and phase-2 re-checks [+Unspoken] on the bound truth (STYLE §8) — the silence is kept,
// not shattered.
rule Open_Secret {
  when:
    obj  $truth [+Unspoken]
    char $keepers
    evt  $pact [&Guards(agent=$keepers, target=$truth)]
  then:
    $truth [+OpenSecret]
}


// === CONCRETE VIGNETTE: Discworld — Carrot, the true king of Ankh-Morpork (novel) ===
// The whole city knows whose heir the big honest Watchman is; nobody says it out loud, by a
// silent civic agreement — and the last man who tried to make something of it got skewered.

char carrot     [+Protagonist] [+TrueKing]
char citizenry  [+Collective]
obj  the_lineage [+Unspoken]                // known to all, acknowledged by none

scene the_city {
  beat 1 {
    citizenry -- the_lineage : "everyone knows; nobody says"
    // the silence is a tacit pact the whole city keeps — the truth guarded by being left unspoken
    evt the_silent_pact [&Guards(agent=citizenry, target=the_lineage)]
    // Open_Secret -> the_lineage [+OpenSecret];  it never becomes common, so the polite fiction holds
  }
}
