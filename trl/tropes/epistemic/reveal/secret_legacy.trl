// === PREAMBLE ===
// @trope    Secret Legacy
// @category Heritage / Identity
// @source   https://allthetropes.org/wiki/Secret_Legacy
// @domain   Epistemic
// @version  1.3
//
// Laconic (per the wiki): a character is secretly the heir to a hidden heritage — royal blood, a
// chosen bloodline, a famous parent — unknown even to THEM until it is revealed, and the revelation
// reframes who they are and what they are for. An identity-and-heritage trope: it rides the same
// latent → surfaced epistemic spine as The Reveal, but the withheld fact is specifically a LINEAGE,
// and the one blindsided is the heir himself. Distinguished from Hidden Identity (the bearer there
// KNOWS the true self he conceals) and from The Chosen One (marked by prophecy, not by blood):
// here the destiny was carried in the blood all along, latent, waiting only to be told.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // legacy, revelation, secret, identity

assoc secret_legacy -> [
  legacy     : "the unclaimed inheritance is a",
  revelation : "the telling of the blood is a",
  secret     : "the lineage is held as a"
]


// === ONTOLOGY ===
// Archetype tags overlap world-specific heritage facts (a secret heir is an Heir of concealed
// Lineage, Destined by blood) so the device covers stories' birthright vocabulary.
imply SecretLegacy -> [Heir, Lineage, Concealed, Destined, Reveal_Pending, Narrative]


// === ABSTRACT RULES ===

// CONCEALMENT (setup) — the heritage is true in the graph but unsurfaced: the bearer is an Heir of
// a Lineage that neither he nor those around him perceive. The fact is `?latent?`.
rule Secret_Legacy_Concealed {
  when:
    char $heir
    not ( $heir [#Knows(target=$heir)] )
  then:
    ?$heir [+Heir] [+Lineage(id=$bloodline)]?
    $heir -- secret : "Carries Unknowing"
}

// THE TELLING (payoff) — a revelatory event discloses the blood to the heir who never knew it. The
// latent lineage is promoted to ABSOLUTE; identity and destiny are reframed in a single beat.
rule Secret_Legacy_Revealed {
  when:
    char $heir [+Heir] [+Lineage(id=$bloodline)]
    char $mentor [+Mentor]
    evt  $telling [&Reveals(agent=$mentor, fact=$bloodline)]   // an elder/mentor discloses the lineage (binds $mentor → [+Mentor] gates)
  then:
    !$heir [+Heir] [+Lineage(id=$bloodline)]!
    $heir [#Knows(target=$heir)]
    $telling -- revelation : "Is"
    $telling [+SecretLegacy]
    surface_global(title="Secret Legacy", description="The blood was there all along; now he is told.")
}


// === CONCRETE VIGNETTE: Percy Jackson and the Lightning Thief — son of Poseidon (novel, 2005) ===
// A dyslexic twelve-year-old who has bounced through six schools and assumes he is merely a screwup
// is told, after a fury attacks him on a field trip, that his absent father is the god of the sea —
// his clumsiness was demigod instinct, his trouble a beacon to monsters, his whole self re-read.

// PERCY JACKSON
char percy [+Protagonist]
?percy [+Heir] [+Lineage(id=poseidon)]?      // true from birth — unsurfaced even to himself

// CHIRON / MR. BRUNNER
char chiron [+Mentor]

// THE LIGHTNING BOLT (the quest the new heritage hands him)
obj the_bolt [+MacGuffin]

scene camp_half_blood {
  beat 1 {
    percy -- secret : "Carries Unknowing"     // the blood is in him, perceived by no one
    // Secret_Legacy_Concealed -> ?percy [+Heir] [+Lineage(id=poseidon)]?
  }
  beat 2 {
    evt the_claiming [&Reveals(agent=chiron, fact=poseidon)]
        dialog(inject=[speaker=chiron], inline="""
               speaker: "{speaker}"
               cue: "the trident burning green above the boy's head, the whole camp kneeling"
               tone: grave
               text: "Your father is Poseidon. Earthshaker, Stormbringer, Father of Horses. Hail, Perseus Jackson, Son of the Sea God."
               """)
    the_claiming -> percy
    // Secret_Legacy_Revealed -> !percy [+Heir] [+Lineage(id=poseidon)]!; percy [#Knows]; the_claiming [+SecretLegacy]
    percy > the_bolt : "Now Tasked To Recover"
  }
}
