// === PREAMBLE ===
// @trope    The Evil Prince
// @category Politics / Villains
// @source   https://allthetropes.org/wiki/The_Evil_Prince
// @domain   Narrative
// @scale    scene
// @version  1.3
//
// Laconic (per the wiki): a royal, usually not first in line, who pushes the heirs ahead of him aside so the
// throne falls to him — by murder, banishment, or court maneuver. FRONTIER: seizing the succession out of
// turn. The discriminator is a [+Pretender] (a scheming royal heir) bound on the agent of a [&Usurps] event
// (seize a position by force — not necessarily lethal) whose target is the [+Royalty] kin ahead of him —
// kin-murder (Scar) is one road, a bloodless usurpation (Fire Lord Ozai supplanting Iroh's birthright)
// another. Distinct from Klingon Promotion (the LETHAL usurpation of a [+Ruler], for any post) by the
// royal-bloodline succession motive, and from The Starscream (betray an evil master) by the lawful line.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"
import "trl/modules/power_dynamics.trl"   // the shared seize-by-force vocabulary: verb Usurps, the Usurp rule

assoc the_evil_prince -> [
  rightful_king_returns : "the usurper the true heir must displace",
  klingon_promotion : "a royal-succession cousin of",
  evil_chancellor : "the in-the-bloodline counterpart to"
]


// === ONTOLOGY ===
// — founded here (the throne-coveting royal usurper is the discriminator; reuses [&Usurps]/[+Royalty]) —
prop Pretender [+Political]   // a royal heir scheming to seize a throne not yet his

imply TheEvilPrince -> [Usurpation, Narrative]


// === ABSTRACT RULE ===
// Naming rule (scene scale): a [+Pretender] USURPS a [+Royalty] kinsman ahead of him — the schemer bound on
// the agent and the rival heir on the target of a [&Usurps] event (seize by force, lethal or bloodless), so
// phase-2 re-checks [+Pretender] on the usurper and [+Royalty] on the displaced kin (STYLE §8). Binding the
// throne-coveting heir against royal blood is the discriminator, parting it from Klingon Promotion (the
// lethal seizure of a [+Ruler], for any post) and a generic murder. The deed may be lethal or bloodless —
// the succession-grab itself is recognized.
rule The_Evil_Prince {
  when:
    char $prince [+Pretender] [+Masculine]
    char $kin [+Royalty]
    $prince != $kin
    evt  $coup [&Usurps(agent=$prince, target=$kin)]
  then:
    $coup [+TheEvilPrince]
}


// === CONCRETE VIGNETTE: The Lion King — Scar (animated film, 1994) ===
// Scar is second in line behind his brother Mufasa and Mufasa's heir Simba, and he means to fix that. He
// engineers the wildebeest stampede, lures Mufasa into the gorge, and — as his brother clings to the cliff
// begging for help — throws him to his death, then drives the cub Simba into exile and takes Pride Rock. The
// crown seized ahead of the rightful line: the Evil Prince in full. (Here the road is murder; Fire Lord Ozai
// walks the bloodless one — supplanting Iroh's birthright by his father's decree — and matches the same rule.)

// SCAR — the second-in-line who seizes the throne ahead of his blood
char scar [+Pretender] [+Antagonist] [+Masculine]

// MUFASA — the king and brother, the blood ahead of him
char mufasa [+Royalty]

// EXT. THE GORGE - the stampede, the cliff
set the_gorge [+Exterior]

scene the_seizure_of_pride_rock {
  beat 1 {
    mufasa @ the_gorge
    // the murder that clears his path — kin-murder is one road to the throne, not the only one
    evt the_betrayal [&Slays(agent=scar, target=mufasa)]
  }
  beat 2 {
    // with Mufasa dead and the cub Simba driven into exile, Scar takes the crown ahead of the rightful line
    evt the_usurpation [&Usurps(agent=scar, target=mufasa)]
    // The_Evil_Prince -> the_usurpation [+TheEvilPrince]
  }
}
