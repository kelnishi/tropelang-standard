// === PREAMBLE ===
// @trope    Xanatos Gambit
// @category Epistemic / Strategy
// @source   https://allthetropes.org/wiki/Xanatos_Gambit
// @domain   Epistemic
// @version  1.3
//
// Laconic (per the wiki): a plan structured so that EVERY plausible outcome benefits the
// schemer — they win whether the obvious plan succeeds or is foiled, because the failure branch
// was itself made to pay off (a consolation prize, or a hidden second plan completed by the
// foiling of the first). The only escape is to foil BOTH presented options at once and leave the
// organizer beaten. The signature this file recognizes (vs the Batman Gambit): a Batman Gambit
// stakes the plan on ONE modeled mark making ONE foreseen choice — break the pattern and it
// fails; the Xanatos Gambit has NO losing branch — both forks of the outcome are pre-engineered
// to favor the planner, so it does not depend on any single prediction holding. Named for David
// Xanatos of Gargoyles, who lived by it. FRONTIER: the foolproof gambit — a scheme whose
// branching resolution carries a planner-win on every branch, modeled as a fork() where each
// branch asserts the schemer [+Outwits] regardless of which way it breaks.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // conflict
import "trl/tropes/the_gambit.trl"         // a Xanatos Gambit IS a Gambit — with no failure branch
import "trl/modules/theory_of_mind.trl"    // the schemer's running model of the field of play

assoc xanatos_gambit -> [
  the_gambit     : "a no-losing-branch special case of",
  batman_gambit  : "the foolproof contrast to the one-prediction",
  conflict       : "wins on every branch of a",
  deception      : "lets the foiling of the plan still pay, via a hidden"
]


// === ONTOLOGY ===
// A Xanatos Gambit is a Gambit (hidden plan) whose every outcome is a win; the foolproofness —
// no branch loses — is what separates it from both the_gambit (which can fail if people break
// pattern) and the batman_gambit (which fails if the one modeled mark breaks pattern). (TheGambit
// is the parent cluster from the_gambit.trl; reused, not redefined.)
imply XanatosGambit -> [TheGambit, Manipulation, Strategy, Narrative]


// === ABSTRACT RULE ===
// Naming rule: a schemer launches a scheme ([&Schemes]) whose outcome is genuinely contested —
// it can break either way — yet BOTH ways were engineered to favor the planner. The rule asserts
// the schemer [~Predicts] nothing load-bearing about a single mark; instead the resolution forks,
// and the load-bearing claim is that EVERY branch ends with the schemer [+Outwits]. That is the
// signature: there is no branch on which the planner loses. The fork models the two foreseen
// outcomes (the obvious plan succeeds / the obvious plan is foiled); each branch independently
// names the deed a XanatosGambit and leaves the schemer winning. (Escape — foiling both options
// at once — is exactly the absence of any matching branch, the timeout fork below.)
rule XanatosGambit {
  when:
    char $schemer [&Schemes(target=$field)]
    evt  $plan [&Schemes(agent=$schemer)]
    not ( $plan [+Resolved] )
  then:
    $schemer [+Outwits(target=$field)]
    $plan [+XanatosGambit]
    fork(
      target = $schemer
      duration = 10
      ui_text = "The plan can break either way — does that matter?"
      branches = {
        "PlanSucceeds" : {
          triggers = [ ui_click(1), evt $win -> $plan @ $schemer ]
          apply = {
            $plan [+Resolved] [+PlanSucceeds]
            $schemer [+Outwits(target=$field)]
            dialog(kind=narration, inline="""
                   cue: "the obvious plan lands exactly as drawn up"
                   tone: cold
                   text: "Plan A worked. Of course it did."
                   """)
          }
        }
        "PlanFoiled" : {
          triggers = [ ui_click(2), evt $loss -> $plan !@ $schemer ]
          apply = {
            $plan [+Resolved] [+PlanFoiled]
            // the foiling of the first plan completes the hidden second — still a win
            $schemer [+Outwits(target=$field)]
            dialog(kind=narration, inline="""
                   cue: "the heroes foil it, and walk straight into the consolation prize"
                   tone: cold
                   text: "You beat the plan. The plan was the bait."
                   """)
          }
        }
      }
      // the only escape: foil BOTH options at once — no branch is taken, and only then
      // is the schemer left genuinely beaten rather than winning.
      timeout_apply = {
        $schemer [-Outwits]
        $schemer [+Outgambitted]
      }
    )
}


// === CONCRETE VIGNETTE: Sherlock Holmes — Lord Blackwood's no-lose plan (film, 2009) ===
// Lord Blackwood engineers his own arrest and public hanging by Holmes: if he is caught and hanged,
// he later "returns from the grave," proving to the secret order that supernatural power stands
// behind him — and rises even higher. If Holmes never catches him, he simply remains free and
// powerful, his ascent uninterrupted. Every branch of being-caught-or-not was built to pay off; the
// hanging is not a defeat but a step in the plan. The only thing that could have beaten him was
// Holmes foiling BOTH the rope and the resurrection at once — which, in the end, is exactly what he
// does, springing the timeout escape.

// LORD HENRY BLACKWOOD (the schemer running the no-lose plan)
char blackwood [+Antagonist] [+Cunning] [+Deceptive]
blackwood [&Schemes(target=the_order)]        // his plan is aimed at the whole field, not one mark
// THE TEMPLE OF THE FOUR ORDERS (the field of play he means to dominate)
char the_order [+Authority]
// THE PUBLIC HANGING (the engineered event — caught-and-hanged is itself a move that pays)
obj the_hanging [+MacGuffin]
// INT. PENTONVILLE PRISON GALLOWS - DAWN
set the_gallows [+Interior] [+Dawn]

scene the_no_lose_plan {
  beat 1 {
    blackwood @ the_gallows
    blackwood > the_hanging
    // the scheme: a plan engineered so that being caught and being free both advance him
    evt the_design [&Schemes(agent=blackwood, target=the_order)]
    // XanatosGambit -> blackwood [+Outwits(the_order)]; the_design [+XanatosGambit]; fork opens
  }
  beat 2 {
    // the obvious plan is "foiled" — Holmes catches and hangs him — yet the foiling is the bait:
    // the staged resurrection completes the hidden plan, and Blackwood still wins the branch
    evt staged_return [&Schemes(agent=blackwood)] [+PlanFoiled]
    // PlanFoiled branch: the_design [+Resolved] [+PlanFoiled]; blackwood [+Outwits] — still a win
    blackwood [+Outwits(target=the_order)]
  }
  beat 3 {
    // the only escape from a Xanatos Gambit: Holmes foils BOTH the rope AND the resurrection at
    // once, exposing the mechanism — no winning branch is left, and the schemer is finally beaten
    evt both_foiled [&Reveals(fact=the_mechanism)]
    blackwood [-Outwits]
    !blackwood [+Outgambitted]!
  }
}
