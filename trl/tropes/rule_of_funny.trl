// === PREAMBLE ===
// @trope    Rule of Funny
// @category Rhetoric / Comedy
// @source   https://allthetropes.org/wiki/Rule_of_Funny
// @version  1.3
//
// Laconic (per the wiki): any violation of continuity, logic, or physics is permitted if the
// result gets enough of a laugh — the comedy cousin of the Rule of Cool. It is the AUTHOR's
// prerogative, not a character's: the framing of an event as comic is what makes the audience
// laugh rather than wince (slapstick's whole trick is harm with "a lack of serious physical
// consequences"). Rides the rhetoric module's Appraise_Comic — and demonstrates that character
// logic is overridable when the laugh is the goal.


// === IMPORTS & ASSOCIATIONS ===
import "trl/modules/rhetoric.trl"          // Appraise_Comic -> audience [#Amused]

assoc rule_of_funny -> [
  rhetoric : "the comic-framing rule of",
  audience : "spends logic to buy a laugh from the"
]


// === ONTOLOGY ===

imply RuleOfFunny -> [Comedy, Override, Narrative]


// === ABSTRACT RULE ===
// Naming rule: framing a mishap as comic, logic be damned, IS the Rule of Funny (tags the framing).
rule Rule_Of_Funny {
  when:
    char $c [+Hurt]
    evt  $f [&Frames(agent=author, target=$c, as=comic)]
  then:
    $f [+RuleOfFunny]
}


// === CONCRETE VIGNETTE: Zoolander — the gasoline fight (film, 2001) ===
// Three male models horse around at a gas station and immolate themselves — an objectively
// horrific death played, by the framing alone, as pure absurd comedy. Logic and consequence
// step aside; the audience laughs.

char the_models [+Hurt]

scene the_gas_station {
  beat 1 {
    evt the_immolation [&Frames(agent=author, target=the_models, as=comic)]
    // Appraise_Comic (rhetoric) -> audience [#Amused];  Rule_Of_Funny tags the framing
  }
}
