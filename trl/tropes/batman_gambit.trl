// === PREAMBLE ===
// @trope    Batman Gambit
// @category Epistemic / Strategy
// @source   https://allthetropes.org/wiki/Batman_Gambit
// @domain   Epistemic
// @version  1.3
//
// Laconic (per the wiki): a plan that relies on a specific person doing exactly as predicted in the
// given circumstances — the chessmaster takes everything they know about ONE mark and engineers a
// situation in which the mark's own predictable choice springs the trap. The signature this file
// recognizes (vs a plain Gambit): the schemer is running an explicit theory_of_mind model of that
// one person ([@Models(other=$mark)]) and stakes the plan on a SINGLE predicted choice; if the mark
// broke pattern the gambit fails. That keyed-on-a-person failure condition is what separates the
// Batman Gambit from the foolproof Xanatos Gambit, and the named-mind model is what separates it from
// the_gambit (which predicts "people" in the aggregate). FRONTIER: a gambit whose load-bearing
// hinge is a modeled person's predictable decision — a weaponized false-belief about how they'll act.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"            // conflict
import "trl/tropes/the_gambit.trl"         // Batman Gambit IS a Gambit keyed on one predicted person
import "trl/modules/theory_of_mind.trl"    // [@Models(other=)] — the named running model of the mark

assoc batman_gambit -> [
  the_gambit     : "a person-keyed special case of",
  theory_of_mind : "stakes the plan on a modeled mind via",
  deception      : "engineers the mark's predictable choice via a",
  conflict       : "wins, without overpowering the mark, a"
]


// === ONTOLOGY ===
// A Batman Gambit is a Gambit (hidden plan) plus an explicit model of one mark's mind; the win
// comes from manipulation read against that single person, not force. (TheGambit is the parent
// cluster from the_gambit.trl; reused, not redefined.)
imply BatmanGambit -> [TheGambit, Manipulation, Strategy, Narrative]


// === ABSTRACT RULE ===
// Naming rule: a schemer who is running a named model of ONE mark ([@Models]) predicts that mark's
// choice ([~Predicts]); the mark then makes exactly the foreseen choice ([&Acts]) — and THAT springs
// the plan. The deed IS the Batman Gambit (tags it) and the schemer [+Outwits] the mark. The
// load-bearing clause that separates this from the_gambit's The_Gambit is [@Models(other=$mark)]:
// the prediction is grounded in a held model of that specific person, not a guess about people in
// general. The failure condition is implicit — the rule fires only if the mark actually acts as
// foreseen; had they broken pattern, no $act matches and the gambit does not name.
rule BatmanGambit {
  when:
    char $schemer [@Models(other=$mark)] [~Predicts(target=$mark)]
    char $mark
    evt  $act [&Acts(agent=$mark)]
  then:
    $schemer [+Outwits(target=$mark)]
    $act [+BatmanGambit]
}


// === CONCRETE VIGNETTE: The Sting — the Delayed-Wire con on Doyle Lonnegan (film, 1973) ===
// Gondorff and Hooker do not out-muscle the Irish mob banker Doyle Lonnegan; they read him. The whole
// con is built on one prediction about one man: a proud, vengeful, greedy mark, stung by a small loss
// and baited with inside race results, will not walk away — he will commit his whole bankroll to the
// big bet to ruin "Shaw." Every move in the fake betting parlor is engineered so that Lonnegan's own
// predictable choice to plunge springs the trap. Had he kept his temper and his money, the gambit
// collapses; instead he behaves exactly as modeled, lays down half a million, and is taken clean.

// HENRY GONDORFF (the inside man running the con)
char gondorff [+Protagonist] [+Cunning] [+Deceptive]
gondorff [@Models(other=lonnegan)]            // he has Lonnegan's pride and greed fully modeled
gondorff [~Predicts(target=lonnegan)]         // he stakes the con on Lonnegan's one predicted choice
// DOYLE LONNEGAN (the mark — a vengeful, greedy mob banker)
char lonnegan [+Antagonist] [+Authority]
lonnegan [#MotivatedBy(reason="Vengeance")]   // the modeled lever: he must answer the slight
// THE BIG BET (the engineered choice — half a million on a "sure" wire tip)
obj the_big_bet [+MacGuffin]
// INT. SHAW'S BETTING PARLOR - DAY
set betting_parlor [+Interior] [+Day]

scene the_wire_con {
  beat 1 {
    gondorff @ betting_parlor
    lonnegan @ betting_parlor
    gondorff > the_big_bet
    // the engineered situation: a stung, greedy mark baited toward the one move he cannot resist
    evt the_bait [&Feints(agent=gondorff, target=lonnegan)]
    // gondorff [@Models(lonnegan)] [~Predicts(lonnegan)] — the plan rides one foreseen choice
  }
  beat 2 {
    // the mark behaves exactly as modeled: he plunges his bankroll on the rigged tip
    evt place_it_all [&Acts(agent=lonnegan)]
    // BatmanGambit -> gondorff [+Outwits(lonnegan)];  place_it_all [+BatmanGambit]
  }
}
