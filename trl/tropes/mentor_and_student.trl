// === PREAMBLE ===
// @trope    Mentor and Student
// @category Relationships / Bonds
// @source   https://allthetropes.org/wiki/Mentors
// @version  1.3
// @domain    Interpersonal
//
// Laconic: the teaching bond — a master who shapes a pupil, and a pupil who is changed (and may
// surpass, or be failed by, or destroy, the master). Distinct from The Mentor (the role): this is
// the relationship and its arc. The bond can be warm or brutal; what defines it is transformation
// passing from one to the other.

import "trl/concepts/index.trl"            // wisdom, transformation

assoc mentor_and_student -> [
  wisdom         : "transmits, across a generation,",
  transformation : "the student is the master's"
]

imply MentorAndStudent -> [Bond, Growth, Narrative]

// Naming rule: a master teaching a pupil grows the pupil — the mentor-student bond at work.
rule Mentor_And_Student {
  when:
    char $m [@Mentor_Of(student=$s)]
    evt  $lesson [&Teaches(agent=$m, target=$s)]
  then:
    $s [+Grows]
    $lesson [+MentorAndStudent]
    $m -- wisdom
}

// === CONCRETE VIGNETTE: Whiplash — Fletcher and Neiman (film, 2014) ===
// The bond at its most brutal: a conservatory teacher who abuses, baits, and very nearly breaks
// his drummer in the conviction that genius is forged only under cruelty — and a student remade,
// for better and worse, in exactly that image.
char fletcher [+Mentor]      [@Mentor_Of(student=neiman)]
char neiman   [+Protagonist]

scene the_studio {
  beat 1 {
    evt the_tempo [&Teaches(agent=fletcher, target=neiman)]   // "not quite my tempo" — taught by terror
    // Mentor_And_Student -> neiman [+Grows]
  }
}
