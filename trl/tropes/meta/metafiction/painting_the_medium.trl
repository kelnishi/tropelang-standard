// === PREAMBLE ===
// @trope    Painting the Medium
// @category Metafiction
// @source   https://allthetropes.org/wiki/Painting_the_Medium
// @domain   Narrative
// @scale    scene
// @version  1.3
//
// Laconic (per the wiki): the AUTHOR modifies the presentation itself to convey story — a B&W flashback,
// character-specific speech bubbles, a GUI that shifts with the character. FRONTIER: the medium used as a
// storytelling instrument. The discriminator is a [+MediumArtifact] bound on the `artifact=` role of an
// [&Employs] event by the author. Distinct from Medium Awareness (a CHARACTER who [&Notices] the
// artifact): here the author wields the artifact and the characters never know — the meaning is in the
// presentation.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"
import "trl/tropes/meta/metafiction/medium_awareness.trl"   // the character-side counterpart (reuses [+MediumArtifact])

assoc painting_the_medium -> [
  medium_awareness : "the author-side counterpart of",
  lampshade_hanging : "conveys silently what others"
]


// === ONTOLOGY ===
// — founded here (the author wielding a medium artifact is the discriminator; reuses [+MediumArtifact]) —
verb Employs(artifact) [+Narrative]   // the author bends a medium element to convey story

imply PaintingTheMedium -> [Metafictional, Narrative]


// === ABSTRACT RULE ===
// Naming rule (scene scale): the author EMPLOYS a [+MediumArtifact] to convey story — the artifact bound
// on the `artifact=` role of an [&Employs] event (agent=$author), so phase-2 re-checks [+MediumArtifact]
// on it (STYLE §8). Binding the artifact on the AUTHOR's use is the discriminator: the presentation
// carries the meaning, parting it from Medium Awareness (a character noticing the artifact in-world).
rule Painting_The_Medium {
  when:
    obj  $artifact [+MediumArtifact]
    evt  $use [&Employs(agent=$author, artifact=$artifact)]
  then:
    $use [+PaintingTheMedium]
}


// === CONCRETE VIGNETTE: Schindler's List — the girl in the red coat (film, 1993) ===
// The film is shot in stark black and white — and then, in the horror of the liquidation of the ghetto,
// one small girl's coat is rendered in red. No character remarks on it; no one in 1943 Kraków sees color
// where there is none. It is Spielberg speaking directly through the medium: the single spot of color
// makes the eye, and the conscience, follow that one child through the slaughter, and later find her coat
// on a cart of the dead. The presentation itself tells the story.

// THE RED COAT — color in a black-and-white film, used to carry meaning
obj the_red_coat [+MediumArtifact]

// THE DIRECTOR — who bends the medium to make us follow the child
char spielberg

scene the_liquidation {
  beat 1 {
    // the author paints the medium itself — one red coat in a monochrome world
    evt the_color [&Employs(agent=spielberg, artifact=the_red_coat)]
    // Painting_The_Medium -> the_color [+PaintingTheMedium]
  }
}
