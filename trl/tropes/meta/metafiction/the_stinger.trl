// === PREAMBLE ===
// @trope    The Stinger
// @category Metafiction / Paratext
// @source   https://allthetropes.org/wiki/The_Stinger
// @domain   Narrative
// @scale    scene
// @version  1.4
//
// Laconic (per the wiki): a scene placed AFTER the credits — the "credit cookie," the monk's reward — a
// final joke, a sequel hook, or a survivor revealed, for those who stay. FRONTIER: a paratext-PLACEMENT
// trope; meaning comes from where the scene sits. The discriminator is a `scene` occupying the `post_credits`
// SLOT on a work's skeleton (the medium-format structure of S01 §7; engine ≥ 0.6.0) — structural placement,
// not a prop on a stand-in object. Distinct from a Sequel Hook (about the CONTENT promising more, wherever it
// sits): the Stinger is defined by the after-the-credits slot.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

assoc the_stinger -> [
  sequel_hook : "a common payload of"
  // hilarious_outtakes : "may instead carry"   // unconverted att-archive trope — re-enable on conversion
]


// === ONTOLOGY ===
// — the discriminator is PLACEMENT on the work skeleton (S01 §3 `work`, §7 slot-occupancy; engine ≥ 0.6.0):
//   a SCENE occupies the after-the-credits slot (`scene … @ post_credits`). The medium rides on the work's
//   `[%…]` essence; no stand-in object, no bespoke placement prop — the slot concept IS the structure. The
//   recall anchor is a separate char-agent event in that scene: the makers `[&Appends]` a final beat (recall
//   keeps only agent-named events, STYLE §8 / S15 — a pure slot edge alone does not recall). —
concept post_credits [+Narrative]   // a structural slot on a work's skeleton — the after-the-credits position
verb Appends [+Narrative]           // the makers hang a final beat past the work's formal end

imply TheStinger -> [Metafictional, Narrative]


// === ABSTRACT RULE ===
// Naming rule (scene scale): a `scene` sits in the `post_credits` slot of a work's skeleton, and its makers
// `[&Appends]` a beat there. The scene's `@ post_credits` placement (S01 §7) is the DISCRIMINATOR, re-checked
// in phase-2 (STYLE §8); the agent-named `[&Appends]` event is the RECALL ANCHOR (a slot edge alone does not
// recall). Meaning is the after-the-credits position it occupies, parting it from a Sequel Hook (defined by
// content, anywhere in the work).
rule The_Stinger {
  when:
    scene $s @ post_credits
    evt   $beat [&Appends(agent=$creator)]
  then:
    $beat [+TheStinger]
}


// === CONCRETE VIGNETTE: Iron Man — Nick Fury after the credits (film, 2008) ===
// The credits roll, the lights come up, most of the theater files out — and those who stay are rewarded:
// Tony Stark comes home to find a man in shadow in his living room. "I'm Nick Fury, Director of SHIELD.
// I'm here to talk to you about the Avenger Initiative." A whole scene, hung after the formal end of the
// film, seen only by the devoted who waited. The Stinger that taught a generation to never leave before
// the lights are up.

// IRON MAN — the work-as-artifact (a film); its skeleton carries the post-credits slot
work iron_man [%Film]

// THE FILMMAKERS — the creators who hang the beat past the formal end (the appending agency)
char the_filmmakers

// NICK FURY — the man in the dark, revealed only to those who stayed
char nick_fury [+Mysterious]

// INT. STARK'S LIVING ROOM - after the credits
set the_living_room [+Interior]

scene after_the_credits @ post_credits {
  beat 1 {
    nick_fury @ the_living_room
    // the makers hang a full beat in the post-credits slot — "the Avenger Initiative"
    evt the_reveal [&Appends(agent=the_filmmakers)]
    // The_Stinger -> the_reveal [+TheStinger]
  }
}
