// === PREAMBLE ===
// @trope    The Stinger
// @category Metafiction / Paratext
// @source   https://allthetropes.org/wiki/The_Stinger
// @domain   Narrative
// @scale    scene
// @version  1.3
//
// Laconic (per the wiki): a scene placed AFTER the credits — the "credit cookie," the monk's reward — a
// final joke, a sequel hook, or a survivor revealed, for those who stay. FRONTIER: a paratext-PLACEMENT
// trope; meaning comes from where the scene sits. The discriminator is a [+PostCredits] scene bound on an
// [&Appends] event — a beat hung after the credits roll. Distinct from a Sequel Hook (which is about the
// CONTENT promising more, wherever it sits): the Stinger is defined by the after-the-credits slot.


// === IMPORTS & ASSOCIATIONS ===
import "trl/concepts/index.trl"

assoc the_stinger -> [
  sequel_hook : "a common payload of",
  hilarious_outtakes : "may instead carry"
]


// === ONTOLOGY ===
// — founded here (the after-the-credits placement is the discriminator; promotion model) —
prop PostCredits  [+Narrative]   // a scene placed after the credits roll — the credit cookie
verb Appends(scene) [+Narrative] // hangs a beat after the work has formally ended

imply TheStinger -> [Metafictional, Narrative]


// === ABSTRACT RULE ===
// Naming rule (scene scale): a work APPENDS a [+PostCredits] scene — the scene bound on the `scene=` role
// of an [&Appends] event (agent=$work), so phase-2 re-checks [+PostCredits] on the bound scene (STYLE §8).
// Binding the after-the-credits placement on the scene is the discriminator: the meaning is the slot it
// occupies, parting it from a Sequel Hook (defined by content, anywhere in the work).
rule The_Stinger {
  when:
    obj  $scene [+PostCredits]
    evt  $tag [&Appends(agent=$work, scene=$scene)]
  then:
    $tag [+TheStinger]
}


// === CONCRETE VIGNETTE: Iron Man — Nick Fury after the credits (film, 2008) ===
// The credits roll, the lights come up, most of the theater files out — and those who stay are rewarded:
// Tony Stark comes home to find a man in shadow in his living room. "I'm Nick Fury, Director of SHIELD.
// I'm here to talk to you about the Avenger Initiative." A whole scene, hung after the formal end of the
// film, seen only by the devoted who waited. The Stinger that taught a generation to never leave before
// the lights are up.

// THE FILM — which hangs a scene past its own ending
char the_film

// THE POST-CREDITS SCENE — Nick Fury in the living room, after the credits
obj the_fury_scene [+PostCredits]

scene after_the_credits {
  beat 1 {
    // a full beat hung after the credits roll — the reward for those who stayed
    evt the_tag [&Appends(agent=the_film, scene=the_fury_scene)]
    // The_Stinger -> the_tag [+TheStinger]
  }
}
