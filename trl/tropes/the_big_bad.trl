// === PREAMBLE ===
// @trope    The Big Bad
// @category Relationships / Cast
// @source   https://allthetropes.org/wiki/Big_Bad
// @version  1.3
//
// Laconic (per the wiki): the principal antagonist whose schemes drive the central conflict — the
// dark pole the hero is defined against. A relational role: the Big Bad and the hero are each
// other's nemesis, and the story's stakes are the gap between what each wants.

import "trl/concepts/index.trl"            // conflict

assoc the_big_bad -> [
  conflict     : "the dark pole of a",
  the_chosen_one : "hunts down a"
]

imply BigBad -> [Antagonist, Mastermind, Narrative]

// Naming rule: an antagonist set as the hero's nemesis IS the Big Bad (binds the central enmity).
rule The_Big_Bad {
  when:
    char $h [+Protagonist]
    char $v [+Antagonist] [@Nemesis_Of(other=$h)]
  then:
    $v [+BigBad]
    $h [+Opposed_By(villain=$v)]
    $v -- conflict
}

// === CONCRETE VIGNETTE: Sherlock Holmes — Professor Moriarty (novel, 1893) ===
// The Napoleon of Crime, the spider at the centre of London's web — the one mind Holmes reckons
// his equal, and the only foe worth his own destruction at the Reichenbach Falls.
char holmes   [+Protagonist]
char moriarty [+Antagonist] [@Nemesis_Of(other=holmes)]

scene reichenbach {
  beat 1 {
    moriarty -- holmes : "the equal and opposite of the great detective"
    // The_Big_Bad -> moriarty [+BigBad], holmes [+Opposed_By(villain=moriarty)]
  }
}
