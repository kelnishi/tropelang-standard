// @title   Bill & Ted's Excellent Adventure
// @medium  Feature Film
// @format  Time-travel comedy; three-act structure + epilogue
// @domain  Contemporary Comedy / Bildungsroman / Science Fiction
// @version 2.2

import "trl/modules/index.trl"

// ===== WORK =====
work the_film [%Feature]

// ===== STORY-TIME (fabula) — the chronological spine =====
// Each ~> link encodes "came before in the world"
// The syuzhet visits these out of order; @@ anchors displace references

// Fabula left-to-right, real-world time
chron ancient_greece ~> medieval_england ~> renaissance_austria
    ~> american_frontier ~> napoleon_paris_1815 ~> san_dimas_1988
    ~> san_dimas_future_2688

// ===== CAST =====
char bill           [+Protagonist] [+Everyman] [+Innocent] [+Weak] [+Dynamic] [+OrdinaryWorld]
                    [+Inseparable] [+Masculine] [@Bonded_To(other=ted)]
char ted            [+Protagonist] [+Everyman] [+Innocent] [+Weak] [+Dynamic] [+OrdinaryWorld]
                    [+Inseparable] [+Masculine] [@Bonded_To(other=bill)]
char rufus          [+Mentor] [+TheHerald] [@Mentor_Of(student=bill)]
char napoleon       [+Historical] [+Arrogant] [+Antagonist] [+Dignified] [+Hurt] [+Stranger] [+Diminutive]
                    // "Napoleon was a short dude who lived a long time ago" — bill's entire historiography
char socrates       [+Historical] [+Wise] [+Stranger]
char joan_of_arc    [+Historical] [+Hero] [+Stranger]
char genghis_khan   [+Historical] [+Antagonist] [+Dignified] [+Hurt] [+Stranger]
char billy_the_kid  [+Historical] [+Roguish] [+Sympathetic] [+Ally] [+Stranger]
char freud          [+Historical] [+Stranger]
char beethoven      [+Historical] [+Stranger]
char lincoln        [+Historical] [+Authority] [+Ally] [+Stranger]
char missy          [+Ally] [+ParentalSubstitute]
char mr_ryan        [+Antagonist] [+Authority]
char captain_logan  [+Antagonist] [+Authority] [+Paternal] [+Uniformed]
                    // Ted's father; police captain; military-school threat; uniform signals institutional power
char elizabeth      [+LoveInterest] [+Stranger]             // Bill's destined princess; medieval England
char joanna         [+LoveInterest] [+Stranger]             // Ted's destined princess; medieval England
char station        [+Mentor]
char death          [+Antagonist]
char evil_bill      [+Antagonist] [+Foil]               // Bogus Journey; mirror of bill
char evil_ted       [+Antagonist] [+Foil]               // Bogus Journey; mirror of ted

// ===== OBJECTS =====
obj the_phone_booth     [+MacGuffin] [+Objective] [+Coveted]
obj the_report          [+MacGuffin] [+Objective] [+Lesson] [+Coveted]

// ===== SETS =====
set the_circle_k            [+Exterior] [+Mundane] [+Conspicuous]  // recurring landmark; ice cream; Strange things afoot
set san_dimas_1988          [+Suburban] [+OrdinaryWorld]
set medieval_england        [+Exterior] [+Exotic]
set ancient_greece          [+Exterior] [+Exotic]
set renaissance_austria     [+Exterior] [+Exotic]
set american_frontier       [+Exterior] [+Exotic]
set napoleon_paris_1815     [+Exterior] [+Exotic]
set san_dimas_future_2688   [+Utopia] [+Exterior]
set the_mall                [+Exterior] [+Crowded]
set the_mall_interiors      [+Interior] [+Crowded]
set the_auditorium          [+Interior] [+HighStakes] [+Climax]

// ===== CONCEPTS =====
concept history             [+Abstract] [+Lesson]
concept time_travel         [+Abstract]
concept being_excellent     [+Abstract] [+Lesson] [+Conspicuous]   // the phrase that opens, recurs, and closes
concept party_on            [+Abstract] [+Conspicuous]             // Rufus's second instruction; echoed by Lincoln
concept the_journey         [+Abstract]             // the time-travel ordeal that forges the boys
concept the_utopia          [+Abstract]             // the future society predicated on B&T's music
concept wyld_stallyns       [+Abstract] [+Weak]     // the band — private dream; they cannot actually play yet
concept the_prophecy        [+Abstract] [+Lesson]   // wyld_stallyns' music will unite humanity; stated by Rufus
concept san_dimas_slogan    [+Abstract] [+Conspicuous]  // "San Dimas High School Football Rules!" — graffiti, chant, ambient truth

// ===== SEEDS — latent threads that surface later =====
?bill [~Pursues(goal=the_report)]?
?ted  [~Pursues(goal=the_report)]?
*(the_phone_booth [+Trap] | the_phone_booth [+Gift])* as booth_nature
?bill [~Pursues(goal=being_excellent)]?
?ted  [~Pursues(goal=being_excellent)]?
?wyld_stallyns [~Grows(into=the_utopia)]?   // the band hasn't done anything yet; the prophecy precedes the talent
// "San Dimas High School Football Rules!" — environmental slogan; ambient substrate of their world
san_dimas_slogan [+Conspicuous] [+Ambient]  // graffiti on walls; chanted in the background; the town's only firm belief
// Romantic seeds — planted early, never resolved in this film; the sequel's payoff
?bill [~Loves(target=missy)]?       // the faux-Oedipal attraction; Freud will name it
?ted  [~Loves(target=missy)]?       // his own father's partner; same dynamic, worse geometry
?bill [~Loves(target=elizabeth)]?   // the princess seen through the window; surfaces in Bogus Journey
?ted  [~Loves(target=joanna)]?      // same

// ===== AUTHORING NOTES =====
//
// Beat labels: use short descriptive identifiers scoped to their scene rather than
//   global sequence numbers. "beat the_capture" inside "scene napoleon_extraction"
//   is unambiguous, self-documenting, and never needs renumbering when beats are
//   added or removed. Global numbers are a maintenance liability.
//
// Inline declarations: declare obj/set at first use when they appear in only one
//   scene. Reserve the header for things that span multiple scenes or that need
//   to be visible as part of the work's overall vocabulary (chron markers, major
//   MacGuffins, recurring concepts). The header is a reading aid, not a registry.
//
// Seeds before the log: latent threads (?entity [~verb]?) declared before the arc
//   are surfaced by plain re-assertion inside beats — no special syntax required.
//   The seed captures the possibility; the beat makes it actual.
//
// Inline dialog: dialog() annotations can carry details that don't fire any current
//   corpus rule. Encode them anyway. The cue and motivation fields are particularly
//   useful for this — they hold the "why" of a moment even when no trope is yet
//   defined to receive it. Future corpus additions will find the evidence already
//   present.

// ===== LOG =====

arc bill_and_ted_journey [+TheQuest] [+ComingOfAge] {

  // ── ACT 1 · THE ORDINARY WORLD ──────────────────────────────────────────

  act the_ordinary_world {

    scene the_garage_scene @@ san_dimas_1988 {
      beat bond_and_stakes {
        // The bond and the stakes: two threads established simultaneously
        bill @ san_dimas_1988
        ted  @ san_dimas_1988
        bill [+Dreamer]
        ted  [+Dreamer]
        bill [#Failing]
        ted  [#Failing]

        evt the_bond [&Cherishes(agent=bill, other=ted)]
        // HeterosexualLifePartners — the Wyld Stallyns pact is the "couple" the stakes threaten

        evt the_stakes [&Reveals(agent=mr_ryan, target=bill)]
            dialog(inject=[speaker=mr_ryan, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "flat authority — this is not a threat, it is a fact"
                   tone: stern
                   text: "You have one week to pass history. Fail, and Ted goes to military school. Wyld Stallyns ends."
                   motivation: "{speaker} is removing the safety net — the boys have to care about history now"
                   """)
        the_report [+MacGuffin]
        bill [~Pursues(goal=the_report)]   // latent seed surfaces
        ted  [~Pursues(goal=the_report)]
      }

      beat air_guitar {
        // Thread B: what Wyld Stallyns actually is — the private vision that makes the stakes matter
        // The air guitar is RuleOfCool applied to nothing: the virtuosity is entirely imaginary,
        // which is both the gag and the point
        set the_garage_set [+Interior] [+Isolated]
        evt the_air_guitar [&Performs(agent=bill, location=the_garage_set)]
            dialog(inject=[speaker=bill, target=ted],
                   inline="""
                   kind: narration
                   cue: "lit from below by the single bare bulb; the camera treats this with complete sincerity"
                   tone: earnest
                   text: "Bill picks up an invisible guitar. Ted nods. They play. No sound comes out. The performance is flawless."
                   motivation: "the joke is that the camera doesn't blink — the movie believes in them, so we do too"
                   """)
        bill -- wyld_stallyns : "Co-founder"
        ted  -- wyld_stallyns : "Co-founder"
        wyld_stallyns [+Coveted] [+Symbolic]

        evt air_guitar_framed [&Frames(agent=author, target=wyld_stallyns, as=cool)]
        // RuleOfCool — the visual gag that establishes the film's entire tonal register:
        //   nothing is happening and it is magnificent

        // Critical encoding: they cannot play. The guitars are imaginary. The talent is entirely latent.
        // The prophecy will be about music they haven't made; the world will be built from a song they
        // haven't written; the air guitar IS the promise, not the product.
        wyld_stallyns [+Weak] [-Conspicuous]  // no audience yet; the band exists only to themselves
        bill [+Incompetent]   // confirmed: "most non-non-non-non-heinous" is the critical vocabulary available
        ted  [+Incompetent]   // same; the journey will not fix their guitar playing — that's for later

        evt wyld_stallyns_introduced [&Introduces(object=wyld_stallyns)]
        // The band is the real Chekhov's Gun; the report is just the mechanism that forces them to grow
      }
    }

    scene the_family_web @@ san_dimas_1988 {
      // The geometry of the obstacle: two authority figures, one shared woman, one impossible attraction
      beat logan_and_missy {
        // Thread A: Captain Logan — the paternal obstacle who actually holds the Alaska threat
        captain_logan @ san_dimas_1988
        captain_logan -- ted : "Father"
        captain_logan [~Desires(target=the_report)]   // wants the boys to fail; confirms the threat

        evt logan_threatens [&Reveals(agent=captain_logan, target=ted)]
            dialog(inject=[speaker=captain_logan, target=ted],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the specific disappointment of a man who expected more and has stopped being surprised"
                   tone: clipped
                   text: "One week. History report. You fail, you're on a plane. I've already called the school."
                   motivation: "{speaker} is not the villain — he's a reasonable man whose son has given him nothing to work with"
                   """)

        // Thread B: Missy — the family-web knot
        // Missy was married to Bill's dad; now she's with Captain Logan; both boys call her something different
        missy [@Married(partner=captain_logan)]
        missy -- bill : "Former stepmom"
        missy -- ted  : "Father's partner"

        evt bill_sees_missy [&Meets(agent=bill, other=missy)]
            dialog(inject=[speaker=bill, target=missy],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the specific discomfort of a teenage boy greeting his former stepmother who is now at his best friend's house"
                   tone: awkward
                   text: "'Oh. Hey. [pause] ...Mom.'"
                   motivation: "one word; contains multitudes; the film's densest gag — the Oedipus complex already installed and acknowledged in a single syllable"
                   """)
        bill [~Loves(target=missy)]   // latent seed surfaces as acknowledgment; immediately suppressed
        ted  [~Loves(target=missy)]   // same geometry; worse because captain_logan is his actual father
        // LoveTriangle seeds: bill and ted both love missy; both suppress it; Freud will find it anyway
      }

      beat missy_as_ally {
        // Thread C: Missy as ally — she's actually kind to the boys despite the geometry
        // The ParentalSubstitute is genuine; the attraction is real but unspoken; both things are true
        evt missy_helps [&Aided(other=bill)]
            dialog(inject=[speaker=missy, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the warmth of someone who doesn't hold the geometry against them"
                   tone: kind
                   text: "You boys need anything? I made sandwiches. [beat] The good kind."
                   motivation: "{speaker} is the only adult who isn't an obstacle — her kindness is the inverse of {target}'s father's coldness"
                   """)
        missy [+Ally]
        // The ParentalSubstitute thread: Missy is the warm adult the boys actually have,
        //   despite — or because of — the impossible family geometry she occupies
      }
    }

    scene the_herald_arrives @@ san_dimas_1988 {
      beat rufus_arrives {
        // Rufus arrives; the phrase is planted; the booth is delivered
        evt rufus_descends [&Arrives(agent=rufus, location=san_dimas_1988)]
            dialog(inject=[speaker=rufus],
                   inline="""
                   kind: monologue
                   speaker: "{speaker}"
                   cue: "low-key reverence — the future's most important mission, delivered like a routine errand"
                   tone: warm
                   text: "I can't tell you who I am or why I've come, but I can tell you that the future of the world is in your hands. Be excellent to each other. And party on, dudes."
                   motivation: "{speaker} seeds the mission without explaining it — the audience is ahead of the boys"
                   """)
        rufus > the_phone_booth : "Delivers"
        resolve booth_nature -> the_phone_booth [+Gift]
        !the_phone_booth [+Gift]!

        evt rufus_prophesies [&Reveals(agent=rufus, target=the_prophecy)]
            dialog(inject=[speaker=rufus],
                   inline="""
                   kind: monologue
                   speaker: "{speaker}"
                   cue: "the gravity of a man delivering the film's entire premise in two sentences"
                   tone: solemn
                   text: "In the future, their music will be the foundation of our society. It will unite all peoples of the world in harmony. Eventually."
                   motivation: "{speaker} encodes the stakes: wyld_stallyns hasn't made the music yet; the future is betting on potential, not product — the joke and the thesis are the same fact"
                   """)
        rufus -- the_prophecy : "Carries"
        the_prophecy -- wyld_stallyns : "Rests on"
        the_prophecy -- the_utopia   : "Predicts"

        evt the_call [&Calls(agent=rufus, target=bill)]
        // CallToAdventure

        evt rufus_teaches [&Teaches(agent=rufus, target=bill)]
        // MentorAndStudent — rufus shows them how the booth works; the keypad mechanism; the lesson that unlocks the quest
        obj the_keypad [+Mundane] [+Conspicuous]   // dial the year; simple; the whole of time-travel is a phone number
        the_keypad [+Lesson]

        evt the_phrase_planted [&Introduces(object=being_excellent)]
        evt party_on_planted   [&Introduces(object=party_on)]
        // ChekhovsGun — "Be excellent to each other" and "party on, dudes" introduced together; both guns loaded
        evt be_excellent_opens [&Opens(motif=being_excellent)]
        evt party_on_opens     [&Opens(motif=party_on)]
        // BookEnds — motif planted at the structural open; will close at the stinger's inversion

        evt the_booth_is_cool [&Frames(agent=author, target=the_phone_booth, as=cool)]
        // RuleOfCool — the phone booth materialising out of nowhere, wires trailing: impossible and perfect
      }

      beat threshold_crossed {
        // The refusal collapses into demonstration; the boys cross the threshold
        evt skepticism [&Doubts(agent=bill, claim=time_travel)]
            dialog(inject=[speaker=bill, target=ted],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the specific disbelief of someone who has never tried to think critically"
                   tone: baffled
                   text: "Dude — this is a phone booth."
                   motivation: "the refusal beat; the tool is literally in front of them and they can't see it yet"
                   """)

        evt the_first_jump [&Arrives(agent=bill, location=napoleon_paris_1815)]
            dialog(inject=[speaker=ted],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   cue: "the delivery that launched the franchise — absolute sincerity, no irony whatsoever"
                   tone: reverent
                   text: "Strange things are afoot at the Circle K."
                   motivation: "the refusal is over; the boys have seen the booth work; Ted names what the film is now about; the Circle K is the mundane anchor for the extraordinary"
                   """)
        the_circle_k [+Conspicuous]  // the landmark that is always already there; the ordinary world's axis
        bill [-OrdinaryWorld]
        ted  [-OrdinaryWorld]
        // RefusalOfTheCall → immediate collapse into first crossing; threshold crossed

        evt the_quest_begins [&Quests(agent=bill, for=the_report)]
        // TheQuest — the mission is active; the quest through time is underway

        evt the_report_pursued [&Pursued(agent=bill, other=the_report)]
        evt the_report_pursued_ted [&Pursued(agent=ted, other=the_report)]
        // MacGuffin_Driver — two parties in pursuit of the same object
      }
    }

  }

  // ── ACT 2 · THE ROAD OF TRIALS ──────────────────────────────────────────

  act the_road_of_trials {

    // ── Leg 1: Napoleon ────────────────────────────────────────────────────

    scene napoleon_extraction @@ napoleon_paris_1815 {
      // Story-time: 1815 Paris; syuzhet intercuts with Napoleon's solo arc in san_dimas_1988
      beat the_capture {
        // The capture — bill's blissful ignorance of military history in action
        evt arrive_napoleon [&Arrives(agent=bill, location=napoleon_paris_1815)]
        evt arrive_napoleon_ted [&Arrives(agent=ted, location=napoleon_paris_1815)]
        evt the_capture [&Captures(agent=bill, target=napoleon)]
            dialog(inject=[speaker=bill, target=napoleon],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the confused sincerity of a total stranger treating a warlord like a buddy"
                   tone: cheerful
                   text: "Dude — you're coming with us. For a history report. You'll love it. San Dimas, California, 1988."
                   motivation: "{speaker} has no idea he should be afraid; Napoleon has no idea what's happening"
                   """)
        // Bill's entire historiography of Napoleon: "He was a short dude who lived a long time ago."
        // This line IS the history report on Napoleon; it is complete to Bill; the audience knows more.
        napoleon [+Diminutive]  // re-assert: the height is the first fact Bill knows about him
        napoleon @@ napoleon_paris_1815 -- napoleon @@ san_dimas_1988 : "Displaced"
        napoleon [+Displaced] [+Stranger]
      }

      beat napoleon_in_booth {
        // Napoleon inside the booth — the gag is that confinement makes the Emperor maximally furious;
        // the boys attempt communication; the booth becomes a diplomatic incident at 55 mph through time
        evt napoleon_in_booth [&Wanders(agent=napoleon, location=the_phone_booth)]
            dialog(inject=[speaker=napoleon, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "imperial displeasure in a six-by-four-foot box — Napoleon at maximum indignation"
                   tone: furious
                   text:
                     - "Napoleon gestures at the walls, the ceiling, the impossible speed outside the windows. He shouts. None of it is in English."
                     - "Bill nods along supportively. 'Totally, dude.'"
                   motivation: "the language barrier is the joke — Napoleon's fury is completely reasonable and completely useless"
                   """)
        napoleon [#Enraged]
        bill [+Embattled]
        // Thread: the boys have no plan for what happens once they have a figure in the booth
      }
    }

    scene napoleon_goes_wild @@ san_dimas_1988 {
      // Napoleon's solo B-plot: three beats track his spiral from wonder to conquest
      beat ice_cream {
        // First contact with modernity — ice cream at the Circle K;
        // the conqueror encounters something he cannot defeat
        evt napoleon_solo [&Wanders(agent=napoleon, location=san_dimas_1988)]
        obj the_ice_cream [+Mundane]
        evt napoleon_ice_cream [&Discovers(agent=napoleon, obj=the_ice_cream)]
            dialog(inject=[speaker=napoleon],
                   inline="""
                   kind: narration
                   cue: "the camera holds on his face for a full three seconds"
                   tone: reverent
                   text: "Napoleon is given a cup of vanilla ice cream at a Circle K. He takes a bite. He looks up. He has never made this face. This face says: I have conquered Europe and none of it was this."
                   motivation: "the pure wonder beat before the comedy escalates — Napoleon as child, not tyrant"
                   """)
        napoleon -- the_circle_k : "Visits"
        napoleon -- the_ice_cream : "First contact"
        napoleon [-Enraged] [+Obsessed]
        napoleon -- the_ice_cream : "Claims"

        evt napoleon_discovery_framed [&Frames(agent=author, target=napoleon, as=comic)]
        // RuleOfFunny — Napoleon's imperial face meeting a Styrofoam cup of soft-serve:
        //   the dignity gap between subject and reaction IS the gag
      }

      beat bowling_and_jersey {
        // Escalation: the bowling alley; Napoleon discovers competition and an unfortunate jersey number
        evt napoleon_bowling [&Wanders(agent=napoleon, location=the_mall)]
            dialog(inject=[speaker=napoleon],
                   inline="""
                   kind: narration
                   cue: "rapid montage in the register of a nature documentary"
                   tone: escalating
                   text: "Napoleon moves through the world like a man who has conquered it before and is now doing it again for fun. Bowling pins go down. He expects applause. He receives none. He demands it. He receives some."
                   motivation: "the B-plot gathering momentum — each venue a new kingdom; the bowling alley is the warm-up"
                   """)
        obj the_bowling_pins [+Mundane]
        napoleon -- the_bowling_pins : "Defeats"

        // Napoleon selects jersey #69; the boys see the number; he has no idea why this is funny
        obj napoleons_hat [+IconicItem]
        evt napoleon_jersey [&Discovers(agent=napoleon, obj=napoleons_hat)]
            dialog(inject=[speaker=napoleon],
                   inline="""
                   kind: narration
                   cue: "Napoleon holds up the jersey. Bill and Ted see the number. They exchange a look. Napoleon puts it on with maximum dignity."
                   tone: oblivious
                   text: "Napoleon selects jersey number 69. He has chosen it because it is the largest number available. The boys do not explain. They cannot explain."
                   motivation: "the gap between Napoleon's obliviousness and the boys' awareness is the gag; the dignity makes it perfect"
                   """)
        // RuleOfFunny: the joke depends entirely on Napoleon's complete sincerity
      }

      beat waterpark {
        // Peak: the waterpark — grandiosity meets the most childish venue possible
        obj the_waterslide [+Mundane]
        evt napoleon_waterpark [&Discovers(agent=napoleon, obj=the_waterslide)]
            dialog(inject=[speaker=napoleon],
                   inline="""
                   kind: narration
                   cue: "silent comedy — wide-eyed awe of a conqueror who has found his heaven"
                   tone: exhilarated
                   text: "Napoleon conquers the waterpark — sliding the same chute seventeen times, shouting in French, soaking everyone within ten feet. On the eighteenth run he has acquired a floaty ring. He doesn't know where it came from."
                   motivation: "the pratfall peak: grandiosity applied to the most childish venue possible; the floaty ring is the detail that perfects it"
                   """)
        napoleon [+Obsessed]
        the_waterslide [+Contested]
        napoleon -- the_waterslide : "Claims"

        evt napoleon_pratfall [&Frames(agent=author, target=napoleon, as=comic)]
        // Pratfall — the Emperor of France, in full regalia, soaked and shrieking on a waterslide:
        //   [+Dignified] + [+Hurt] + framed comic = the purest pratfall shape in the film
        // Rule_Of_Funny fires on the same framing event
      }
    }

    // ── Leg 2: Historical collection — one beat per era stop ───────────────

    scene collecting_the_figures {

      beat billy {
        // Billy the Kid — american_frontier
        // The first recruitment; bill's method is pure friendliness; it has no right to work
        evt collect_billy [&Captures(agent=bill, target=billy_the_kid)] @@ american_frontier
            dialog(inject=[speaker=bill, target=billy_the_kid],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "like recruiting for a garage band, not kidnapping a gunslinger"
                   tone: breezy
                   text: "Billy! Dude! Excellent! We're on a mission — you in?"
                   motivation: "Bill's entire approach is friendliness; the audacity works because everyone is charmed; Billy has been waiting his whole life for someone to ask like this"
                   """)
        billy_the_kid @@ american_frontier -- billy_the_kid @@ san_dimas_1988 : "Displaced"
        billy_the_kid [+Displaced]

        evt billy_transgresses [&Transgresses(agent=billy_the_kid)]
        // LovableRogue — Billy is a wanted outlaw; the boys recruit him anyway because he's charming
      }

      beat socrates {
        // Socrates — ancient_greece
        // Ted attempts philosophy; the misquotation is sincere and, somehow, correct
        evt collect_socrates [&Captures(agent=ted, target=socrates)] @@ ancient_greece
            dialog(inject=[speaker=ted, target=socrates],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the most earnest misquotation in cinematic history"
                   tone: solemn
                   text: "Soh-crates — [beat] — 'The only true wisdom is in knowing you know nothing.' [beat] That's us, dude."
                   motivation: "{speaker} is trying to speak philosophy; the misquotation is accidentally perfect; Socrates recognises something in it"
                   """)
        socrates @@ ancient_greece -- socrates @@ san_dimas_1988 : "Displaced"
        socrates [+Displaced]
      }

      beat joan_and_princesses {
        // Joan of Arc — medieval_england
        // Bill's respectful ignorance; Ted's correction; the beat that defines their partnership dynamic
