// @title   Bill & Ted's Excellent Adventure
// @medium  Feature Film
// @format  Time-travel comedy; three-act structure + epilogue
// @domain  Contemporary Comedy / Bildungsroman / Science Fiction
// @version 2.0

import "trl/modules/index.trl"

// ===== WORK =====
work the_film [%Feature]

// ===== STORY-TIME (fabula) — the chronological spine =====
// Each ~> link encodes "came before in the world"
// The syuzhet visits these out of order; @@ anchors displace references

// Fabula left-to-right, real-world time
chron ancient_greece ~> medieval_england ~> renaissance_austria
    ~> american_frontier ~> napoleon_paris_1815 ~> san_dimas_1988
    ~> san_dimas_future_2688

// ===== CAST =====
char bill           [+Protagonist] [+Everyman] [+Innocent] [+Weak] [+Dynamic] [+OrdinaryWorld]
                    [+Inseparable] [+Masculine] [@Bonded_To(other=ted)]
char ted            [+Protagonist] [+Everyman] [+Innocent] [+Weak] [+Dynamic] [+OrdinaryWorld]
                    [+Inseparable] [+Masculine] [@Bonded_To(other=bill)]
char rufus          [+Mentor] [+TheHerald] [@Mentor_Of(student=bill)]
char napoleon       [+Historical] [+Arrogant] [+Antagonist] [+Dignified] [+Hurt] [+Stranger]
char socrates       [+Historical] [+Wise] [+Stranger]
char joan_of_arc    [+Historical] [+Hero] [+Stranger]
char genghis_khan   [+Historical] [+Antagonist] [+Dignified] [+Hurt] [+Stranger]
char billy_the_kid  [+Historical] [+Roguish] [+Sympathetic] [+Ally] [+Stranger]
char freud          [+Historical] [+Stranger]
char beethoven      [+Historical] [+Stranger]
char lincoln        [+Historical] [+Authority] [+Ally] [+Stranger]
char missy          [+Ally] [+ParentalSubstitute]
char mr_ryan        [+Antagonist] [+Authority]
char captain_logan  [+Antagonist] [+Authority] [+Paternal]  // Ted's father; military-school threat
char elizabeth      [+LoveInterest] [+Stranger]             // Bill's destined princess; medieval England
char joanna         [+LoveInterest] [+Stranger]             // Ted's destined princess; medieval England
char station        [+Mentor]
char death          [+Antagonist]
char evil_bill      [+Antagonist] [+Foil]               // Bogus Journey; mirror of bill
char evil_ted       [+Antagonist] [+Foil]               // Bogus Journey; mirror of ted

// ===== OBJECTS =====
obj the_phone_booth     [+MacGuffin] [+Objective] [+Coveted]
obj the_report          [+MacGuffin] [+Objective] [+Lesson] [+Coveted]
obj the_history_book    [+Lesson]
obj rufus_guitar        [+Symbolic]
obj napoleons_hat       [+IconicItem]
obj the_waterslide      [+Mundane]
obj the_ice_cream       [+Mundane]
obj the_bogus_journey   [+SequelBait]                   // the threat of the evil doubles
obj the_circuits        [+Symbolic]

// ===== SETS =====
set san_dimas_1988          [+Suburban] [+OrdinaryWorld]
set the_garage_set          [+Interior] [+Isolated]
set the_school              [+Interior] [+HighStakes]
set the_future_city         [+Utopia] [+HighTech]
set medieval_england        [+Exterior] [+Exotic]
set ancient_greece          [+Exterior] [+Exotic]
set renaissance_austria     [+Exterior] [+Exotic]
set american_frontier       [+Exterior] [+Exotic]
set napoleon_paris_1815     [+Exterior] [+Exotic]
set san_dimas_future_2688   [+Utopia] [+Exterior]
set the_mall                [+Exterior] [+Crowded]
set the_mall_interiors      [+Interior] [+Crowded]
set the_jail                [+Interior] [+Isolated]
set the_auditorium          [+Interior] [+HighStakes] [+Climax]

// ===== CONCEPTS =====
concept history             [+Abstract] [+Lesson]
concept time_travel         [+Abstract]
concept being_excellent     [+Abstract] [+Lesson] [+Conspicuous]   // the phrase that opens, recurs, and closes
concept the_journey         [+Abstract]             // the time-travel ordeal that forges the boys
concept the_utopia          [+Abstract]             // the future society predicated on B&T's music
concept wyld_stallyns       [+Abstract]             // the band — the private dream that gives the stakes meaning

// ===== SEEDS — latent threads that surface later =====
?bill [~Pursues(goal=the_report)]?
?ted  [~Pursues(goal=the_report)]?
*(the_phone_booth [+Trap] | the_phone_booth [+Gift])* as booth_nature
?bill [~Pursues(goal=being_excellent)]?
?ted  [~Pursues(goal=being_excellent)]?
// Romantic seeds — planted early, never resolved in this film; the sequel's payoff
?bill [~Loves(target=missy)]?       // the faux-Oedipal attraction; Freud will name it
?ted  [~Loves(target=missy)]?       // his own father's partner; same dynamic, worse geometry
?bill [~Loves(target=elizabeth)]?   // the princess seen through the window; surfaces in Bogus Journey
?ted  [~Loves(target=joanna)]?      // same

// ===== LOG =====

arc bill_and_ted_journey [+TheQuest] [+ComingOfAge] {

  // ── ACT 1 · THE ORDINARY WORLD ──────────────────────────────────────────

  act the_ordinary_world {

    scene the_garage_scene @@ san_dimas_1988 {
      beat 1 {
        // The bond and the stakes: two threads established simultaneously
        bill @ san_dimas_1988
        ted  @ san_dimas_1988
        bill [+Dreamer]
        ted  [+Dreamer]
        bill [#Failing]
        ted  [#Failing]

        evt the_bond [&Cherishes(agent=bill, other=ted)]
        // HeterosexualLifePartners — the Wyld Stallyns pact is the "couple" the stakes threaten

        evt the_stakes [&Reveals(agent=mr_ryan, target=bill)]
            dialog(inject=[speaker=mr_ryan, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "flat authority — this is not a threat, it is a fact"
                   tone: stern
                   text: "You have one week to pass history. Fail, and Ted goes to military school. Wyld Stallyns ends."
                   motivation: "{speaker} is removing the safety net — the boys have to care about history now"
                   """)
        the_report [+MacGuffin]
        bill [~Pursues(goal=the_report)]   // latent seed surfaces
        ted  [~Pursues(goal=the_report)]
      }

      beat 2 {
        // Thread B: what Wyld Stallyns actually is — the private vision that makes the stakes matter
        // The air guitar is RuleOfCool applied to nothing: the virtuosity is entirely imaginary,
        // which is both the gag and the point
        evt the_air_guitar [&Performs(agent=bill, location=the_garage_set)]
            dialog(inject=[speaker=bill, target=ted],
                   inline="""
                   kind: narration
                   cue: "lit from below by the single bare bulb; the camera treats this with complete sincerity"
                   tone: earnest
                   text: "Bill picks up an invisible guitar. Ted nods. They play. No sound comes out. The performance is flawless."
                   motivation: "the joke is that the camera doesn't blink — the movie believes in them, so we do too"
                   """)
        bill -- wyld_stallyns : "Co-founder"
        ted  -- wyld_stallyns : "Co-founder"
        wyld_stallyns [+Coveted] [+Symbolic]

        evt air_guitar_framed [&Frames(agent=author, target=wyld_stallyns, as=cool)]
        // RuleOfCool — the visual gag that establishes the film's entire tonal register:
        //   nothing is happening and it is magnificent

        evt wyld_stallyns_introduced [&Introduces(object=wyld_stallyns)]
        // The band is the real Chekhov's Gun; the report is just the mechanism that forces them to grow
      }
    }

    scene the_family_web @@ san_dimas_1988 {
      // The geometry of the obstacle: two authority figures, one shared woman, one impossible attraction
      beat 3 {
        // Thread A: Captain Logan — the paternal obstacle who actually holds the Alaska threat
        captain_logan @ san_dimas_1988
        captain_logan -- ted : "Father"
        captain_logan [~Desires(target=the_report)]   // wants the boys to fail; confirms the threat

        evt logan_threatens [&Reveals(agent=captain_logan, target=ted)]
            dialog(inject=[speaker=captain_logan, target=ted],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the specific disappointment of a man who expected more and has stopped being surprised"
                   tone: clipped
                   text: "One week. History report. You fail, you're on a plane. I've already called the school."
                   motivation: "{speaker} is not the villain — he's a reasonable man whose son has given him nothing to work with"
                   """)

        // Thread B: Missy — the family-web knot
        // Missy was married to Bill's dad; now she's with Captain Logan; both boys call her something different
        missy [@Married(partner=captain_logan)]
        missy -- bill : "Former stepmom"
        missy -- ted  : "Father's partner"

        evt bill_sees_missy [&Meets(agent=bill, other=missy)]
            dialog(inject=[speaker=bill, target=missy],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the specific discomfort of a teenage boy greeting his former stepmother who is now at his best friend's house"
                   tone: awkward
                   text: "'Oh. Hey. [pause] ...Mom.'"
                   motivation: "one word; contains multitudes; the film's densest gag — the Oedipus complex already installed and acknowledged in a single syllable"
                   """)
        bill [~Loves(target=missy)]   // latent seed surfaces as acknowledgment; immediately suppressed
        ted  [~Loves(target=missy)]   // same geometry; worse because captain_logan is his actual father
        // LoveTriangle seeds: bill and ted both love missy; both suppress it; Freud will find it anyway
      }

      beat 4 {
        // Thread C: Missy as ally — she's actually kind to the boys despite the geometry
        // The ParentalSubstitute is genuine; the attraction is real but unspoken; both things are true
        evt missy_helps [&Aided(other=bill)]
            dialog(inject=[speaker=missy, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the warmth of someone who doesn't hold the geometry against them"
                   tone: kind
                   text: "You boys need anything? I made sandwiches. [beat] The good kind."
                   motivation: "{speaker} is the only adult who isn't an obstacle — her kindness is the inverse of {target}'s father's coldness"
                   """)
        missy [+Ally]
        // The ParentalSubstitute thread: Missy is the warm adult the boys actually have,
        //   despite — or because of — the impossible family geometry she occupies
      }
    }

    scene the_herald_arrives @@ san_dimas_1988 {
      beat 5 {
        // Rufus arrives; the phrase is planted; the booth is delivered
        evt rufus_descends [&Arrives(agent=rufus, location=san_dimas_1988)]
            dialog(inject=[speaker=rufus],
                   inline="""
                   kind: monologue
                   speaker: "{speaker}"
                   cue: "low-key reverence — the future's most important mission, delivered like a routine errand"
                   tone: warm
                   text: "I can't tell you who I am or why I've come, but I can tell you that the future of the world is in your hands. Be excellent to each other. And party on, dudes."
                   motivation: "{speaker} seeds the mission without explaining it — the audience is ahead of the boys"
                   """)
        rufus > the_phone_booth : "Delivers"
        resolve booth_nature -> the_phone_booth [+Gift]
        !the_phone_booth [+Gift]!

        evt the_call [&Calls(agent=rufus, target=bill)]
        // CallToAdventure

        evt rufus_teaches [&Teaches(agent=rufus, target=bill)]
        // MentorAndStudent — rufus shows them how the booth works; the lesson that unlocks the quest

        evt the_phrase_planted [&Introduces(object=being_excellent)]
        // ChekhovsGun — "Be excellent to each other" is introduced; the gun is now loaded
        evt be_excellent_opens [&Opens(motif=being_excellent)]
        // BookEnds — motif planted at the structural open; will close at the stinger's inversion

        evt the_booth_is_cool [&Frames(agent=author, target=the_phone_booth, as=cool)]
        // RuleOfCool — the phone booth materialising out of nowhere, wires trailing: impossible and perfect
      }

      beat 6 {
        // The refusal collapses into demonstration; the boys cross the threshold
        evt skepticism [&Doubts(agent=bill, claim=time_travel)]
            dialog(inject=[speaker=bill, target=ted],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the specific disbelief of someone who has never tried to think critically"
                   tone: baffled
                   text: "Dude — this is a phone booth."
                   motivation: "the refusal beat; the tool is literally in front of them and they can't see it yet"
                   """)

        evt the_first_jump [&Arrives(agent=bill, location=napoleon_paris_1815)]
            dialog(inject=[speaker=ted],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   cue: "the delivery that launched the franchise — absolute sincerity, no irony whatsoever"
                   tone: reverent
                   text: "Strange things are afoot at the Circle K."
                   motivation: "the refusal is over; the boys have seen the booth work; Ted names what the film is now about"
                   """)
        bill [-OrdinaryWorld]
        ted  [-OrdinaryWorld]
        // RefusalOfTheCall → immediate collapse into first crossing; threshold crossed

        evt the_quest_begins [&Quests(agent=bill, for=the_report)]
        // TheQuest — the mission is active; the quest through time is underway

        evt the_report_pursued [&Pursued(agent=bill, other=the_report)]
        evt the_report_pursued_ted [&Pursued(agent=ted, other=the_report)]
        // MacGuffin_Driver — two parties in pursuit of the same object
      }
    }

  }

  // ── ACT 2 · THE ROAD OF TRIALS ──────────────────────────────────────────

  act the_road_of_trials {

    // ── Leg 1: Napoleon ────────────────────────────────────────────────────

    scene napoleon_extraction @@ napoleon_paris_1815 {
      // Story-time: 1815 Paris; syuzhet intercuts with Napoleon's solo arc in san_dimas_1988
      beat 7 {
        // The capture — bill's blissful ignorance of military history in action
        evt arrive_napoleon [&Arrives(agent=bill, location=napoleon_paris_1815)]
        evt arrive_napoleon_ted [&Arrives(agent=ted, location=napoleon_paris_1815)]
        evt the_capture [&Captures(agent=bill, target=napoleon)]
            dialog(inject=[speaker=bill, target=napoleon],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the confused sincerity of a total stranger treating a warlord like a buddy"
                   tone: cheerful
                   text: "Dude — you're coming with us. For a history report. You'll love it. San Dimas, California, 1988."
                   motivation: "{speaker} has no idea he should be afraid; Napoleon has no idea what's happening"
                   """)
        napoleon @@ napoleon_paris_1815 -- napoleon @@ san_dimas_1988 : "Displaced"
        napoleon [+Displaced] [+Stranger]
      }

      beat 8 {
        // Napoleon inside the booth — the gag is that confinement makes the Emperor maximally furious;
        // the boys attempt communication; the booth becomes a diplomatic incident at 55 mph through time
        evt napoleon_in_booth [&Wanders(agent=napoleon, location=the_phone_booth)]
            dialog(inject=[speaker=napoleon, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "imperial displeasure in a six-by-four-foot box — Napoleon at maximum indignation"
                   tone: furious
                   text:
                     - "Napoleon gestures at the walls, the ceiling, the impossible speed outside the windows. He shouts. None of it is in English."
                     - "Bill nods along supportively. 'Totally, dude.'"
                   motivation: "the language barrier is the joke — Napoleon's fury is completely reasonable and completely useless"
                   """)
        napoleon [#Enraged]
        bill [+Embattled]
        // Thread: the boys have no plan for what happens once they have a figure in the booth
      }
    }

    scene napoleon_goes_wild @@ san_dimas_1988 {
      // Napoleon's solo B-plot: two beats track his spiral from wonder to conquest
      beat 9 {
        // First contact with modernity — ice cream; the conqueror encounters something he cannot defeat
        evt napoleon_solo [&Wanders(agent=napoleon, location=san_dimas_1988)]
        evt napoleon_ice_cream [&Discovers(agent=napoleon, obj=the_ice_cream)]
            dialog(inject=[speaker=napoleon],
                   inline="""
                   kind: narration
                   cue: "the camera holds on his face for a full three seconds"
                   tone: reverent
                   text: "Napoleon is given a cup of vanilla ice cream at a Circle K. He takes a bite. He looks up. He has never made this face. This face says: I have conquered Europe and none of it was this."
                   motivation: "the pure wonder beat before the comedy escalates — Napoleon as child, not tyrant"
                   """)
        napoleon [-Enraged] [+Obsessed]
        napoleon -- the_ice_cream : "Claims"

        evt napoleon_discovery_framed [&Frames(agent=author, target=napoleon, as=comic)]
        // RuleOfFunny — Napoleon's imperial face meeting a Styrofoam cup of soft-serve:
        //   the dignity gap between subject and reaction IS the gag
      }

      beat 10 {
        // Escalation: bowling → waterpark; the pratfall apex
        evt napoleon_bowling [&Wanders(agent=napoleon, location=the_mall)]
            dialog(inject=[speaker=napoleon],
                   inline="""
                   kind: narration
                   cue: "rapid montage in the register of a nature documentary"
                   tone: escalating
                   text: "Napoleon moves through the world like a man who has conquered it before and is now doing it again for fun. Bowling pins go down. He expects applause. He receives none. He demands it. He receives some."
                   motivation: "the B-plot gathering momentum — each venue a new kingdom"
                   """)

        evt napoleon_waterpark [&Discovers(agent=napoleon, obj=the_waterslide)]
            dialog(inject=[speaker=napoleon],
                   inline="""
                   kind: narration
                   cue: "silent comedy — wide-eyed awe of a conqueror who has found his heaven"
                   tone: exhilarated
                   text: "Napoleon conquers the waterpark — sliding the same chute seventeen times, shouting in French, soaking everyone within ten feet. On the eighteenth run he has acquired a floaty ring. He doesn't know where it came from."
                   motivation: "the pratfall peak: grandiosity applied to the most childish venue possible"
                   """)
        napoleon [+Obsessed]
        the_waterslide [+Contested]
        napoleon -- the_waterslide : "Claims"

        evt napoleon_pratfall [&Frames(agent=author, target=napoleon, as=comic)]
        // Pratfall — the Emperor of France, in full regalia, soaked and shrieking on a waterslide:
        //   [+Dignified] + [+Hurt] + framed comic = the purest pratfall shape in the film
        // Rule_Of_Funny fires on the same framing event
      }
    }

    // ── Leg 2: Historical collection — two beats, split by era ──────────────

    scene collecting_the_figures {
      beat 11 {
        // Early stops: the frontier and the ancient world
        // Billy the Kid — american_frontier
        evt collect_billy [&Captures(agent=bill, target=billy_the_kid)] @@ american_frontier
            dialog(inject=[speaker=bill, target=billy_the_kid],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "like recruiting for a garage band, not kidnapping a gunslinger"
                   tone: breezy
                   text: "Billy! Dude! Excellent! We're on a mission — you in?"
                   motivation: "Bill's entire approach is friendliness; the audacity works because everyone is charmed"
                   """)
        billy_the_kid @@ american_frontier -- billy_the_kid @@ san_dimas_1988 : "Displaced"
        billy_the_kid [+Displaced]

        evt billy_transgresses [&Transgresses(agent=billy_the_kid)]
        // LovableRogue — Billy is a wanted outlaw; the boys recruit him anyway because he's charming

        // Socrates — ancient_greece
        evt collect_socrates [&Captures(agent=ted, target=socrates)] @@ ancient_greece
            dialog(inject=[speaker=ted, target=socrates],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the most earnest misquotation in cinematic history"
                   tone: solemn
                   text: "Soh-crates — [beat] — 'The only true wisdom is in knowing you know nothing.' [beat] That's us, dude."
                   motivation: "{speaker} is trying to speak philosophy; the fact that it works is the joke"
                   """)
        socrates @@ ancient_greece -- socrates @@ san_dimas_1988 : "Displaced"
        socrates [+Displaced]

        // Joan of Arc — medieval_england
        evt collect_joan [&Captures(agent=bill, target=joan_of_arc)] @@ medieval_england
            dialog(inject=[speaker=bill, target=joan_of_arc],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "Bill addresses her with the specific reverence of someone who definitely doesn't remember who she is"
                   tone: respectful
                   text: "'Joan — of Arc — [long pause] — Noah's wife? [ted shakes head] Excellent warrior babe? [ted nods]'"
                   motivation: "the joke lands via ted's correction; bill is guessing and somehow respectful about it"
                   """)
        joan_of_arc @@ medieval_england -- joan_of_arc @@ san_dimas_1988 : "Displaced"
        joan_of_arc [+Displaced]

        // Thread B: the princess sighting — through a window in the castle; the romantic seeds planted
        evt princess_sighting [&Meets(agent=bill, other=elizabeth)] @@ medieval_england
        evt princess_sighting_2 [&Meets(agent=ted, other=joanna)] @@ medieval_england
            dialog(inject=[speaker=bill, target=ted],
                   inline="""
                   kind: narration
                   cue: "the camera slows; the comedy register lifts for exactly four seconds"
                   tone: hushed
                   text: "Through the window: two women. They look down. The boys look up. Nobody moves. Then Rufus, without looking, closes the booth door."
                   motivation: "the romantic subplot in embryo — a glimpse through glass across six centuries; the sequel's entire premise fits in four seconds"
                   """)
        bill [~Loves(target=elizabeth)]   // latent seed surfaces; immediately sealed in the booth
        ted  [~Loves(target=joanna)]      // same
        // StarCrossed seeds: across time, across history; they can't stay — and they both know it
        elizabeth [+Stranger] [+LoveInterest]
        joanna    [+Stranger] [+LoveInterest]
      }

      beat 12 {
        // Later stops: medieval Asia, Renaissance Europe, the American frontier again
        evt collect_genghis [&Captures(agent=ted, target=genghis_khan)] @@ medieval_england
            dialog(inject=[speaker=ted, target=genghis_khan],
                   inline="""
                   kind: narration
                   cue: "ted's face in close-up when he sees who he's picking up"
                   tone: nervous
                   text: "Ted finds Genghis Khan at the height of his power and offers him a Twinkie. Genghis Khan eats the Twinkie. This is, somehow, enough."
                   motivation: "the gag is the negotiation technique: bribery via junk food; it shouldn't work; it does"
                   """)
        genghis_khan @@ medieval_england -- genghis_khan @@ san_dimas_1988 : "Displaced"
        genghis_khan [+Displaced]

        evt collect_freud [&Captures(agent=bill, target=freud)] @@ renaissance_austria
        freud @@ renaissance_austria -- freud @@ san_dimas_1988 : "Displaced"
        freud [+Displaced]

        evt collect_beethoven [&Captures(agent=bill, target=beethoven)] @@ renaissance_austria
            dialog(inject=[speaker=beethoven, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "beethoven trying to lip-read bill; bill trying to mime a guitar; the pantomime of mutual incomprehension"
                   tone: earnest
                   text: "Beethoven watches Bill's air guitar mime. He cocks his head. He mimes back. It's different — better. Bill is delighted."
                   motivation: "the air guitar callback: the film's own visual language bridges the language barrier; Beethoven instantly speaks Wyld Stallyns"
                   """)
        beethoven @@ renaissance_austria -- beethoven @@ san_dimas_1988 : "Displaced"
        beethoven [+Displaced]

        evt collect_lincoln [&Captures(agent=ted, target=lincoln)] @@ american_frontier
        lincoln @@ american_frontier -- lincoln @@ san_dimas_1988 : "Displaced"
        lincoln [+Displaced]

        // The air guitar callback: beethoven understands the language that the boys invented
        beethoven -- wyld_stallyns : "Fluent"
        // The booth is now carrying eight historical figures through time simultaneously
        the_phone_booth [+Contested]
      }
    }

    // ── Leg 3: Mall sequence — the figures loose in 1988 ─────────────────

    scene the_mall_sequence @@ san_dimas_1988 {
      beat 13 {
        // All displaced figures co-present; three comedy set-pieces run simultaneously
        evt figures_loose [&Wanders(agent=billy_the_kid, location=the_mall_interiors)]
        evt figures_loose_2 [&Wanders(agent=beethoven, location=the_mall_interiors)]
        evt figures_loose_3 [&Wanders(agent=joan_of_arc, location=the_mall_interiors)]
        evt figures_loose_4 [&Wanders(agent=genghis_khan, location=the_mall_interiors)]

        evt beethoven_discovers_keyboards [&Discovers(agent=beethoven, obj=the_mall_interiors)]
            dialog(inject=[speaker=beethoven],
                   inline="""
                   kind: narration
                   cue: "pure joy — a deaf composer hearing himself for the first time in years through electric amplification"
                   tone: exhilarated
                   text: "Beethoven finds the music store. He sits at a synthesizer, plays one chord, and looks up — not with confusion but recognition. He proceeds to shred. A crowd gathers. They think it's a promotional event."
                   motivation: "the joke is that Beethoven is not confused by the piano at all; his genius translates immediately — across two centuries, the Wyld Stallyns language worked"
                   """)

        evt beethoven_shreds [&Frames(agent=author, target=beethoven, as=cool)]
        // RuleOfCool — a deaf 18th-century composer sits at a synthesizer and immediately shreds

        evt joan_leads_aerobics [&Leads(agent=joan_of_arc, group=the_mall_interiors)]
            dialog(inject=[speaker=joan_of_arc],
                   inline="""
                   kind: narration
                   cue: "absolute authority — she has led armies; she can lead an aerobics class"
                   tone: commanding
                   text: "Joan commandeers an aerobics studio and runs it like a military drill. The class doesn't question her. She has that energy. She always had that energy."
                   motivation: "Joan's warrior competence applied sideways — the joke is that she's not out of place at all, just in a different arena"
                   """)

        evt genghis_destroys_toys [&Strikes(agent=genghis_khan, target=the_mall)]
        the_mall [=Damaged]

        evt genghis_framed_comic [&Frames(agent=author, target=genghis_khan, as=comic)]
        // RuleOfFunny — the Great Khan rampaging through a toy aisle: [+Dignified] conqueror
        //   humiliated by bright plastic; the harm is conspicuously not the point

        // Thread B: Freud observes; the diagnosis arrives
        // Freud has been silently watching all of this. He has been taking notes.
        evt freud_observes [&Speaks(agent=freud, location=the_mall_interiors)]
            dialog(inject=[speaker=freud, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the specific serenity of a man who has just confirmed his entire life's work"
                   tone: satisfied
                   text: "Ze Oedipus complex."
                   motivation: "{speaker} has watched bill and ted navigate the Missy geometry for two scenes; three words are sufficient; he resumes his notes"
                   """)
        // The diagnosis fires on what was planted in beat 3: bill and ted's latent loves
        //   for missy, their shared quasi-parent, named by the one displaced figure whose
        //   entire professional framework was built for exactly this situation
        bill [#Confronted(other=freud)]   // the mirror is held up; he does not look at it
        ted  [#Confronted(other=freud)]   // same
      }

      beat 14 {
        // The arrest — mid-act complication; figures rounded up; the quest seems over
        evt the_arrest [&Captures(agent=mr_ryan, target=bill)]
        evt the_arrest_2 [&Captures(agent=mr_ryan, target=ted)]
            dialog(inject=[speaker=mr_ryan, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the cold satisfaction of an obstacle who has been waiting for this"
                   tone: flat
                   text: "The report is tomorrow. You will not be there. Ted will be on a plane to Alaska by morning."
                   motivation: "{speaker} at maximum power — the dark night of the soul; the quest seems over"
                   """)
        bill [#Jailed]
        ted  [#Jailed]
        the_report [+Threatened]

        evt the_trial [&Tested(subject=bill, by=the_report)]
        // ComingOfAge — the arrest is the ordeal that tests the boys' commitment; innocence ends here
      }
    }

    // ── Leg 4: Escape and the race to school ─────────────────────────────

    scene the_escape @@ san_dimas_1988 {
      beat 15 {
        // The displaced figures repay the boys; the role reversal completes
        evt billy_springs_them [&Liberates(agent=billy_the_kid, target=bill)]
        evt billy_springs_them_2 [&Liberates(agent=billy_the_kid, target=ted)]
            dialog(inject=[speaker=billy_the_kid, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the cheerful competence of someone who has broken out of actual frontier jails"
                   tone: easy
                   text: "Boys. Ready to go? [beat] I've broken out of worse."
                   motivation: "Billy is in his element; the role reversal is complete — the historical figure saves the modern heroes"
                   """)
        bill [-Jailed]
        ted  [-Jailed]
        bill [+Determined]
        ted  [+Determined]
      }

      beat 16 {
        // The race: the alliance in motion; all threads converging on the auditorium
        // The figures who were obstacles are now the rescue; the quest arrives at the climax
        evt the_race [&Pursues(agent=bill, other=the_auditorium)]
        evt the_race_2 [&Pursues(agent=ted, other=the_auditorium)]
            dialog(inject=[speaker=bill, target=ted],
                   inline="""
                   kind: narration
                   cue: "the montage of total commitment — the camera cranked to convey urgency; everyone running"
                   tone: urgent
                   text: "Bill and Ted sprint for the school with eight historical figures in tow. Napoleon is still carrying the floaty ring. Lincoln has to duck through every doorway. Freud is quietly taking notes on all of them."
                   motivation: "the comedy of the chase: the figures are allies now but haven't stopped being themselves — the running gag runs while they run"
                   """)
        lincoln -- bill : "Running with"
        socrates -- ted  : "Running with"
        genghis_khan [+Determined]
        joan_of_arc  [+Determined]
        // The displaced-figures thread: strangers become allies; the quest's gathered cast converges
        the_report [+PendingPayoff]
      }
    }

  }

  // ── ACT 3 · THE ORDEAL & RETURN ─────────────────────────────────────────

  act the_ordeal_and_return {

    scene the_climax @@ san_dimas_1988 {
      beat 17 {
        // Assembly: the auditorium fills; mr_ryan's contempt is on display one last time
        evt the_assembly [&Arrives(agent=lincoln, location=the_auditorium)]
        evt mr_ryan_dismisses [&Doubts(agent=mr_ryan, claim=the_report)]
            dialog(inject=[speaker=mr_ryan, target=bill],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the obstacle at maximum certainty — he knows what he's about to see"
                   tone: dismissive
                   text: "I'm going to give you this one minute, because the rules require it. Then Ted gets on a plane."
                   motivation: "{speaker} is completely confident; the confidence is the setup for the fall"
                   """)
        mr_ryan [+Culpable]
        // The rule_of_drama: the antagonist's certainty is the condition that makes the triumph satisfying

        evt the_presentation_starts [&Performs(agent=bill, location=the_auditorium)]
        evt the_presentation_starts_2 [&Performs(agent=ted, location=the_auditorium)]
        the_auditorium [+Crowded]
      }

      beat 18 {
        // The payoff: Lincoln speaks; the Aesop fires; the quest resolves
        evt lincoln_speaks [&Speaks(agent=lincoln, location=the_auditorium)]
            dialog(inject=[speaker=lincoln],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "the auditorium"
                   cue: "Gettysburg register — he knows how to address a crowd and does not waste the opportunity"
                   tone: solemn
                   text: "Be excellent to each other. [beat] And party on, dudes."
                   motivation: "the film's thesis spoken by its highest-authority voice — the echo of Rufus's opening charge; the Chekhov's Gun discharged at maximum weight"
                   """)

        evt lincoln_fires_the_phrase [&Uses(object=being_excellent)]
        // ChekhovsGun_Fire — "Be excellent to each other" planted by Rufus, now paid off
        //   by the highest-authority voice in the room

        evt the_aesop [&Frames(agent=author, target=being_excellent, as=moral)]
        // An_Aesop — the moral is made explicit through Lincoln; audience is instructed not merely moved

        evt the_triumph [&Delivers(agent=bill, target=the_report)]
        evt the_triumph_2 [&Delivers(agent=ted, target=the_report)]
        the_report [+Resolved]
        bill [-Innocent] [+Mature] [+Triumphant]
        ted  [-Innocent] [+Mature] [+Triumphant]

        evt bill_forged [&Forged(subject=bill, by=the_journey)]
        evt ted_forged  [&Forged(subject=ted,  by=the_journey)]
        // TookALevelInBadass — [+Weak] failing students → flawless time-travel history presentation

        bill [~Pursues(goal=being_excellent)]  // latent seed surfaces at triumph
        ted  [~Pursues(goal=being_excellent)]
      }

      beat 19 {
        // The return: each displaced figure's worldline closes back to its origin
        evt return_napoleon [&Returns(agent=napoleon, target=napoleon_paris_1815)]
            dialog(inject=[speaker=napoleon],
                   inline="""
                   kind: narration
                   cue: "the slightest suggestion of reluctance — the waterpark was good"
                   tone: wistful
                   text: "Napoleon is the last to go. He pauses at the door of the booth, looks back once at the direction of the waterpark, and is gone."
                   motivation: "the button on his solo arc — even a conqueror was conquered by ice cream and centrifugal force"
                   """)
        napoleon @@ san_dimas_1988 -- napoleon @@ napoleon_paris_1815 : "Returns"
        billy_the_kid @@ san_dimas_1988 -- billy_the_kid @@ american_frontier : "Returns"
        socrates @@ san_dimas_1988 -- socrates @@ ancient_greece : "Returns"
        joan_of_arc @@ san_dimas_1988 -- joan_of_arc @@ medieval_england : "Returns"
        genghis_khan @@ san_dimas_1988 -- genghis_khan @@ medieval_england : "Returns"
        freud @@ san_dimas_1988 -- freud @@ renaissance_austria : "Returns"
        beethoven @@ san_dimas_1988 -- beethoven @@ renaissance_austria : "Returns"
        lincoln @@ san_dimas_1988 -- lincoln @@ american_frontier : "Returns"
        // Every @@ worldline instance is now closed — the fabula resolves back to its origins
      }
    }

    scene the_future_glimpsed @@ san_dimas_future_2688 {
      // Epilogue: after(san_dimas_1988, san_dimas_future_2688) — we jump forward
      beat 20 {
        // Rufus's reflection — the question the film never asked, now answered
        evt the_vision [&Reveals(agent=rufus, target=the_utopia)]
            dialog(inject=[speaker=rufus],
                   inline="""
                   kind: monologue
                   speaker: "{speaker}"
                   cue: "warm, unhurried — the mission succeeded; he can finally say so"
                   tone: quiet satisfaction
                   text: "They did it. [beat] The music wasn't even that good yet. But they meant it. That was enough."
                   motivation: "{speaker} resolves the question the film never explicitly asked: why these two?"
                   """)
        the_utopia [+Resolved]

        // Seed resolution: the pursuit of being_excellent was the real quest all along
        bill [~Pursues(goal=being_excellent)]
        ted  [~Pursues(goal=being_excellent)]
        resolve booth_nature -> the_phone_booth [+Gift]   // re-confirm: the booth was never a trap
      }

      beat 21 {
        // The utopia in motion — what the world built from this afternoon in San Dimas
        evt the_utopia_shown [&Reveals(agent=rufus, target=san_dimas_future_2688)]
            dialog(inject=[speaker=rufus],
                   inline="""
                   kind: narration
                   cue: "wide shot of the future city; the visual payoff of the entire mythology"
                   tone: expansive
                   text: "The city is not built from their music. It's built from what their music taught: that being excellent is a practice, not a talent. Rufus watches it. He has been here every day for seven hundred years."
                   motivation: "the utopia is a moral argument made concrete — the visual thesis of the franchise"
                   """)
        bill [+GenreLiterate]
        ted  [+GenreLiterate]
        the_utopia -- being_excellent : "Built from"
        // The wyld_stallyns thread: the band existed to carry the phrase; the phrase built the world
        wyld_stallyns -- the_utopia : "Founded"
      }
    }

  }

  // ── POST-CREDITS — Bogus Journey tease ──────────────────────────────────

  scene the_stinger @ post_credits @@ san_dimas_1988 {
    beat 22 {
      // The threat that will become Part II; the mirror of the thesis
      evt evil_doubles_appear [&Arrives(agent=evil_bill, location=san_dimas_1988)]
      evt evil_doubles_appear_2 [&Arrives(agent=evil_ted, location=san_dimas_1988)]
      evil_bill -- bill : "Mirror"
      evil_ted  -- ted  : "Mirror"

      evt the_sequel_hook [&Teases(agent=the_film, hook=the_bogus_journey)]
      // SequelHook — the Bogus Journey threat is the open thread; confirmed by the evil doubles

      evt the_tease [&Threatens(agent=evil_bill, target=bill)]
          dialog(inject=[speaker=evil_bill, target=bill],
                 inline="""
                 kind: dialog
                 speaker: "{speaker}"
                 addressee: "{target}"
                 cue: "exactly like Bill — same voice, same cadence — except utterly cold"
                 tone: menacing
                 text: "Be excellent to each other. [beat, smile drops] We won't be."
                 motivation: "the mirror of the thesis — same words, inverted ethics; sets up the sequel's stakes without exposition"
                 """)
      evt be_excellent_closes [&Closes(motif=being_excellent)]
      // BookEnds — Rufus planted the phrase (beat 3); Lincoln fired it sincerely (beat 16);
      //   evil_bill echoes it in darkness here. The loop closes; the mirror shows what the phrase
      //   protects against.
    }
  }

}
