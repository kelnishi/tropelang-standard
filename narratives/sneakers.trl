// @title   Sneakers
// @medium  Feature Film
// @format  Heist thriller; three-act structure with prologue and counter-heist
// @domain  Techno-thriller / Ensemble Heist / Paranoid Conspiracy
// @version 1.0

import "trl/modules/index.trl"

// ===== WORK =====
work the_film [%Feature]

// ===== STORY-TIME (fabula) — the chronological spine =====
// The film opens in 1969 then cuts to 1992 San Francisco; no displacement of characters,
// but the chron spine encodes the wound that the present action reopens.

set prologue_1969        [+Exterior] [+Liminal]      // Princeton campus, 1969; the origin of everything
set san_francisco_1992   [+Urban] [+OrdinaryWorld]   // the team's present-day home

chron prologue_1969 ~> san_francisco_1992

// ===== CAST =====
char bishop              [+Protagonist] [+Leader] [+Guarded] [+FalseIdentity] [+Dynamic]
                         // born Martin Brice; fled under a false name; 23 years of distance from his real self
char cosmo               [+Antagonist] [+Mirror] [+Idealist] [+Corrupted] [+Dynamic]
                         // Bishop's oldest friend; thought dead; the wound walking back into Bishop's life
char crease              [+Ally] [+ExCIA] [+Skeptic]
                         // Donald Crease; ex-CIA; the voice of institutional distrust on the team
char mother              [+Ally] [+Expert] [+Paranoid]
                         // Darren "Mother" Roskow; tech specialist; conspiracy theorist; the van
char whistler            [+Ally] [+Expert] [+Blind]
                         // Erwin "Whistler" Emery; acoustic genius; his disability is the team's decisive edge
char carl                [+Ally] [+Idealist] [+Young]
                         // Carl Arbogast; phone phreak; still carries what Bishop and Cosmo once believed
char liz                 [+Recruited] [+Competent]
                         // Bishop's ex; brought in for one job; earns permanent membership
char brandt              [+Antagonist] [+Deceiver] [+Uniformed]
                         // Werner Brandt; fake NSA agent working for Cosmo; the lie that starts the story
char janek_nsa           [+Authority] [+LeverageHolder]
                         // NSA Agent Janek; the real NSA; holds Bishop's freedom as a chip
char abbott              [+Authority] [+LeverageHolder]
                         // NSA Agent Abbott; paired with Janek; institutional power with institutional patience
char dr_janek            [+Innocent] [+Expert]
                         // Dr. Gunter Janek; the mathematician who built the box; doesn't know what he built

char the_team            [+Collective] [+Ensemble]
                         // the full crew as a unit; their trust is the operating substrate

// ===== OBJECTS =====
obj the_black_box        [+MacGuffin] [+Unknown]
                         // the NSA cryptography device; can break any encryption; meaning evolves across every act
obj the_brice_file       [+MacGuffin] [+Coercive]
                         // the FBI/NSA file on Martin Brice; the lever that traps Bishop
obj bishop_false_id      [+Constructed] [+Protective]
                         // the "Martin Bishop" identity; 23 years of careful distance; threatened by the file
obj the_ransom_terms     [+Contractual]
                         // deliver the box; Brice record erased; Bishop is free; the deal Bishop cannot refuse
obj the_setec_file       [+Encrypted]
                         // the Setec Astronomy project files; the trail that leads to the box

// ===== SETS =====
set the_team_van         [+Interior] [+Mobile] [+Isolated]   // Mother's operation center; the team's tactical brain
set janek_lab            [+Interior] [+Secure] [+HighStakes]  // Dr. Janek's campus lab; the heist site
set cosmo_facility       [+Interior] [+Hostile]               // Cosmo's hidden headquarters; the revelation site
set the_exchange_site    [+Exterior] [+Liminal] [+HighStakes] // the handoff location; where everything resolves

// ===== CONCEPTS =====
concept information_power   [+Abstract] [+Thesis]
                            // whoever controls secrets controls everything; the film's governing idea
concept too_many_secrets    [+Abstract] [+Encrypted]
                            // decoded from "Setec Astronomy"; the film's thesis word-for-word; accretes meaning
concept false_identity      [+Abstract]
                            // what protects Bishop and what traps him; the wound the film reopens
concept the_cause           [+Abstract]
                            // what young Brice and Cosmo believed; equality, transparency, speaking truth to power
concept trust               [+Abstract]
                            // the team's operating substrate; what the heist and the relationship both run on

// ===== SEEDS — latent threads that surface later =====
?bishop [~Confronts(target=false_identity)]?       // the wound that can't stay closed; surface 4-5 times
?the_cause [~Perverted(by=cosmo)]?                 // surfaces in Cosmo's pitch; the idealism curdled into power
?cosmo [~Betrays(target=bishop)]?                  // resolves when Cosmo takes the box
*(cosmo [+Dead] | cosmo [+Alive])* as cosmo_status // planted in Act 1; resolved at the reveal
*(the_black_box [+Tool] | the_black_box [+Weapon])* as box_nature  // resolved in the demonstration scene
?whistler [~Decides(target=the_black_box)]?        // his wisdom closes the film's central question
?carl [~Chooses(target=the_cause)]?                // the youngest member's idealism tested and affirmed
?liz [~Joins(target=the_team)]?                    // recruited for one job; permanence is what she earns

// ===== LOG =====

arc sneakers_san_francisco [+Heist] [+Conspiracy] [+Paranoia] {

  // ── PROLOGUE · 1969 ──────────────────────────────────────────────────────

  act the_prologue @@ prologue_1969 {

    scene young_hackers_princeton @@ prologue_1969 {

      beat the_cause_is_born {
        // Setup: two young men in a dorm room who believe information wants to be free —
        // the cause in its pure, pre-corrupted form; the friendship that makes everything else hurt
        char young_bishop    [+Young] [+Idealist]       // Martin Brice before the flight
        char young_cosmo     [+Young] [+Idealist]       // the friend who will be thought dead
        set princeton_dorm   [+Interior] [+Conspicuous]

        evt hacking_begins [&Performs(agent=young_bishop, location=princeton_dorm)]
            dialog(inject=[speaker=young_bishop, target=young_cosmo],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "two students in the blue-lit dark of a terminal; the tone is the urgency of true believers"
                   tone: electric
                   text: "The Republican National Committee account. Think of it — all that money, just sitting there. We could move it. To Amnesty International. Greenpeace. Anybody who's actually doing something."
                   motivation: "{speaker} is not a criminal yet — he is a true believer; the action is transgressive but the ethics are coherent; the audience needs to understand this so the Cosmo betrayal lands"
                   """)
        young_bishop -- young_cosmo : "Believers in the same cause"
        young_bishop -- the_cause : "Committed to"
        young_cosmo  -- the_cause : "Committed to"
        the_cause [+Pure] [+Shared]
        too_many_secrets [+Encrypted]   // the thesis in embryo — secrets belong to no one; power corrupts them

        evt the_cause_seeded [&Introduces(object=the_cause)]
        // The cause is planted in its pure form; the film will track what happens to it
      }

      beat the_fbi_arrives {
        // Turn: the FBI comes; Cosmo stays; Bishop runs; the identity split
        // This is the originating wound: the moment Martin Brice became "Martin Bishop"
        obj the_fbi_agents [+Authority] [+Institutional]   // unnamed; the institution, not a named individual
        evt fbi_raid [&Strikes(agent=the_fbi_agents, target=princeton_dorm)]
            dialog(inject=[speaker=young_cosmo, target=young_bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "low, urgent — one door already rattling; the last words the best friends will say for twenty-three years"
                   tone: sharp
                   text: "Go. I'll handle it. Go — now."
                   motivation: "{speaker} chooses to stay; it is an act of love and it destroys them both — Cosmo goes to prison and Bishop goes to a life that isn't his"
                   """)
        // Consequence: the split that defines everything
        evt bishop_flees [&Flees(agent=young_bishop, location=princeton_dorm)]
        bishop_false_id [+Created]      // the "Martin Bishop" identity is born in this instant of flight
        young_bishop [+Fugitive]
        young_cosmo  [+Arrested]

        evt cosmo_caught [&Captures(agent=brandt, target=young_cosmo)]
        // cosmo_status: cosmo is last seen being arrested; the file will say he died in prison
        *cosmo [+Alive]*                // we the audience know what the file doesn't — yet
        ?bishop [~Confronts(target=false_identity)]?   // first surface: the identity is born from flight; the wound opens here
        bishop -- cosmo : "Oldest friend, last seen 1969"   // the relationship that will reopen everything
        bishop -- false_identity : "Built to survive"
      }

    }

  }

  // ── ACT 1 · SAN FRANCISCO 1992 ───────────────────────────────────────────

  act the_setup @@ san_francisco_1992 {

    scene the_bank_opener @@ san_francisco_1992 {
      // The team in operation: each member's skill introduced through action, not exposition
      // One bank, one con, five members — the audience meets the crew mid-competence

      beat the_team_assembles {
        // Setup: the heist in its ordinary-world mode — a client hired them to test security
        // Each member arrives at their station; the logistics of the team as organism
        set the_target_bank  [+Interior] [+Secure]

        bishop  @ san_francisco_1992
        crease  @ san_francisco_1992
        mother  @ the_team_van
        whistler @ san_francisco_1992
        carl    @ san_francisco_1992

        evt bishop_briefs [&Leads(agent=bishop, group=the_team)]
            dialog(inject=[speaker=bishop, target=the_team],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the cool precision of a man who has done this many times — not a drill, this is how he lives"
                   tone: quiet authority
                   text: "Crease, lobby. Carl, phones. Mother, you're eyes. Whistler — tell me what the building sounds like."
                   motivation: "the team's operating grammar introduced in four instructions; Bishop leads by knowing exactly what each person can do; trust is in the delegation"
                   """)
        the_team [+Coordinated] [+Professional]
        bishop [+FalseIdentity]   // he leads as Bishop; Brice is nowhere visible; this is his ordinary world
      }

      beat each_skill_fires {
        // Turn: the heist unfolds; each member demonstrates their specific competence
        // Whistler listening to the vault; Mother seeing everything; Carl phreak-routing the alarm;
        // Crease holding the floor; Bishop making the approach — the ensemble as precision instrument

        evt crease_holds_floor [&Performs(agent=crease, location=the_target_bank)]
            dialog(inject=[speaker=crease, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the bone-dry skepticism of someone who has done exactly this in an actual hostile country"
                   tone: flat
                   text: "Three guards. Two cameras. One exit not on the blueprint. We're fine — unless we're not."
                   motivation: "{speaker}'s pragmatic skepticism is what keeps Bishop's team alive; the ex-CIA man cannot stop reading threat angles"
                   """)
        crease [+Competent]

        evt mother_eyes [&Observes(agent=mother, location=the_team_van)]
            dialog(inject=[speaker=mother, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "voice through the earpiece; the van is his kingdom; conspiracies are just patterns he hasn't confirmed yet"
                   tone: alert
                   text: "Bishop — you know who owns this bank's security contractor? Same company that does the NSA's Maryland facility. Just noting it."
                   motivation: "{speaker} connects everything to everything because that's what paranoia does — and sometimes he's right; the NSA thread is planted one beat before it needs to be"
                   """)
        mother [+Paranoid]   // seeds his own vindication; every paranoid observation is data about the world

        evt carl_routes_alarm [&Performs(agent=carl, location=san_francisco_1992)]
            dialog(inject=[speaker=carl, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the enthusiasm of someone who still finds the work interesting for its own sake"
                   tone: delighted
                   text: "Alarm's rerouted. They won't know for four minutes. Bishop, that's a personal best."
                   motivation: "{speaker}'s joy is the job; he is Carl Arbogast, still idealist, still delighted — the youngest member carries the cause in its least tarnished form"
                   """)
        carl [+Idealist]

        evt whistler_listens [&Hears(agent=whistler, location=san_francisco_1992)]
            dialog(inject=[speaker=whistler, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the calm of someone for whom sound is a complete world; the blindness is not a deficit, it is a different frequency"
                   tone: quiet precision
                   text: "The vault combination is three-two-seven. They changed it this morning — the tumblers have less wear on those numbers. Also, the second guard had a cheeseburger for lunch. That's not relevant but I thought you should know."
                   motivation: "{speaker}'s acoustic mastery introduced through absurd over-delivery; the cheeseburger is the tell that his hearing is not just functional but extraordinary; his disability is already an advantage"
                   """)
        whistler [+Expert]
        whistler [+Indispensable]   // the team cannot operate without what he does; his blindness is their edge
      }

      beat heist_complete {
        // Consequence: the bank job ends; the client is satisfied; the team is paid
        // The ordinary-world rhythm of the team is established before it gets disrupted
        evt bishop_delivers [&Delivers(agent=bishop, target=the_target_bank)]
            dialog(inject=[speaker=bishop, target=crease],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the measured satisfaction of a professional at the end of a routine job"
                   tone: even
                   text: "Three entry points. Alarm response time: six minutes. Vault: twenty seconds. Tell them to change the combination."
                   motivation: "{speaker} is reliable, precise, and honest — this is who Martin Bishop is now; the false identity has become a real person, and the real person is good at his work"
                   """)
        bishop [+Competent] [+Trustworthy]
        the_team [+Successful]
        bishop_false_id [+Stable] [+Ordinary]
        // The false identity at rest: Bishop has made a life and it works; the next scene is where it cracks
      }

    }

    scene the_nsa_approach @@ san_francisco_1992 {
      // The false NSA agents come to Bishop's office; Brandt presents the leverage; the trap closes

      beat brandt_presents {
        // Setup: two men in suits who claim government authority; the offer that isn't one
        set bishop_office   [+Interior] [+Neutral]

        brandt @ bishop_office
        bishop @ bishop_office

        evt brandt_arrives [&Meets(agent=brandt, other=bishop)]
            dialog(inject=[speaker=brandt, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the smoothness of an operative who has delivered this brief many times; the offer is wrapped in institutional weight"
                   tone: bureaucratic warmth
                   text: "Mr. Bishop. We work for the National Security Agency. We have a small job for your team. We're prepared to pay very well."
                   motivation: "{speaker} is completely convincing — he is lying about everything except the payment; the audience and Bishop can't tell yet"
                   """)
        brandt [+Deceiver]
        bishop [+Guarded]   // Bishop's internal alarm fires immediately; he is always wary of institutions
        ?bishop [~Confronts(target=false_identity)]?   // second surface: institutions mean danger to Martin Brice
      }

      beat the_brice_file_revealed {
        // Turn: Brandt opens the file; the false identity is threatened directly
        // The wound from 1969 is in a folder on the table; 23 years of safety collapses in one paragraph
        evt brice_file_opened [&Reveals(agent=brandt, target=bishop)]
            dialog(inject=[speaker=brandt, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the quiet devastation of a bureaucrat reading a verdict; the file is almost gentle"
                   tone: even
                   text: "Martin Brice. Princeton, 1969. Federal charges — wire fraud, computer fraud, conspiracy. The file has been classified for twenty-three years. It can stay classified. Or it can be opened."
                   motivation: "{speaker} is not threatening; he is informing; the threat is in the grammar — passive voice around a catastrophe; Bishop goes very still because stillness is the only available response"
                   """)
        the_brice_file [+Revealed] [+Coercive]
        bishop_false_id [+Threatened]   // 23 years of careful distance: threatened in one sentence
        bishop [#Trapped]    // the shift from [+Guarded] to [#Trapped]: now his mind, not his posture
        ?bishop [~Confronts(target=false_identity)]?   // third surface: the file IS the false identity's death warrant

        evt the_ransom_terms_delivered [&Delivers(agent=brandt, target=bishop)]
            dialog(inject=[speaker=brandt, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the deal presented as professional courtesy; the coercion is complete; Bishop has no room to move"
                   tone: collegial
                   text: "Retrieve a device from a mathematician named Dr. Gunter Janek. Deliver it to us. In return, the Brice file is erased. Martin Bishop keeps his life."
                   motivation: "{speaker} knows he has won before Bishop speaks; the deal is offered as a formality; the audience tracks that Bishop cannot refuse"
                   """)
        the_ransom_terms [+Delivered] [+Accepted]
        bishop -- the_ransom_terms : "Coerced by"
        bishop -- the_brice_file   : "Endangered by"
        the_black_box [+Unknown]   // "a device" — Bishop doesn't know what it is yet; first accreted tag
      }

      beat bishop_briefs_the_team {
        // Consequence: Bishop assembles the team; tells them everything except his personal stake
        // The trust he withholds here is the seed that the beating will eventually pay off
        evt bishop_recruits [&Leads(agent=bishop, group=the_team)]
            dialog(inject=[speaker=bishop, target=the_team],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the controlled precision of a man disclosing exactly what he must and no more"
                   tone: matter-of-fact
                   text: "NSA contract. One job — retrieve an encryption device from a university lab. Clean in, clean out. Good money. I want everyone in."
                   motivation: "{speaker} doesn't tell them about the Brice file; he tells himself it's to protect them; it is also to protect the secret he has kept from everyone for twenty-three years"
                   """)
        the_team [+Assembled] [+Briefed]
        bishop -- the_team : "Leads with withheld truth"
        // The withholding is not deception exactly — but it is the crack in trust
        // that will matter when everything goes wrong
      }

    }

    scene liz_recruited @@ san_francisco_1992 {
      // Bishop approaches Liz; she is a social engineer; he needs her for the recon approach

      beat bishop_and_liz {
        // The ex-girlfriend dynamic; the professional ask; the personal subtext already present
        set liz_apartment    [+Interior] [+Domestic]

        liz @ liz_apartment
        bishop @ liz_apartment

        evt bishop_asks_liz [&Meets(agent=bishop, other=liz)]
            dialog(inject=[speaker=bishop, target=liz],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the awkward fluency of someone who knows exactly how to ask for things except from this person"
                   tone: careful
                   text: "I need a social engineer. Specifically you. There's a mathematician — we need to know the layout of his lab. One meeting. Dinner, maybe. You'd be very good at it."
                   motivation: "{speaker} is asking his ex-girlfriend to have dinner with another man as professional cover; the subtext of everything he doesn't say about why specifically her is the scene's real content"
                   """)
        liz [+Recruited]
        bishop -- liz : "Former lovers / current professional ask"
        ?liz [~Joins(target=the_team)]?   // planted: recruited for one job; permanence is what she'll earn
      }

      beat liz_agrees {
        // Liz accepts; demonstrates she already knows more than Bishop expects
        evt liz_accepts [&Agrees(agent=liz, target=bishop)]
            dialog(inject=[speaker=liz, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the equanimity of a woman who has had twenty-three years to get comfortable with complicated"
                   tone: dry
                   text: "A mathematician. At a university. And you need me to be charming and ask questions and not let on that I'm asking them. [beat] Martin, you haven't changed at all."
                   motivation: "{speaker}'s dry humor lands on 'Martin' — not 'Bishop'; she uses his real name; the intimacy is the tell; he notices; the audience notices"
                   """)
        liz [+Competent]   // she already understands the job before he's finished explaining it
        liz -- bishop : "Knows his real name"
        bishop [#Exposed] // briefly; the name in Liz's mouth is the false identity's first private crack
        ?bishop [~Confronts(target=false_identity)]?   // fourth surface: Liz says "Martin"; the identity flickers
      }

    }

  }

  // ── ACT 2a · THE HEIST ───────────────────────────────────────────────────

  act the_heist_sequence @@ san_francisco_1992 {

    scene setec_astronomy_decoded @@ san_francisco_1992 {
      // Research phase: the team decodes "Setec Astronomy"; the anagram reveal;
      // the discovery that changes what the job is

      beat research_begins {
        // Setup: the team working the problem; the encrypted name is a wall
        set team_headquarters  [+Interior] [+Isolated]

        evt carl_decodes [&Performs(agent=carl, location=team_headquarters)]
            dialog(inject=[speaker=carl, target=the_team],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the phone phreak at full intensity; the idealism is still there in how much he cares about the puzzle"
                   tone: concentrated
                   text: "Setec Astronomy. It's an anagram — I can feel it. The syllables are wrong for a project name. NSA doesn't name things that sound like astronomy."
                   motivation: "{speaker}'s instinct for hidden structure in language is exactly the idealism of someone who believes information has intrinsic form; the anagram is the thesis in disguise"
                   """)
        the_setec_file [+Investigated]
        carl [+Idealist]   // his delight in the puzzle is the cause in miniature

        evt mother_crosslinks [&Observes(agent=mother, location=team_headquarters)]
            dialog(inject=[speaker=mother, target=the_team],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the acceleration of a paranoid who has just had his paranoia confirmed"
                   tone: rising
                   text: "Bishop — every reference to this project inside the NSA internal registry goes to a black account. No oversight. No congressional reporting. This isn't a surveillance tool. This is something they don't want the government to know about."
                   motivation: "{speaker}'s paranoia is the engine of the discovery; his willingness to assume the worst is exactly what the worst-case scenario requires"
                   """)
        mother [+Paranoid]   // the paranoia is productive; the conspiracy he smells is real
        information_power [+Investigated]   // the team is triangulating the thesis without knowing the thesis yet
      }

      beat the_anagram_lands {
        // Turn: Carl solves it; "Too Many Secrets" arrives in the room like a verdict
        evt anagram_solved [&Reveals(agent=carl, target=the_team)]
            dialog(inject=[speaker=carl, target=the_team],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the specific silence before something that matters; Carl says it quietly, which makes it louder"
                   tone: hushed
                   text: "Setec Astronomy. Rearrange the letters. [beat] Too many secrets."
                   motivation: "the anagram is the film's thesis delivered by the character who still believes in the cause; Carl doesn't know yet what it means; neither does the audience; both will find out the same way"
                   """)
        too_many_secrets [-Encrypted] [+Decoded]   // first meaning shift: from cipher to phrase
        the_setec_file [+Decoded]

        evt bishop_processes [&Reacts(agent=bishop, target=too_many_secrets)]
            dialog(inject=[speaker=bishop, target=crease],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the quiet of a man whose old self just moved in his chest"
                   tone: distant
                   text: "Too many secrets. [long pause] That's what we used to say."
                   motivation: "{speaker} is remembering 1969; the cause; Cosmo; the dorm; the ideology they shared; the anagram is a ghost speaking; the audience sees Bishop's face and knows this is personal now"
                   """)
        bishop [#Haunted]   // the prologue's ideology arrives in 1992
        bishop -- the_cause : "Once believed in"
        ?the_cause [~Perverted(by=cosmo)]?   // first surface: the phrase is pure here; the perversion comes later
        too_many_secrets [+Thesis]   // second meaning shift: from decoded phrase to conceptual weight
      }

      beat what_the_box_actually_is {
        // Consequence: research reveals the device is not a tool but a weapon
        // The box's nature starts to clarify; the team understands the stakes are larger than expected
        evt crease_connects [&Reveals(agent=crease, target=the_team)]
            dialog(inject=[speaker=crease, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the flat delivery of a man who has worked for the institution and knows how it thinks"
                   tone: grave
                   text: "If what Carl found is right — this device can break any encryption. Military. Financial. Government. Any system that runs on secure communication — phone calls, bank transfers, nuclear launch codes — it reads all of it. Whoever holds this box holds the world."
                   motivation: "{speaker}'s CIA background gives the threat its institutional specificity; he is not being dramatic; he is being technical; the technician's affect makes it more terrifying"
                   """)
        the_black_box [-Unknown] [+Confirmed]   // second accreted tag: the box's nature confirmed by research
        information_power [+Thesis]   // the film's governing idea crystallized into words for the first time
      }

    }

    scene liz_and_dr_janek @@ san_francisco_1992 {
      // Liz social-engineers Dr. Janek for the lab recon; the reconnaissance scene

      beat the_dinner_approach {
        // Setup: Liz in character; Dr. Janek delighted and oblivious
        set the_restaurant   [+Interior] [+Public] [+Neutral]

        liz      @ the_restaurant
        dr_janek @ the_restaurant

        evt liz_social_engineers [&Performs(agent=liz, location=the_restaurant)]
            dialog(inject=[speaker=liz, target=dr_janek],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the warmth of someone who is very good at her work and is also genuinely curious about mathematicians"
                   tone: engaged
                   text: "The thing I keep wondering about cryptography — if you built something that was truly unbreakable, what would you use it for? What would you protect?"
