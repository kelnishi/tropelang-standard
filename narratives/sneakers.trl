        bishop_false_id [+Threatened] [+Pending_Erasure]   // the identity is about to be resolved paradoxically
        ?bishop [~Confronts(target=false_identity)]?   // the final confrontation: he is negotiating the end of Brice
      }

    }

    scene the_exchange @@ san_francisco_1992 {
      // The handoff; the file erased; the team's payoffs; resolution

      beat the_handoff {
        // Setup: the exchange location; the box delivered; the Brice file erased
        bishop  @ the_exchange_site
        the_team @ the_exchange_site
        janek_nsa @ the_exchange_site

        evt box_delivered [&Delivers(agent=bishop, target=janek_nsa)]
            dialog(inject=[speaker=janek_nsa, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the institutional courtesy of someone completing a transaction; no warmth, no hostility, just conclusion"
                   tone: formal
                   text: "The Brice file. [hands over confirmation] As agreed. Mr. Brice no longer exists in any federal record. Mr. Bishop may continue his work."
                   motivation: "{speaker} erases a man by completing paperwork; the paradox is the theme — the false identity becomes the real identity because the real identity has been officially unmade; Bishop is freed by erasure"
                   """)
        the_black_box [+Delivered] [+Neutralized]   // ninth accreted tag: the box out of play
        the_brice_file [+Erased]   // the coercive instrument destroyed
        bishop_false_id [+Legitimized]   // the paradox: Brice erased, Bishop legitimate; the false identity freed by the erasure of the real one
        bishop [-#Trapped] [+Free]   // the mind state lifts; what replaces [#Trapped] is [+Free]
        ?bishop [~Confronts(target=false_identity)]?   // fully resolved: the false identity is real now because the real one is gone
      }

      beat team_payoffs {
        // The team's rewards negotiated; each character's wish maps to who they are
        // The final beat that reveals character through desire

        evt crease_paid [&Receives(agent=crease, target=janek_nsa)]
            dialog(inject=[speaker=crease, target=janek_nsa],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the ex-CIA man names the one thing institutional authority actually has the power to give back"
                   tone: flat
                   text: "I want my NSA file. The one you kept on me after I left the Agency. The whole file."
                   motivation: "{speaker} wants the secret they kept on him; the man who spent his career in secrets wants the secret about himself; the request is about dignity and surveillance simultaneously"
                   """)
        crease [+Vindicated]   // the skeptic gets the information; the skeptic was right about the surveillance

        evt mother_paid [&Receives(agent=mother, target=janek_nsa)]
            dialog(inject=[speaker=mother, target=janek_nsa],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the delivery of a man who has waited his whole life to say this and expected never to be taken seriously"
                   tone: absolutely certain
                   text: "I want to speak to the people at the Roswell facility. The real ones. Not a press release. I want an actual conversation."
                   motivation: "{speaker}'s request is the film's warmest joke — the paranoid gets his audience with the conspiracy; the man who was right about everything gets access to the one theory nobody can confirm; his [+Vindicated] tag is complete"
                   """)
        mother [+Vindicated]   // fully vindicated: the conspiracy theorist right about everything
        janek_nsa [#Discomfited]   // the one request that costs the NSA something personal

        evt carl_paid [&Receives(agent=carl, target=janek_nsa)]
            dialog(inject=[speaker=carl, target=janek_nsa],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the idealist names his price; it is not money and not information; it is the cause"
                   tone: earnest
                   text: "Peace in the Middle East. [beat] I know you can't do that. [beat] I just wanted you to know what I would have wanted."
                   motivation: "{speaker} asks for the impossible because he is the youngest and still believes in impossible things; the request is a declaration of values; it's also the funniest line in the scene because it is completely sincere"
                   """)
        carl [-#Conflicted] [+Hopeful]   // the conflict resolves into hope: the idealist keeps the idealism
        ?carl [~Chooses(target=the_cause)]?   // resolved: Carl keeps the cause; names it; it survives Cosmo

        evt liz_paid [&Receives(agent=liz, target=bishop)]
            dialog(inject=[speaker=liz, target=bishop],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the practical woman who knows exactly what she wants; the subtext of everything unsaid between them"
                   tone: dry
                   text: "I want a job. [beat] The real kind. On the team. Permanently. [beat to bishop] You were going to ask anyway."
                   motivation: "{speaker} names what has been clear since the dinner with Janek; she is already on the team; the request makes it official; 'you were going to ask anyway' is the intimacy returning on her terms"
                   """)
        liz [+Permanent]   // the seed resolves: recruited for one job, permanence earned
        ?liz [~Joins(target=the_team)]?   // fully resolved: she is on the team; she named herself there
        bishop -- liz : "Team member and more"   // the 'and more' is in the subtext; the edge says enough

        evt whistler_paid [&Receives(agent=whistler, target=janek_nsa)]
            dialog(inject=[speaker=whistler, target=janek_nsa],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the quiet of someone who has thought about this and knows exactly what he wants; the wisdom is in the specificity"
                   tone: calm
                   text: "There's a satellite — NRO designation KH-12, covering the Middle East. I want it repositioned forty meters south and fourteen east. And I want access to its acoustic sensors for the next seventy-two hours."
                   motivation: "{speaker}'s request is acoustic and precise and untranslatable to anyone who doesn't live in sound the way he does; the request IS who he is; the wisdom of the request is the wisdom of the character"
                   """)
        whistler [+Wise]   // the tag completes: Expert → Indispensable → Decisive → Wise
        ?whistler [~Decides(target=the_black_box)]?   // resolved obliquely: his wisdom was always about sound, not the box; the acoustic request is the resolution
      }

      beat bishop_closes {
        // The final beat: Bishop alone; the false identity now real; the wound closed
        evt bishop_reflects [&Performs(agent=bishop, location=the_exchange_site)]
            dialog(inject=[speaker=bishop, target=liz],
                   inline="""
                   kind: dialog
                   speaker: "{speaker}"
                   addressee: "{target}"
                   cue: "the quiet of a man who has been running for twenty-three years and just stopped; the exhaustion and the relief are the same thing"
                   tone: quiet
                   text: "Martin Brice is gone. [beat] I don't know what that makes me. [pause] Maybe just — Bishop."
                   motivation: "{speaker} names the paradox the film has been building toward: the false identity is freed by the erasure of the real one; 'just Bishop' is not a loss but an arrival; the wound that the film opened in 1969 is closed here"
                   """)
        bishop [+Whole] [+Free]   // the final state: beyond [+FalseIdentity]; the self that was always underneath
        bishop_false_id [+Legitimized] [+Real]   // the false identity resolved into a real one
        too_many_secrets [+Acknowledged]   // fourth and final meaning shift: from concept to lived truth, acknowledged by the film
        information_power [+Acknowledged]   // the thesis acknowledged: secrets shape the world; knowing this is the cost and the gift
        the_cause [+Preserved]   // the cause survives Cosmo's perversion; Carl kept it; Bishop named it
        ?the_cause [~Perverted(by=cosmo)]?   // fully resolved: the perversion named and the cause preserved despite it
        bishop -- the_team : "Leads / belongs to"   // the closed loop: Bishop is not alone; the team is the ordinary world now
      }

    }

  }

}
